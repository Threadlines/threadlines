{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["@effect/platform-node", "effect"],
        // Suggestions show in the editor; tsc output (and CI) only carries
        // warnings and errors.
        "includeSuggestionsInTsc": false,
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "instanceOfSchema": "error",
          "strictEffectProvide": "off",
          "missingEffectServiceDependency": "error",
          "leakingRequirements": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "unknownInEffectCatch": "error",
          "strictBooleanExpressions": "off",
          "lazyEffect": "off",
          "schemaSyncInEffect": "error",
          // Effect 4 marks rpc, http, sql, cli and socket "unstable". We build
          // on them on purpose and pin effect to an exact version, so their
          // breaking changes are handled at each upgrade, not per call site.
          "unstableApiUsage": "suggestion",
          // House-style rules the code does not follow yet (hundreds of
          // findings each): editor hints only. Raise one to "error" only
          // together with its cleanup.
          "deterministicKeys": "suggestion",
          "preferSchemaOverJson": "suggestion",
          "cryptoRandomUUID": "suggestion",
          "cryptoRandomUUIDInEffect": "suggestion",
          "nodeBuiltinImport": "suggestion",
          "globalDate": "suggestion",
          "globalDateInEffect": "suggestion",
          "globalConsole": "suggestion",
          "globalConsoleInEffect": "suggestion",
          "globalRandom": "suggestion",
          "globalRandomInEffect": "suggestion",
          "globalTimers": "suggestion",
          "globalTimersInEffect": "suggestion"
        }
      }
    ]
  }
}
