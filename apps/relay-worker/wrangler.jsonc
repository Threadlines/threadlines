{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "threadlines-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      // Off: invocation logs record whole URLs, and an event task's address
      // carries its mac (src/log.ts loggedPath cuts it from our own logs).
      "invocation_logs": false,
      "head_sampling_rate": 1,
    },
  },
  "vars": {
    "THREADLINES_APP_ORIGIN": "https://app.threadlines.dev",
    "THREADLINES_ALLOWED_ORIGINS": "https://app.threadlines.dev,https://nightly.app.threadlines.dev,http://localhost:5733,http://127.0.0.1:5733",
    "THREADLINES_RELAY_PUBLIC_ORIGIN": "",
    "THREADLINES_RELAY_SESSION_CREATION_ENABLED": "true",
    "THREADLINES_RELAY_SESSION_TTL_SECONDS": "43200",
    // Connect a device (v2). Per-computer daily allowance, relay-wide budget
    // (kept under the Workers Free pool), and per-IP registration cap.
    "THREADLINES_RELAY_V2_ENABLED": "true",
    "THREADLINES_RELAY_HOST_DAILY_MESSAGES": "200000",
    "THREADLINES_RELAY_HOST_DAILY_AWAKE_SECONDS": "86400",
    "THREADLINES_RELAY_DAILY_MESSAGE_BUDGET": "1200000",
    "THREADLINES_RELAY_REGISTRATIONS_PER_IP_PER_DAY": "20",
    // Event tasks: deliveries each computer accepts per UTC day. The address
    // mac key is a secret: `wrangler secret put HOOK_PATH_KEY`.
    "THREADLINES_RELAY_HOST_DAILY_HOOKS": "1000",
    // Assistants (docs/design/assistants.md): the door's public origin, its
    // kill switch, and the requests each computer forwards per UTC day. Its
    // two keys are secrets: `wrangler secret put ASSISTANT_ROUTE_KEY` and
    // `ASSISTANT_CLIENT_KEY`. The origin is the worker's own for now:
    // threadlines.dev's DNS is on Vercel, so a threadlines.dev name can't
    // route here. Every credential is bound to it, so changing it disconnects
    // every assistant: move it (if at all) before Threadlines is listed.
    "ASSISTANTS_ORIGIN": "https://threadlines-relay.threadlines.workers.dev",
    "ASSISTANTS_ENABLED": "true",
    "THREADLINES_RELAY_HOST_DAILY_ASSISTANT_REQUESTS": "20000",
  },
  "ratelimits": [
    {
      "name": "SESSION_CREATE_RATE_LIMITER",
      "namespace_id": "2026071201",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    {
      "name": "RELAY_MESSAGE_RATE_LIMITER",
      "namespace_id": "2026071202",
      "simple": {
        "limit": 3000,
        "period": 60,
      },
    },
    {
      "name": "JOIN_RATE_LIMITER",
      "namespace_id": "2026100301",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "CONTROL_RATE_LIMITER",
      "namespace_id": "2026100302",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    // Event task deliveries, checked at the edge before any Durable Object:
    // per client IP, then per hook (hostId|hookId).
    {
      "name": "HOOK_IP_RATE_LIMITER",
      "namespace_id": "2026102301",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "HOOK_RATE_LIMITER",
      "namespace_id": "2026102302",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    // A host's hook.ack frames (it sends at most one a second), kept apart
    // from the 10-a-minute control limiter.
    {
      "name": "HOOK_ACK_RATE_LIMITER",
      "namespace_id": "2026102303",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    // Assistants, all checked at the edge and failing closed. Per client IP:
    // registrations, sign-in pages and typed codes (separate keys, 10 a minute
    // each), and sign-in pages waiting for the computer's decision.
    {
      "name": "ASSISTANT_SIGN_IN_RATE_LIMITER",
      "namespace_id": "2026103001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "ASSISTANT_STATUS_RATE_LIMITER",
      "namespace_id": "2026103002",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    // Per connection (`mcp:` and `token:` keys), matching the computer's own rate.
    {
      "name": "ASSISTANT_CONNECTION_RATE_LIMITER",
      "namespace_id": "2026103003",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_SESSION",
        "class_name": "RelaySession",
      },
      {
        "name": "RELAY_HOST",
        "class_name": "RelayHost",
      },
      {
        "name": "RELAY_CODE_SHARD",
        "class_name": "RelayCodeShard",
      },
      {
        "name": "RELAY_LEDGER",
        "class_name": "RelayLedger",
      },
      {
        "name": "RELAY_ASSISTANT_SIGN_IN",
        "class_name": "RelayAssistantSignIn",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelaySession"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RelayHost", "RelayCodeShard", "RelayLedger"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["RelayAssistantSignIn"],
    },
  ],
}
