{"format": "threadlines-theme@1", "name": "Honu Lagoon", "base": "light", "colors": {"background": "#e8f7f5", "foreground": "#06303f", "mutedForeground": "#46636b", "accent": "#0a7f9a", "accentForeground": "#ffffff", "border": "#b7dedb", "success": "#13805f", "warning": "#9a6a00", "danger": "#d42448", "info": "#0e72a8", "codeBackground": "#dcf1ef", "selection": "#b9e8e4"}, "code": {"foreground": "#06303f", "comment": "#5a8089", "keyword": "#066e85", "string": "#9a5a00", "number": "#c42d50", "function": "#0e63a0", "type": "#6a4fc0", "variable": "#06303f", "operator": "#2f6f7c", "punctuation": "#46636b"}, "terminal": ["#06303f", "#d42448", "#13805f", "#9a6a00", "#0e63a0", "#9a3fb0", "#0a7f9a", "#c4dcdc", "#46636b", "#ef3b5a", "#12896a", "#9c7000", "#2a8fd6", "#c06ad6", "#0d8790", "#f4fbfa"], "fonts": {"ui": {"family": "Manrope", "source": "google", "weight": 600, "data": "", "weights": {"min": 400, "max": 700}}, "mono": {"family": "Geist Mono", "source": "google", "weight": 500, "data": "", "weights": {"min": 400, "max": 700}}}, "glass": {"frame": 0.5, "list": 0.62, "column": 0.8, "composer": 0.72, "blur": 16}, "backdrop": {"mode": "grid", "script": "// Honu Lagoon, a Threadlines backdrop.\n// A top-down Hawaiian lagoon in ASCII cells: green sea turtles, a manta, dolphins,\n// a school of yellow tangs, a humpback, hibiscus and plumeria.\n// Based on the Honu Lagoon prompt by @handsher_NGU (https://x.com/handsher_NGU),\n// prompt at https://honu-lagoon.vercel.app/\n// Ported from a 2D canvas to the Threadlines character grid: the same creatures,\n// paths and palette, played at half speed. Everything is a function of t and every\n// motion has a whole number of cycles per T, so the loop is seamless.\n\nconst T = 24.5, TAU = Math.PI * 2, w = TAU / T;\nconst CW = 8, CH = 11, SS = 2;              // requested cell size (half the original's 16 x 22) and subsamples per side\nconst FONT = 7.5, GAP = 1;\nconst RATE = 0.5;                          // playback speed, calmer than the original video\nconst GLYPHS = \"8%XSt;:',.o~-\u00b7*+\u00b0\";\nconst GI = {}; for (let k = 0; k < GLYPHS.length; k++) GI[GLYPHS[k]] = k;\n\nconst hash = (a, b, c) => { const h = Math.sin(a * 127.1 + b * 311.7 + c * 74.7) * 43758.5453; return h - Math.floor(h); };\nconst ihash = (a, b, c) => {\n  let h = (Math.imul(a | 0, 374761393) + Math.imul(b | 0, 668265263) + Math.imul(c | 0, 1442695041)) | 0;\n  h = Math.imul(h ^ (h >>> 13), 1274126177); h ^= h >>> 16; return (h >>> 0) / 4294967296;\n};\nconst mix = (a, b, k) => [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k];\nconst lum = (r, g, b) => (0.299 * r + 0.587 * g + 0.114 * b) / 255;\n\n// Lagoon: sunlit shallows top-left, deeper blue bottom-right.\nconst STOPS = [[0, [178, 244, 232]], [0.42, [74, 214, 214]], [0.78, [26, 168, 202]], [1, [14, 128, 182]]];\nconst stopAt = (k) => {\n  for (let i = 1; i < STOPS.length; i++) if (k <= STOPS[i][0]) return mix(STOPS[i - 1][1], STOPS[i][1], (k - STOPS[i - 1][0]) / (STOPS[i][0] - STOPS[i - 1][0]));\n  return STOPS[3][1];\n};\nconst BG8 = []; for (let q = 0; q < 8; q++) BG8.push(stopAt(q / 7));\nconst hex2 = (v) => (\"0\" + Math.round(v).toString(16)).slice(-2);\nconst BG_HEX = BG8.map((c) => \"#\" + hex2(c[0]) + hex2(c[1]) + hex2(c[2]));\nconst ANGLE = 150, SA = Math.sin(ANGLE * Math.PI / 180), CA = -Math.cos(ANGLE * Math.PI / 180);\nconst waterAt = (k) => { k = k < 0 ? 0 : k > 1 ? 1 : k; const f = k * 7, i = Math.min(6, Math.floor(f)); return mix(BG8[i], BG8[i + 1], f - i); };\n\n// fast sine for the per-cell caustic net\nconst SN = 8192, SK = SN / TAU, STAB = new Float32Array(SN);\nfor (let i = 0; i < SN; i++) STAB[i] = Math.sin(i / SK);\nconst fsin = (x) => STAB[((x * SK) | 0) & (SN - 1)];\n\n// ---------- a tiny canvas-like rasterizer into a supersampled layer ----------\nlet COLS = 0, ROWS = 0, NC = 0, WPX = 0, HPX = 0, SX = 1, SY = 1, K = 1, SW = 0, SHT = 0;\nlet cw = CW, ch = CH, sw = CW / SS, sh = CH / SS;   // the cell size Threadlines actually gives us\nlet XU = 16, YU = 22, SHX = 2, SHY = 2;             // original px per cell, shadow offset in cells\nlet LAYER, RMIN, RMAX, REEF, DEEP, MAIN, WR, WG, WB, BASE, BGW, FGW, CFG, CGL, GL, COLX;\nconst XS = new Float64Array(256);\n\nconst CCACHE = {};\nfunction col(c) {\n  if (typeof c !== \"string\") return c;\n  let v = CCACHE[c]; if (v) return v;\n  if (c[0] === \"#\") v = [parseInt(c.substr(1, 2), 16), parseInt(c.substr(3, 2), 16), parseInt(c.substr(5, 2), 16), 1];\n  else { const p = c.slice(c.indexOf(\"(\") + 1, c.indexOf(\")\")).split(\",\").map(Number); v = [p[0], p[1], p[2], p.length > 3 ? p[3] : 1]; }\n  return (CCACHE[c] = v);\n}\nfunction gradLut(gr) {\n  const s = gr.stops, lut = [];\n  for (let q = 0; q <= 64; q++) {\n    const t = q / 64; let c = s[s.length - 1][1];\n    if (t <= s[0][0]) c = s[0][1];\n    else for (let i = 1; i < s.length; i++) if (t <= s[i][0]) {\n      const a = s[i - 1][1], b = s[i][1], k = (t - s[i - 1][0]) / (s[i][0] - s[i - 1][0]);\n      c = [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k, a[3] + (b[3] - a[3]) * k]; break;\n    }\n    lut.push(c);\n  }\n  return (gr.lut = lut);\n}\nfunction plot(buf, o, c) {\n  const a = c[3]; if (a <= 0) return;\n  if (a >= 1) { buf[o] = c[0]; buf[o + 1] = c[1]; buf[o + 2] = c[2]; buf[o + 3] = 1; return; }\n  const ia = 1 - a;\n  buf[o] = c[0] * a + buf[o] * ia; buf[o + 1] = c[1] * a + buf[o + 1] * ia; buf[o + 2] = c[2] * a + buf[o + 2] * ia; buf[o + 3] = a + buf[o + 3] * ia;\n}\nfunction fillEll(buf, e, style) {\n  const m = e.m, cr = Math.cos(e.r), sr = Math.sin(e.r);\n  const F11 = (m[0] * cr + m[2] * sr) * e.rx, F12 = (-m[0] * sr + m[2] * cr) * e.ry;\n  const F21 = (m[1] * cr + m[3] * sr) * e.rx, F22 = (-m[1] * sr + m[3] * cr) * e.ry;\n  const ox = m[0] * e.x + m[2] * e.y + m[4], oy = m[1] * e.x + m[3] * e.y + m[5];\n  const det = F11 * F22 - F12 * F21; if (Math.abs(det) < 1e-9) return;\n  const I11 = F22 / det, I12 = -F12 / det, I21 = -F21 / det, I22 = F11 / det;\n  const hw = Math.sqrt(F11 * F11 + F12 * F12), hh = Math.sqrt(F21 * F21 + F22 * F22);\n  const i0 = Math.max(0, Math.ceil((ox - hw) / sw - 0.5)), i1 = Math.min(SW - 1, Math.floor((ox + hw) / sw - 0.5));\n  const j0 = Math.max(0, Math.ceil((oy - hh) / sh - 0.5)), j1 = Math.min(SHT - 1, Math.floor((oy + hh) / sh - 0.5));\n  if (i0 > i1 || j0 > j1) return;\n  const grad = style.grad ? style : null, solid = grad ? null : col(style);\n  const lut = grad ? gradLut(grad) : null, gk = grad ? 64 / (grad.r1 - grad.r0) : 0, gr0 = grad ? grad.r0 : 0;\n  for (let j = j0; j <= j1; j++) {\n    const dy = (j + 0.5) * sh - oy;\n    let lo = SW, hi = -1;\n    for (let i = i0; i <= i1; i++) {\n      const dx = (i + 0.5) * sw - ox;\n      const u = I11 * dx + I12 * dy, v = I21 * dx + I22 * dy;\n      if (u * u + v * v > 1) continue;\n      if (i < lo) lo = i; hi = i;\n      let c = solid;\n      if (grad) {\n        const lx = e.x + e.rx * cr * u - e.ry * sr * v - grad.x, ly = e.y + e.rx * sr * u + e.ry * cr * v - grad.y;\n        let q = ((Math.sqrt(lx * lx + ly * ly) - gr0) * gk + 0.5) | 0; q = q < 0 ? 0 : q > 64 ? 64 : q;\n        c = lut[q];\n      }\n      plot(buf, (j * SW + i) * 4, c);\n    }\n    if (hi >= 0) { if (lo < RMIN[j]) RMIN[j] = lo; if (hi > RMAX[j]) RMAX[j] = hi; }\n  }\n}\nfunction fillPoly(buf, p, c) {\n  const n = p.length >> 1; if (n < 3) return;\n  let ymin = 1e9, ymax = -1e9;\n  for (let k = 1; k < p.length; k += 2) { if (p[k] < ymin) ymin = p[k]; if (p[k] > ymax) ymax = p[k]; }\n  const j0 = Math.max(0, Math.ceil(ymin / sh - 0.5)), j1 = Math.min(SHT - 1, Math.floor(ymax / sh - 0.5));\n  for (let j = j0; j <= j1; j++) {\n    const Y = (j + 0.5) * sh; let nx = 0;\n    for (let k = 0; k < n; k++) {\n      const x0 = p[2 * k], y0 = p[2 * k + 1], k1 = k + 1 === n ? 0 : k + 1, x1 = p[2 * k1], y1 = p[2 * k1 + 1];\n      if ((y0 <= Y && y1 > Y) || (y1 <= Y && y0 > Y)) {\n        const x = x0 + (Y - y0) * (x1 - x0) / (y1 - y0);\n        let q = nx++; while (q > 0 && XS[q - 1] > x) { XS[q] = XS[q - 1]; q--; } XS[q] = x;\n      }\n    }\n    for (let q = 0; q + 1 < nx; q += 2) {\n      const ia = Math.max(0, Math.ceil(XS[q] / sw - 0.5)), ib = Math.min(SW - 1, Math.floor(XS[q + 1] / sw - 0.5));\n      if (ia > ib) continue;\n      for (let i = ia; i <= ib; i++) plot(buf, (j * SW + i) * 4, c);\n      if (ia < RMIN[j]) RMIN[j] = ia; if (ib > RMAX[j]) RMAX[j] = ib;\n    }\n  }\n}\n\nclass Ctx {\n  constructor() { this.m = [1, 0, 0, 1, 0, 0]; this.st = []; this.sub = []; this.cp = null; this.fillStyle = \"#000\"; this.strokeStyle = \"#000\"; this.lineWidth = 1; this.buf = null; }\n  reset(buf) { this.m = [1, 0, 0, 1, 0, 0]; this.st.length = 0; this.buf = buf; }\n  save() { this.st.push([this.m.slice(), this.fillStyle, this.strokeStyle, this.lineWidth]); }\n  restore() { const s = this.st.pop(); if (s) { this.m = s[0]; this.fillStyle = s[1]; this.strokeStyle = s[2]; this.lineWidth = s[3]; } }\n  translate(x, y) { const m = this.m; m[4] += m[0] * x + m[2] * y; m[5] += m[1] * x + m[3] * y; }\n  rotate(r) {\n    const m = this.m, c = Math.cos(r), s = Math.sin(r), a = m[0], b = m[1], cc = m[2], d = m[3];\n    m[0] = a * c + cc * s; m[1] = b * c + d * s; m[2] = -a * s + cc * c; m[3] = -b * s + d * c;\n  }\n  scale(x, y) { const m = this.m; m[0] *= x; m[1] *= x; m[2] *= y; m[3] *= y; }\n  beginPath() { this.sub = []; this.cp = null; }\n  pt(x, y) { const m = this.m; this.cp.push(m[0] * x + m[2] * y + m[4], m[1] * x + m[3] * y + m[5]); this.lx = x; this.ly = y; }\n  moveTo(x, y) { this.cp = []; this.sub.push({ k: 0, p: this.cp }); this.pt(x, y); }\n  lineTo(x, y) { if (!this.cp) this.moveTo(x, y); else this.pt(x, y); }\n  quadraticCurveTo(cx, cy, x, y) {\n    if (!this.cp) this.moveTo(cx, cy);\n    const x0 = this.lx, y0 = this.ly;\n    for (let k = 1; k <= 6; k++) { const t = k / 6, u = 1 - t; this.pt(u * u * x0 + 2 * u * t * cx + t * t * x, u * u * y0 + 2 * u * t * cy + t * t * y); }\n  }\n  closePath() {}\n  ellipse(x, y, rx, ry, r) { this.sub.push({ k: 1, m: this.m.slice(), x, y, rx, ry, r: r || 0 }); this.cp = null; }\n  arc(x, y, r) { this.ellipse(x, y, r, r, 0); }\n  createRadialGradient(x0, y0, r0, x1, y1, r1) { return { grad: 1, x: x1, y: y1, r0, r1, stops: [], addColorStop(k, c) { this.stops.push([k, col(c)]); } }; }\n  fill() { for (const s of this.sub) { if (s.k === 1) fillEll(this.buf, s, this.fillStyle); else fillPoly(this.buf, s.p, col(this.fillStyle)); } }\n  stroke() {\n    const m = this.m, hw = this.lineWidth / 2 * Math.sqrt(Math.abs(m[0] * m[3] - m[1] * m[2])), c = col(this.strokeStyle);\n    for (const s of this.sub) if (s.k === 0) for (let k = 0; k + 3 < s.p.length; k += 2) {\n      const x0 = s.p[k], y0 = s.p[k + 1], x1 = s.p[k + 2], y1 = s.p[k + 3], L = Math.hypot(x1 - x0, y1 - y0) || 1;\n      const nx = -(y1 - y0) / L * hw, ny = (x1 - x0) / L * hw;\n      fillPoly(this.buf, [x0 + nx, y0 + ny, x1 + nx, y1 + ny, x1 - nx, y1 - ny, x0 - nx, y0 - ny], c);\n    }\n  }\n}\nconst g0 = new Ctx();\n\n// ---------- creatures, drawn in local px facing +x (as in the original) ----------\nconst ell = (g, x, y, rx, ry, rot, fill) => { g.beginPath(); g.ellipse(x, y, rx, ry, rot || 0, 0, TAU); g.fillStyle = fill; g.fill(); };\n\nfunction turtle(g, t, s, ph) {\n  const f = Math.sin(TAU * 14 * t / T + ph);\n  for (const m of [-1, 1]) {\n    g.save(); g.translate(62, 58 * m); g.rotate(m * (1.15 + 0.55 * f));\n    ell(g, 0, 78 * m, 26, 92, 0, \"#9c8a5c\"); ell(g, 0, 70 * m, 14, 70, 0, \"#c2b183\"); g.restore();\n    g.save(); g.translate(-92, 40 * m); g.rotate(m * (2.2 - 0.3 * f));\n    ell(g, 0, 26 * m, 15, 34, 0, \"#9c8a5c\"); g.restore();\n  }\n  ell(g, 118, 0, 30, 24, 0, \"#a39060\"); ell(g, 150, 0, 34, 27, 0, \"#b8a573\");\n  ell(g, 146, -10, 7, 5, 0, \"#4b3f22\"); ell(g, 146, 10, 7, 5, 0, \"#4b3f22\");\n  ell(g, 0, 0, 132, 100, 0, \"#c9b067\");                  // marginal rim\n  const shd = g.createRadialGradient(-10, 0, 10, 0, 0, 125);\n  shd.addColorStop(0, \"#7d6