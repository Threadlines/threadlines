g.createRadialGradient(hx, hy, 0, hx, hy, r);\n      grad.addColorStop(0, 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + (a * 0.5).toFixed(4) + ')');\n      grad.addColorStop(1, 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',0)');\n      g.fillStyle = grad;\n      g.fillRect(hx - r, hy - r, r * 2, r * 2);\n    }\n    const hr = Math.min(255, c[0] + 125), hg = Math.min(255, c[1] + 125), hb = Math.min(255, c[2] + 125);\n    const sz = 2.6 * s;\n    g.fillStyle = 'rgba(' + hr + ',' + hg + ',' + hb + ',' + Math.min(1, a * 0.95).toFixed(4) + ')';\n    g.fillRect(hx - sz * 0.5, hy - sz * 0.5, sz, sz);\n  }\n\n  function drawPulse(g, p, pulseBoost) {\n    const fadeIn = Math.min(1, p.age / 1.8);\n    const fadeOut = Math.min(1, Math.max(0, (p.life - p.age) / 2.2));\n    const baseA = fadeIn * fadeOut * (p.extra ? p.extraAlpha : 1);\n    if (baseA <= 0.01) return;\n    const hx = ox + (p.ix + DX[p.dir] * p.prog) * tile + 0.5;\n    const hy = oy + (p.iy + DY[p.dir] * p.prog) * tile + 0.5;\n    const a = baseA * quietFactor(hx, hy) * (1 + pulseBoost * 0.28);\n    if (a <= 0.01) return;\n    const c = COLORS[p.ci], cr = c[0], cg = c[1], cb = c[2];\n    const tr = p.trail;\n    let x0 = hx, y0 = hy, dist = 0;\n    const tailLen = p.tail;\n    g.lineCap = 'butt'; g.lineJoin = 'miter';\n    for (let k = tr.length - 1; k >= 0 && dist < tailLen; k--) {\n      const vx = ox + tr[k].x * tile + 0.5, vy = oy + tr[k].y * tile + 0.5;\n      const segLen = k === tr.length - 1 ? p.prog : 1.0;\n      if (segLen <= 0.0001) { x0 = vx; y0 = vy; continue; }\n      let x1 = vx, y1 = vy, used = segLen;\n      if (dist + segLen > tailLen) {\n        const frac = (tailLen - dist) / segLen;\n        x1 = x0 + (vx - x0) * frac; y1 = y0 + (vy - y0) * frac; used = tailLen - dist;\n      }\n      const steps = used > 0.45 ? 2 : 1;\n      for (let s = 0; s < steps; s++) {\n        const f0 = s / steps, f1 = (s + 1) / steps;\n        const sx0 = x0 + (x1 - x0) * f0, sy0 = y0 + (y1 - y0) * f0;\n        const sx1 = x0 + (x1 - x0) * f1, sy1 = y0 + (y1 - y0) * f1;\n        const uMid = (dist + used * (f0 + f1) * 0.5) / tailLen;\n        const segA = a * (1 - uMid) * (1 - uMid);\n        if (segA > 0.005) {\n          g.beginPath(); g.moveTo(sx0, sy0); g.lineTo(sx1, sy1);\n          g.strokeStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + (segA * 0.14).toFixed(4) + ')';\n          g.lineWidth = 6; g.stroke();\n          g.beginPath(); g.moveTo(sx0, sy0); g.lineTo(sx1, sy1);\n          g.strokeStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + (segA * 0.80).toFixed(4) + ')';\n          g.lineWidth = 1.6; g.stroke();\n        }\n      }\n      if (k > 0 && dist + used < tailLen) {\n        const prev = tr[k - 1], curr = tr[k];\n        const turned = (Math.abs(x1 - x0) > 0.1 && prev.x === curr.x) || (Math.abs(y1 - y0) > 0.1 && prev.y === curr.y);\n        if (turned) {\n          const uCorner = (dist + used) / tailLen;\n          const ca = a * (1 - uCorner) * (1 - uCorner);\n          if (ca > 0.01) {\n            g.fillStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + (ca * 0.80).toFixed(4) + ')';\n            g.fillRect(x1 - 0.8, y1 - 0.8, 1.6, 1.6);\n          }\n        }\n      }\n      dist += used; x0 = x1; y0 = y1;\n    }\n    drawHead(g, hx, hy, p.ci, a, 1);\n  }\n\n  function drawBursts(g) {\n    g.lineCap = 'butt';\n    for (let i = 0; i < bursts.length; i++) {\n      const b = bursts[i];\n      const u = b.age / b.life;\n      const ease = 1 - (1 - u) * (1 - u) * (1 - u);\n      const env = Math.sin(u * Math.PI);\n      const cx = ox + b.ix * tile + 0.5, cy = oy + b.iy * tile + 0.5;\n      const a = env * quietFactor(cx, cy) * 0.65;\n      if (a <= 0.01) continue;\n      const c = COLORS[b.ci];\n      const headD = ease * b.maxDist * tile;\n      const tailD = Math.max(0, headD - tile * 1.4 * (1 - u * 0.42));\n      for (let d = 0; d < 4; d++) {\n        const sx = cx + DX[d] * tailD, sy = cy + DY[d] * tailD;\n        const ex = cx + DX[d] * headD, ey = cy + DY[d] * headD;\n        const mx = (sx + ex) * 0.5, my = (sy + ey) * 0.5;\n        g.beginPath(); g.moveTo(sx, sy); g.lineTo(mx, my);\n        g.strokeStyle = 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + (a * 0.08).toFixed(4) + ')';\n        g.lineWidth = 5; g.stroke();\n        g.beginPath(); g.moveTo(sx, sy); g.lineTo(mx, my);\n        g.strokeStyle = 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + (a * 0.34).toFixed(4) + ')';\n        g.lineWidth = 1.4; g.stroke();\n        g.beginPath(); g.moveTo(mx, my); g.lineTo(ex, ey);\n        g.strokeStyle = 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + (a * 0.15).toFixed(4) + ')';\n        g.lineWidth = 5; g.stroke();\n        g.beginPath(); g.moveTo(mx, my); g.lineTo(ex, ey);\n        g.strokeStyle = 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + (a * 0.74).toFixed(4) + ')';\n        g.lineWidth = 1.5; g.stroke();\n        drawHead(g, ex, ey, b.ci, a * 0.85, 0.72);\n      }\n    }\n  }\n\n  threadlines.backdrop({\n    mode: 'canvas',\n    context: '2d',\n    setup(info) {\n      seed = 409611;\n      buildGlowSprites();\n      buildBg(info.width, info.height);\n      const isPhone = W < 720;\n      const baseCount = isPhone ? 4 : 8;\n      const extraCount = isPhone ? 0 : 2;\n      pulses = []; bursts = []; workEase = 0; lastPulse = 0; burstTimer = 18;\n      for (let i = 0; i < baseCount; i++) pulses.push(makePulse(i % 4, false, i < 3 ? 0 : (i < 6 ? 1 : 2)));\n      for (let i = 0; i < extraCount; i++) pulses.push(makePulse(i % 4, true));\n      for (let s = 0; s < 85; s++) stepSim(0.05, 0);\n      spawnBurst(1);\n      bursts[0].age = 0.95;\n    },\n    draw(g, info) {\n      if (info.width !== W || info.height !== H) buildBg(info.width, info.height);\n      const dt = Math.min(info.dt || 0, 0.1);\n      const state = info.state || {};\n      const working = (state.working || 0) > 0 ? 1 : 0;\n      const pulseVal = state.pulse || 0;\n      if (pulseVal > 0.65 && lastPulse <= 0.65) spawnBurst();\n      last