    "script": "(function () {\n  const COLORS = [\n    [46, 118, 255],\n    [242, 92, 84],\n    [245, 184, 46],\n    [52, 211, 125],\n  ];\n  const DX = [1, 0, -1, 0];\n  const DY = [0, 1, 0, -1];\n\n  let W = 0, H = 0, tile = 40, ox = 0, oy = 0, cols = 0, rows = 0;\n  let bgCanvas = null;\n  let glowSprites = null;\n  let pulses = [];\n  let bursts = [];\n  let workEase = 0;\n  let lastPulse = 0;\n  let burstTimer = 18;\n  let seed = 409611;\n\n  function rand() {\n    seed = (seed * 1664525 + 1013904223) >>> 0;\n    return seed / 4294967296;\n  }\n\n  function tileHash(c, r) {\n    let h = Math.imul(c + 37, 374761393) ^ Math.imul(r + 17, 668265263);\n    h = Math.imul(h ^ (h >>> 13), 1274126177);\n    return ((h ^ (h >>> 16)) >>> 0) / 4294967296;\n  }\n\n  function buildGlowSprites() {\n    glowSprites = null;\n    if (typeof OffscreenCanvas === 'undefined') return;\n    try {\n      const sz = 56, half = sz * 0.5;\n      glowSprites = COLORS.map(function (c) {\n        const oc = new OffscreenCanvas(sz, sz);\n        const og = oc.getContext('2d');\n        const grad = og.createRadialGradient(half, half, 0, half, half, half);\n        grad.addColorStop(0.0, 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',0.55)');\n        grad.addColorStop(0.18, 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',0.28)');\n        grad.addColorStop(0.45, 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',0.085)');\n        grad.addColorStop(1.0, 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',0)');\n        og.fillStyle = grad;\n        og.fillRect(0, 0, sz, sz);\n        return oc;\n      });\n    } catch (e) {\n      glowSprites = null;\n    }\n  }\n\n  function buildBg(w, h) {\n    W = w; H = h;\n    tile = Math.min(w, h) < 520 ? 32 : 40;\n    ox = Math.floor((w % tile) * 0.5);\n    oy = Math.floor((h % tile) * 0.5);\n    cols = Math.ceil((w - ox) / tile) + 1;\n    rows = Math.ceil((h - oy) / tile) + 1;\n    bgCanvas = null;\n    if (typeof OffscreenCanvas !== 'undefined') {\n      try {\n        bgCanvas = new OffscreenCanvas(w, h);\n        paintStaticBg(bgCanvas.getContext('2d'), w, h);\n      } catch (e) { bgCanvas = null; }\n    }\n  }\n\n  function paintStaticBg(g, w, h) {\n    const bgGrad = g.createLinearGradient(0, 0, 0, h);\n    bgGrad.addColorStop(0, '#0a0c10');\n    bgGrad.addColorStop(0.5, '#0c0f15');\n    bgGrad.addColorStop(1, '#090b0f');\n    g.fillStyle = bgGrad;\n    g.fillRect(0, 0, w, h);\n\n    for (let r = -1; r <= rows; r++) {\n      const y = oy + r * tile;\n      if (y > h || y + tile < 0) continue;\n      for (let c = -1; c <= cols; c++) {\n        const x = ox + c * tile;\n        if (x > w || x + tile < 0) continue;\n        const n = tileHash(c, r);\n        if (n > 0.55) {\n          g.fillStyle = 'rgba(255,255,255,' + ((n - 0.55) * 0.030).toFixed(4) + ')';\n          g.fillRect(x + 1, y + 1, tile - 2, tile - 2);\n        } else if (n < 0.35) {\n          g.fillStyle = 'rgba(0,0,0,' + ((0.35 - n) * 0.22).toFixed(4) + ')';\n          g.fillRect(x + 1, y + 1, tile - 2, tile - 2);\n        }\n      }\n    }\n\n    g.beginPath();\n    for (let c = 0; c <= cols; c++) { const x = ox + c * tile + 0.5; g.moveTo(x, 0); g.lineTo(x, h); }\n    for (let r = 0; r <= rows; r++) { const y = oy + r * tile + 0.5; g.moveTo(0, y); g.lineTo(w, y); }\n    g.strokeStyle = 'rgba(130, 150, 180, 0.062)';\n    g.lineWidth = 1;\n    g.stroke();\n\n    g.fillStyle = 'rgba(170, 192, 224, 0.13)';\n    for (let r = 0; r <= rows; r++) {\n      const y = oy + r * tile;\n      for (let c = 0; c <= cols; c++) { g.fillRect(ox + c * tile, y, 1, 1); }\n    }\n\n    const vig = g.createRadialGradient(w * 0.5, h * 0.5, Math.min(w, h) * 0.28, w * 0.5, h * 0.5, Math.max(w, h) * 0.78);\n    vig.addColorStop(0, 'rgba(0,0,0,0)');\n    vig.addColorStop(1, 'rgba(4,5,8,0.40)');\n    g.fillStyle = vig;\n    g.fillRect(0, 0, w, h);\n  }\n\n  function quietFactor(px, py) {\n    const nx = px / W, ny = py / H;\n    if (W >= 720) {\n      const dx = Math.abs(nx - 0.56), dy = Math.abs(ny - 0.50);\n      const inX = dx < 0.22 ? 1 : (dx < 0.32 ? 1 - (dx - 0.22) / 0.10 : 0);\n      const inY = dy < 0.36 ? 1 : (dy < 0.46 ? 1 - (dy - 0.36) / 0.10 : 0);\n      return 1 - 0.58 * inX * inY;\n    }\n    if (ny < 0.30) return 0.55;\n    if (ny > 0.80) return 0.55;\n    return 1.0;\n  }\n\n  function makePulse(ci, isExtra, preferredSide) {\n    const isPhone = W < 720;\n    let ix, iy, dir;\n    if (!isPhone) {\n      const side = preferredSide !== undefined ? preferredSide : (rand() < 0.42 ? 0 : (rand() < 0.78 ? 1 : 2));\n      if (side === 0) {\n        ix = Math.floor(cols * (0.18 + rand() * 0.14));\n        iy = Math.floor(rows * (0.12 + rand() * 0.76));\n        dir = rand() < 0.80 ? (rand() < 0.5 ? 1 : 3) : 2;\n      } else if (side === 1) {\n        ix = Math.floor(cols * (0.81 + rand() * 0.16));\n        iy = Math.floor(rows * (0.12 + rand() * 0.76));\n        dir = rand() < 0.80 ? (rand() < 0.5 ? 1 : 3) : 2;\n      } else {\n        ix = Math.floor(cols * (0.15 + rand() * 0.75));\n        iy = rand() < 0.45 ? Math.floor(1 + rand() * Math.max(2, rows * 0.12)) : Math.floor(rows * 0.86 + rand() * Math.max(2, rows * 0.12));\n        dir = rand() < 0.5 ? 0 : 2;\n      }\n    } else {\n      ix = Math.floor(1 + rand() * Math.max(2, cols - 2));\n      iy = Math.floor(rows * (0.30 + rand() * 0.48));\n      dir = Math.floor(rand() * 4);\n    }\n    return {\n      ix, iy, dir,\n      prog: rand() * 0.5,\n      speed: 1.30 + rand() * 1.10,\n      tail: 4.0 + rand() * 3.5,\n      ci: ci !== undefined ? ci : Math.floor(rand() * 4),\n      trail: [{ x: ix, y: iy }],\n      stepsSinceTurn: 0,\n      age: 0,\n      life: 13 + rand() * 14,\n      extra: !!isExtra,\n      extraAlpha: isExtra ? 0 : 1,\n    };\n  }\n\n  function spawnBurst(slot) {\n    const isPhone = W < 720;\n    let ix, iy;\n    if (isPhone) {\n      ix = Math.floor(cols * (0.28 + rand() * 0.44));\n      iy = Math.floor(rows * (0.52 + rand() * 0.22));\n    } else {\n      const right = slot