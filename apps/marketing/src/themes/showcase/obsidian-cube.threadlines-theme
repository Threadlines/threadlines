    "script": "const faceColors = [\n  [218, 223, 234],\n  [229, 190, 69],\n  [74, 140, 255],\n  [52, 189, 122],\n  [223, 85, 85],\n  [228, 126, 60]\n];\n\nconst faceDefs = [\n  { n: [0, 1, 0],  u: [1, 0, 0],  v: [0, 0, -1], idx: 0 },\n  { n: [0, -1, 0], u: [1, 0, 0],  v: [0, 0, 1],  idx: 1 },\n  { n: [0, 0, 1],  u: [1, 0, 0],  v: [0, 1, 0],  idx: 2 },\n  { n: [0, 0, -1], u: [-1, 0, 0], v: [0, 1, 0],  idx: 3 },\n  { n: [1, 0, 0],  u: [0, 0, -1], v: [0, 1, 0],  idx: 4 },\n  { n: [-1, 0, 0], u: [0, 0, 1],  v: [0, 1, 0],  idx: 5 }\n];\n\nfunction makeChamfer(r, ch) {\n  const a = r - ch;\n  return [\n    [-a, -r], [a, -r],\n    [r, -a],  [r, a],\n    [a, r],   [-a, r],\n    [-r, a],  [-r, -a]\n  ];\n}\n\nconst bodyPts = makeChamfer(0.455, 0.075);\nconst stickerPts = makeChamfer(0.325, 0.065);\n\nconst lx = -0.18, ly = 0.80, lz = 0.57;\nconst ll = Math.hypot(lx, ly, lz);\nconst light = [lx / ll, ly / ll, lz / ll];\n\nconst wireEdges = [];\nfor (let i = -3; i <= 3; i += 2) {\n  const p = i * 0.5;\n  for (let j = -3; j <= 3; j += 2) {\n    const q = j * 0.5;\n    if (Math.abs(p) > 1.4 || Math.abs(q) > 1.4) {\n      wireEdges.push([[-1.5, p, q], [1.5, p, q]]);\n      wireEdges.push([[p, -1.5, q], [p, 1.5, q]]);\n      wireEdges.push([[p, q, -1.5], [p, q, 1.5]]);\n    }\n  }\n}\n\nconst fwdMoves = [\n  { axis: 1, layer: 1,  dir: 1 },\n  { axis: 0, layer: 1,  dir: 1 },\n  { axis: 2, layer: 1,  dir: -1 },\n  { axis: 0, layer: -1, dir: 1 },\n  { axis: 1, layer: 1,  dir: 1 },\n  { axis: 2, layer: 1,  dir: 1 },\n  { axis: 1, layer: -1, dir: -1 },\n  { axis: 0, layer: 1,  dir: -1 },\n  { axis: 2, layer: -1, dir: 1 },\n  { axis: 1, layer: 1,  dir: -1 },\n  { axis: 0, layer: -1, dir: -1 },\n  { axis: 2, layer: 1,  dir: -1 }\n];\nconst moves = fwdMoves.slice();\nfor (let i = fwdMoves.length - 1; i >= 0; i--) {\n  moves.push({ axis: fwdMoves[i].axis, layer: fwdMoves[i].layer, dir: -fwdMoves[i].dir });\n}\n\nlet w = 1440, h = 900, isPhone = false;\nlet cx = 0, cy = 0, scale = 50;\nlet ghostCx = 0, ghostCy = 0, ghostScale = 24;\nlet cubies = [];\nlet moveIdx = 4;\nlet phase = 0;\nlet workMix = 0;\nlet turning = true;\nlet turnProg = 0.42;\nlet pauseTimer = 0;\nlet ready = false;\n\nfunction applyMove(m) {\n  const axis = m.axis, layer = m.layer, dir = m.dir;\n  for (let i = 0; i < cubies.length; i++) {\n    const cb = cubies[i];\n    const coord = axis === 0 ? cb.x : (axis === 1 ? cb.y : cb.z);\n    if (coord !== layer) continue;\n    const oc = cb.c;\n    const nc = oc.slice();\n    if (axis === 0) {\n      const ny = -dir * cb.z;\n      const nz = dir * cb.y;\n      cb.y = ny; cb.z = nz;\n      if (dir === 1) {\n        nc[2] = oc[0]; nc[1] = oc[2]; nc[3] = oc[1]; nc[0] = oc[3];\n      } else {\n        nc[3] = oc[0]; nc[1] = oc[3]; nc[2] = oc[1]; nc[0] = oc[2];\n      }\n    } else if (axis === 1) {\n      const nx = dir * cb.z;\n      const nz = -dir * cb.x;\n      cb.x = nx; cb.z = nz;\n      if (dir === 1) {\n        nc[4] = oc[2]; nc[3] = oc[4]; nc[5] = oc[3]; nc[2] = oc[5];\n      } else {\n        nc[5] = oc[2]; nc[3] = oc[5]; nc[4] = oc[3]; nc[2] = oc[4];\n      }\n    } else {\n      const nx = -dir * cb.y;\n      const ny = dir * cb.x;\n      cb.x = nx; cb.y = ny;\n      if (dir === 1) {\n        nc[5] = oc[0]; nc[1] = oc[5]; nc[4] = oc[1]; nc[0] = oc[4];\n      } else {\n        nc[4] = oc[0]; nc[1] = oc[4]; nc[5] = oc[1]; nc[0] = oc[5];\n      }\n    }\n    cb.c = nc;\n  }\n}\n\nfunction rotVec(v, axis, c, s) {\n  const x = v[0], y = v[1], z = v[2];\n  if (axis === 0) return [x, y * c - z * s, y * s + z * c];\n  if (axis === 1) return [x * c + z * s, y, -x * s + z * c];\n  return [x * c - y * s, x * s + y * c, z];\n}\n\nfunction layout(width, height) {\n  w = width || 1440;\n  h = height || 900;\n  isPhone = w < 600;\n  cx = isPhone ? w * 0.50 : (w < 900 ? w * 0.84 : w * 0.87);\n  cy = isPhone ? h * 0.58 : h * 0.55;\n  scale = isPhone ? Math.min(w * 0.088, h * 0.044) : Math.min(w * 0.036, h * 0.056);\n  ghostCx = w * 0.085;\n  ghostCy = h * 0.82;\n  ghostScale = Math.min(w * 0.019, h * 0.030);\n}\n\nfunction init(info) {\n  layout(info && info.width, info && info.height);\n  cubies = [];\n  for (let x = -1; x <= 1; x++) {\n    for (let y = -1; y <= 1; y++) {\n      for (let z = -1; z <= 1; z++) {\n        cubies.push({\n          x, y, z,\n          c: [\n            y === 1 ? 0 : -1,\n            y === -1 ? 1 : -1,\n            z === 1 ? 2 : -1,\n            z === -1 ? 3 : -1,\n            x === 1 ? 4 : -1,\n            x === -1 ? 5 : -1\n          ]\n        });\n      }\n    }\n  }\n  for (let i = 0; i < 4; i++) {\n    applyMove(moves[i]);\n  }\n  moveIdx = 4;\n  phase = 0;\n  workMix = 0;\n  turning = true;\n  turnProg = 0.42;\n  pauseTimer = 0;\n  ready = true;\n}\n\nthreadlines.backdrop({\n  mode: \"canvas\",\n  context: \"2d\",\n  setup(info) {\n    init(info);\n  },\n  draw(ctx, info) {\n    if (!ready) init(info);\n    else if (info && (info.width !== w || info.height !== h)) layout(info.width, info.height);\n\n    const dt = (info && Number.isFinite(info.dt)) ? Math.min(Math.max(info.dt, 0), 0.1) : 0;\n    const st = (info && info.state) || {};\n    const working = st.working > 0 ? 1 : 0;\n    const pulse = st.pulse || 0;\n\n    workMix += (working - workMix) * Math.min(1, dt * 1.4);\n    const orbitSpeed = 0.18 + workMix * 0.10;\n    phase = (phase + orbitSpeed * dt) % (Math.PI * 2);\n\n    const turnDur = 1.25 - workMix * 0.55;\n    const pauseDur = 2.5 - workMix * 1.55;\n    if (dt > 0) {\n      if (turning) {\n        turnProg += dt / turnDur;\n        if (turnProg >= 1) {\n          applyMove(moves[moveIdx]);\n          moveIdx = (moveIdx + 1) % moves.length;\n          turning = false;\n          turnProg = 0;\n          pauseTimer = 0;\n        }\n      } else {\n        pauseTimer += dt;\n        if (pauseTimer >= pauseDur) {\n          turning = true;\n          turnProg = 0;\n        }\n      }\n    }\n\n    ctx.fillStyle = \"#0d0f13\";\n    ctx.fillRect(0, 0, w, h);\n\n    const glowR = scale * 5.8;\n    const g = ctx.createRadialGradient(cx, cy, scale * 0.4, cx, cy, glowR);\n    const pulseAlpha = 0.08 * pulse;\n    g.addColorStop(0, pulseAlpha > 0.005 ? \"rgba(82,148,255,\" + (0.09 + pulseAlpha).toFixed(3) + \")\" : \"rgba(42,52,72,0.22)\");\n    g.addColorStop(0.55, \"rgba(22,26,35,0.10)\");\n    g.addColorStop(1, \"rgba(13,15,19,0)\");\n    ctx.fillStyle = g;\n    ctx.fillRect(cx - glowR, cy - glowR, glowR * 2, glowR * 2);\n\n    ctx.strokeStyle = \"rgba(146,153,168,0.045)\";\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    const gridR = scale * 3.8;\n    ctx.moveTo(cx - gridR, cy);\n    ctx.lineTo(cx + gridR, cy);\n    ctx.moveTo(cx, cy - gridR);\n    ctx.lineTo(cx, cy + gridR);\n    ctx.stroke();\n\n    const yaw = -0.68 + Math.sin(phase) * 0.14;\n    const pitch = 0.56 + Math.cos(phase * 0.5) * 0.07;\n    const roll = Math.sin(phase * 0.5) * 0.04;\n    const cyaw = Math.cos(yaw), syaw = Math.sin(yaw);\n    const cpitch = Math.cos(pitch), spitch = Math.sin(pitch);\n    const croll = Math.cos(roll), sroll = Math.sin(roll);\n\n    const toView = (vx, vy, vz) => {\n      const x1 = vx * cyaw + vz * syaw;\n      const z1 = -vx * syaw + vz * cyaw;\n      const y2 = vy * cpitch - z1 * spitch;\n      const z2 = vy * spitch + z1 * cpitch;\n      return [x1 * croll - y2 * sroll, x1 * sroll + y2 * croll, z2];\n    };\n\n    if (!isPhone && w >= 900) {\n      const gyaw = 0.72 - phase * 0.22;\n      const gpitch = 0.48;\n      const gcy = Math.cos(gyaw), gsy = Math.sin(gyaw);\n      const gcp = Math.cos(gpitch), gsp = Math.sin(gpitch);\n      const gs = ghostScale;\n      ctx.strokeStyle = \"rgba(146,153,168,0.13)\";\n      ctx.lineWidth = 1;\n      ctx.beginPath();\n      for (let i = 0; i < wireEdges.length; i++) {\n        const e = wireEdges[i];\n        const a = e[0], b = e[1];\n        const ax1 = a[0] * gcy + a[2] * gsy, az1 = -a[0] * gsy + a[2] * gcy;\n        const ay2 = a[1] * gcp - az1 * gsp;\n        const bx1 = b[0] * gcy + b[2] * gsy, bz1 = -b[0] * gsy + b[2] * gcy;\n        const by2 = b[1] * gcp - bz1 * gsp;\n        ctx.moveTo(ghostCx + ax1 * gs, ghostCy - ay2 * gs);\n        ctx.lineTo(ghostCx + bx1 * gs, ghostCy - by2 * gs);\n      }\n      ctx.stroke();\n    }\n\n    const activeMove = moves[moveIdx];\n    const p = turning ? turnProg : 0;\n    const ease = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;\n    const turnAngle = turning ? activeMove.dir * ease * (Math.PI * 0.5) : 0;\n    const tc = Math.cos(turnAngle), ts = Math.sin(turnAngle);\n    const turnAxis = activeMove.axis;\n    const turnLayer = activeMove.layer;\n\n    const axisUnit = turnAxis === 0 ? [1, 0, 0] : (turnAxis === 1 ? [0, 1, 0] : [0, 0, 1]);\n    const vAxis = toView(axisUnit[0], axisUnit[1], axisUnit[2]);\n    const slabOrder = vAxis[2] >= 0 ? [-1, 0, 1] : [1, 0, -1];\n\n    const bobY = Math.sin(phase * 2) * (scale * 0.08);\n    const baseCx = cx;\n    const baseCy = cy + bobY;\n    const sc = scale;\n\n    ctx.save();\n    ctx.translate(baseCx, cy + sc * 2.55);\n    ctx.scale(1, 0.24);\n    const shR = sc * 2.15;\n    const shG = ctx.createRadialGradient(0, 0, shR * 0.1, 0, 0, shR);\n    shG.addColorStop(0, \"rgba(0,0,0,0.48)\");\n    shG.addColorStop(0.6, \"rgba(0,0,0,0.18)\");\n    shG.addColorStop(1, \"rgba(0,0,0,0)\");\n    ctx.fillStyle = shG;\n    ctx.beginPath();\n    ctx.arc(0, 0, shR, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n\n    for (let si = 0; si < 3; si++) {\n      const slabVal = slabOrder[si];\n      const isTurnSlab = turning && slabVal === turnLayer;\n      const slabCubies = [];\n\n      for (let i = 0; i < cubies.length; i++) {\n        const cb = cubies[i];\n        const coord = turnAxis === 0 ? cb.x : (turnAxis === 1 ? cb.y : cb.z);\n        if (coord !== slabVal) continue;\n        let pos = [cb.x, cb.y, cb.z];\n        if (isTurnSlab) pos = rotVec(pos, turnAxis, tc, ts);\n        const vp = toView(pos[0], pos[1], pos[2]);\n        slabCubies.push({ cb, pos, vz: vp[2] });\n      }\n\n      slabCubies.sort((a, b) => a.vz - b.vz);\n\n      for (let ci = 0; ci < slabCubies.length; ci++) {\n        const item = slabCubies[ci];\n        const cb = item.cb;\n        const pos = item.pos;\n\n        for (let fi = 0; fi < 6; fi++) {\n          const fd = faceDefs[fi];\n          let n = fd.n;\n          if (isTurnSlab) n = rotVec(n, turnAxis, tc, ts);\n          const vn = toView(n[0], n[1], n[2]);\n          if (vn[2] <= 0.01) continue;\n\n          let u = fd.u, v = fd.v;\n          if (isTurnSlab) {\n            u = rotVec(u, turnAxis, tc, ts);\n            v = rotVec(v, turnAxis, tc, ts);\n          }\n\n          const fcx = pos[0] + n[0] * 0.47;\n          const fcy = pos[1] + n[1] * 0.47;\n          const fcz = pos[2] + n[2] * 0.47;\n\n          const ndl = Math.max(0, vn[0] * light[0] + vn[1] * light[1] + vn[2] * light[2]);\n          const shade = 0.62 + 0.38 * ndl;\n\n          const bodyLum = Math.round(18 + 20 * ndl);\n          ctx.fillStyle = \"rgb(\" + bodyLum + \",\" + (bodyLum + 2) + \",\" + (bodyLum + 7) + \")\";\n          ctx.beginPath();\n          for (let k = 0; k < 8; k++) {\n            const pt = bodyPts[k];\n            const px = fcx + u[0] * pt[0] + v[0] * pt[1];\n            const py = fcy + u[1] * pt[0] + v[1] * pt[1];\n            const pz = fcz + u[2] * pt[0] + v[2] * pt[1];\n            const vp = toView(px, py, pz);\n            const sx = baseCx + vp[0] * sc;\n            const sy = baseCy - vp[1] * sc;\n            if (k === 0) ctx.moveTo(sx, sy);\n            else ctx.lineTo(sx, sy);\n          }\n          ctx.closePath();\n          ctx.fill();\n\n          ctx.strokeStyle = isTurnSlab && pulse > 0.05\n            ? \"rgba(82,148,255,\" + (0.12 + 0.25 * pulse).toFixed(3) + \")\"\n            : \"rgba(255,255,255,\" + (0.03 + 0.04 * ndl).toFixed(3) + \")\";\n          ctx.lineWidth = 0.8;\n          ctx.stroke();\n\n          const colIdx = cb.c[fd.idx];\n          if (colIdx >= 0) {\n            const rgb = faceColors[colIdx];\n            const boost = 1 + pulse * 0.14;\n            const r = Math.min(255, Math.round(rgb[0] * shade * 0.88 * boost));\n            const gg = Math.min(255, Math.round(rgb[1] * shade * 0.88 * boost));\n            const b = Math.min(255, Math.round(rgb[2] * shade * 0.88 * boost));\n            ctx.fillStyle = \"rgb(\" + r + \",\" + gg + \",\" + b + \")\";\n\n            ctx.beginPath();\n            for (let k = 0; k < 8; k++) {\n              const pt = stickerPts[k];\n              const px = fcx + n[0] * 0.008 + u[0] * pt[0] + v[0] * pt[1];\n              const py = fcy + n[1] * 0.008 + u[1] * pt[0] + v[1] * pt[1];\n              const pz = fcz + n[2] * 0.008 + u[2] * pt[0] + v[2] * pt[1];\n              const vp = toView(px, py, pz);\n              const sx = baseCx + vp[0] * sc;\n              const sy = baseCy - vp[1] * sc;\n              if (k === 0) ctx.moveTo(sx, sy);\n              else ctx.lineTo(sx, sy);\n            }\n            ctx.closePath();\n            ctx.fill();\n          }\n        }\n      }\n    }\n  }\n});",
