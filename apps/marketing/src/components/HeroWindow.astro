---
/**
 * The homepage's hero: a simplified Threadlines window drawn in the page's
 * own markup, wearing real themes (lib/heroThemes.ts), with the app's own
 * theme strip above its message box to try and pick them. A theme with art runs the app's own backdrop frame
 * behind the window's panels (scripts/heroWindow.ts).
 *
 * The window is one picture (`role="img"`): nothing inside it is a control.
 * The theme strip is a real control, so it sits over the window as a sibling
 * (placed by scripts/heroWindow.ts), with a zone of its own for the art.
 * Its zones (`data-zone`) mirror the theme specimen's: `frame` for the title
 * bar and rail, `list`, `column` and `composer`.
 */
import "../styles/window-parts.css";

import AgentMark from "./AgentMark.astro";
import {
  HERO_COMPOSER_PLACEHOLDER,
  HERO_FIRST_THEME,
  HERO_FRAME_PATH,
  HERO_THEME_INTRO,
  HERO_THUMB_SIZE,
  HERO_YOURS_ASKS,
  heroArtPath,
  type HeroTheme,
  heroThumbPath,
} from "../lib/heroThemes";

interface Props {
  themes: ReadonlyArray<HeroTheme>;
  label: string;
}

const { themes, label } = Astro.props;
const first = themes.find((theme) => theme.id === HERO_FIRST_THEME.light) ?? themes[0]!;
/** The ring on a picked tile: the theme's own accent (Default's follows the page). */
const tileAccent = (theme: HeroTheme) =>
  typeof theme.accent === "string" ? theme.accent : `light-dark(${theme.accent.light}, ${theme.accent.dark})`;

/** Rows in the thread list: [project, meta, title, status, right side]. */
const rows: {
  project: string;
  meta: string;
  title: string;
  status?: "working" | "waiting" | "done";
  agent: "claude-code" | "codex";
  note?: string;
}[] = [
  { project: "Orbit", meta: "Opus 5.5 · working", title: "Double charges at checkout", status: "working", agent: "claude-code", note: "+36 −3" },
  { project: "Orbit · main", meta: "12m", title: "Review signup trends", status: "done", agent: "claude-code" },
  { project: "Orbit · main", meta: "2d", title: "Retry usage and checkout", agent: "claude-code" },
  { project: "Orbit", meta: "input", title: "Checkout recovery", status: "waiting", agent: "codex" },
  { project: "Northstar · main", meta: "3d", title: "Deploy health", status: "done", agent: "claude-code" },
  { project: "Orbit · usage", meta: "3d", title: "Usage insights", agent: "claude-code", note: "#84" },
  { project: "Lumen · main", meta: "3d", title: "Rollout cohorts", agent: "codex" },
  { project: "Northstar", meta: "5d", title: "Group noisy alerts", agent: "claude-code", note: "#41" },
  { project: "Orbit · main", meta: "5d", title: "Release guard", agent: "codex" },
];

const icon = {
  compose: `<path d="M11 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><path d="M18.4 2.6a2 2 0 0 1 2.9 2.9L12 14.8 8 16l1.2-4z"/>`,
  inbox: `<path d="M3 13h5l1.5 3h5L16 13h5"/><path d="M5.5 5h13L21 13v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5z"/>`,
  chats: `<path d="M4 5h12v9H8l-4 3z"/><path d="M16 9h4v9l-3-2h-6v-2"/>`,
  pr: `<circle cx="6" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M6 8v8M18 16V9.5a3 3 0 0 0-3-3h-3.5M13.5 4.5l-2 2 2 2"/>`,
  fleet: `<rect x="2.5" y="4.5" width="13" height="9.5" rx="1.5"/><path d="M6.5 18h5M9 14v4"/><rect x="17.5" y="6.5" width="4" height="11.5" rx="1"/>`,
  clock: `<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>`,
  usage: `<path d="M5 20V10M12 20V4M19 20v-7"/>`,
  settings: `<circle cx="12" cy="12" r="3"/><path d="M12 2.5v3M12 18.5v3M4.2 6.5l2.6 1.5M17.2 16l2.6 1.5M4.2 17.5 6.8 16M17.2 8l2.6-1.5"/>`,
  search: `<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>`,
  chevron: `<path d="m9 6 6 6-6 6"/>`,
  menu: `<path d="M4 7h16M4 12h16M4 17h16"/>`,
  send: `<path d="M12 19V5M6 11l6-6 6 6"/>`,
  sidebar: `<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M9 4v16"/>`,
  back: `<path d="m15 6-6 6 6 6"/>`,
  fwd: `<path d="m9 6 6 6-6 6"/>`,
  eye: `<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3"/>`,
  sliders: `<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>`,
  lock: `<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>`,
  hammer: `<path d="m14 6 4 4-9.5 9.5a2.1 2.1 0 0 1-3-3z"/><path d="m13 3 8 8-2 2-8-8z"/>`,
} as const;
const svg = (name: keyof typeof icon) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[name]}</svg>`;
---

<div class="hw-wrap">
  <div
    class="hw"
    data-hero-window
    data-frame={HERO_FRAME_PATH}
    data-first-light={HERO_FIRST_THEME.light}
    data-first-dark={HERO_FIRST_THEME.dark}
    role="img"
    aria-label={label}
  >
    <div class="hw-art" aria-hidden="true"></div>
    <div class="hw-app" inert aria-hidden="true">
      <header class="hw-title hw-glass" data-zone="frame">
        <span class="hw-lights"><i></i><i></i><i></i></span>
        <span class="hw-brand">Threadlines</span>
        <span class="hw-tb-icons"><Fragment set:html={svg("sidebar")} /><Fragment set:html={svg("back")} /><Fragment set:html={svg("fwd")} /></span>
        <span class="hw-crumbs"
          ><span class="hw-dim">Orbit</span><span class="hw-dim">/</span><span class="hw-crumb-title">Double charges at checkout</span></span
        >
        <span class="hw-tb-right"><span class="hw-ok">+36</span><span class="hw-bad">−3</span></span>
      </header>
      <nav class="hw-rail hw-glass" data-zone="frame">
        <Fragment set:html={svg("compose")} />
        <span class="hw-rail-on"><Fragment set:html={svg("inbox")} /><b></b></span>
        <Fragment set:html={svg("chats")} />
        <Fragment set:html={svg("pr")} />
        <Fragment set:html={svg("fleet")} />
        <Fragment set:html={svg("clock")} />
        <Fragment set:html={svg("usage")} />
        <span class="hw-rail-end"><Fragment set:html={svg("settings")} /></span>
      </nav>
      <aside class="hw-list hw-glass" data-zone="list">
        <div class="hw-search"><Fragment set:html={svg("search")} /><span>Search</span><kbd>⌘K</kbd></div>
        {
          rows.map((row, index) => (
            <div class={`hw-row${index === 0 ? " is-on" : ""}`}>
              <div class="hw-row-meta">
                {row.status && <span class={`hw-dot hw-dot-${row.status}`} />}
                <span class="hw-row-project">{row.project}</span>
                <span class={`hw-row-when${row.status === "working" ? " hw-working" : row.status === "waiting" ? " hw-waiting" : ""}`}>
                  {row.meta}
                </span>
              </div>
              <div class="hw-row-title">
                <span class="hw-row-name">{row.title}</span>
                {row.note && <span class={row.note.startsWith("#") ? "hw-row-pr" : "hw-row-diff"}>{row.note}</span>}
                <span class="hw-row-mark">
                  <AgentMark slug={row.agent} />
                </span>
              </div>
            </div>
          ))
        }
      </aside>
      <main class="hw-main">
        <header class="hw-phone-head hw-glass" data-zone="frame">
          <Fragment set:html={svg("menu")} /><span>Double charges at checkout</span>
        </header>
        <div class="hw-column" data-zone="column">
          <div class="hw-thread">
            <p class="hw-user">Some customers get charged twice at checkout. Find out why.</p>
            <div class="hw-turn">
              <p class="hw-who"><span class="hw-mark"><AgentMark slug="claude-code" /></span><b>Opus 5.5</b><span class="hw-dim">· High</span></p>
              <p class="hw-tool"><Fragment set:html={svg("chevron")} />Read 3 files <span class="hw-dim">· tests passed</span></p>
              <p>Double clicks are blocked and the checkout tests pass. I can't reproduce it yet.</p>
              <p class="hw-meta">Worked for 1m 15s · <span class="hw-ok">checks passed</span></p>
            </div>
            <p class="hw-user">I added Sol. Ask it to take a look.</p>
            <div class="hw-turn">
              <p class="hw-who"><span class="hw-mark"><AgentMark slug="claude-code" /></span><b>Opus 5.5</b><span class="hw-dim">· High</span></p>
              <p class="hw-meta">to GPT-6.1-Sol · question on the side</p>
              <p>Checkout tests pass. What could still cause two charges?</p>
              <div class="hw-side">
                <p class="hw-who"><span class="hw-mark hw-mark-codex"><AgentMark slug="codex" /></span><b>GPT-6.1-Sol</b><span class="hw-dim">· on the side</span></p>
                <p>The payment succeeds, the reply times out, and retry.ts has no idempotency key.</p>
              </div>
              <p class="hw-tool"><Fragment set:html={svg("eye")} />Read retry.ts</p>
              <p class="hw-meta"><span class="hw-working-dots"><i></i><i></i><i></i></span>Working · 5s</p>
            </div>
          </div>
          <div class="hw-composer" data-zone="composer">
            <p class="hw-ask">
              {
                themes.map((theme) =>
                  theme.ask === null ? (
                    <span class="hw-for" data-for={theme.id}>
                      <span class="hw-caret" />
                      <span class="hw-placeholder">{HERO_COMPOSER_PLACEHOLDER}</span>
                    </span>
                  ) : (
                    <span class="hw-for" data-for={theme.id}>
                      {theme.ask}
                      <span class="hw-caret" />
                    </span>
                  ),
                )
              }
              <!-- The strip's "Yours" tile types here (scripts/heroWindow.ts). -->
              <span class="hw-yours"><span class="hw-yours-text"></span><span class="hw-caret"></span></span>
            </p>
            <div class="hw-chips">
              <span class="hw-chip"
                ><span class="hw-mark"><AgentMark slug="claude-code" /></span><span class="hw-mark hw-mark-codex"
                  ><AgentMark slug="codex" /></span
                >Opus 5.5</span
              >
              <span class="hw-chip hw-chip-more"><Fragment set:html={svg("sliders")} />High</span>
              <span class="hw-chip hw-chip-more"><Fragment set:html={svg("hammer")} />Build</span>
              <span class="hw-chip hw-chip-more hw-chip-last"><Fragment set:html={svg("lock")} />Full access</span>
              <span class="hw-send"><Fragment set:html={svg("send")} /></span>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  <!--
    The rings where the threads enter and leave the window, and the ripple along its top edge.
    Siblings of the window, which clips: placed and shown by the threads script (scripts/threads/hero.ts).
  -->
  <span class="hw-tokens nt-port top" aria-hidden="true" hidden><i></i></span>
  <span class="hw-tokens nt-port bottom" aria-hidden="true" hidden><i></i></span>
  <span class="nt-ripple l" aria-hidden="true" hidden></span>
  <span class="nt-ripple r" aria-hidden="true" hidden></span>

  <!--
    The theme strip, as the app shows it above the message box after /theme. Placed over the window
    by scripts/heroWindow.ts, and hidden without scripts (nothing could switch the theme).
  -->
  <fieldset class="hw-tokens hw-strip" data-zone="strip" data-yours-asks={JSON.stringify(HERO_YOURS_ASKS)} hidden>
    <legend class="hw-strip-title">Theme</legend>
    <!-- The showing theme's name, once, beside the title; each tile keeps its name as its label. -->
    <span class="hw-strip-now" aria-hidden="true">
      {themes.map((theme) => <span class="hw-for" data-for={theme.id}>{theme.name}</span>)}
    </span>
    <div class="hw-strip-row">
      {
        themes.map((theme, i) => (
          <label class="hw-tile" data-for={theme.id} title={theme.name} style={`--i:${i};--tile-accent:${tileAccent(theme)}`}>
            <input
              type="radio"
              name="hero-theme"
              value={theme.id}
              checked={theme.id === first.id}
              data-art={theme.hasArt ? heroArtPath(theme.id) : undefined}
            />
            <span class="hw-tile-pic" aria-hidden="true">
              {theme.hasArt ? (
                <img data-src={heroThumbPath(theme.id)} width={HERO_THUMB_SIZE.width} height={HERO_THUMB_SIZE.height} alt="" decoding="async" />
              ) : (
                <span class="hw-tile-mini">
                  <i />
                  <i />
                </span>
              )}
            </span>
            <span class="sr-only">{theme.name}</span>
          </label>
        ))
      }
      <button type="button" class="hw-tile hw-tile-yours" data-yours title="Yours: type an example ask" style={`--i:${themes.length}`}>
        <span class="hw-tile-pic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 6v12M6 12h12" /></svg>
        </span>
        <span class="sr-only">Yours: type an example ask</span>
      </button>
    </div>
  </fieldset>

  <div class="hw-pick">
    <div class="hw-now" aria-live="polite">
      {
        themes.map((theme) => (
          <p class="hw-for" data-for={theme.id}>
            <strong>{theme.name}</strong>,{" "}
            {theme.credit.href ? (
              <a href={theme.credit.href} target="_blank" rel="noopener noreferrer">
                {theme.credit.text}
              </a>
            ) : (
              <span>{theme.credit.text}</span>
            )}
            <span class="hw-about">{theme.about}</span>
          </p>
        ))
      }
    </div>
    <p class="hw-yours-said sr-only" aria-live="polite"></p>
    <div class="hw-intro">
      <h2 class="hw-intro-title">{HERO_THEME_INTRO.title}</h2>
      <p>{HERO_THEME_INTRO.text}</p>
      <p class="hw-caption">{HERO_THEME_INTRO.caption}</p>
    </div>
  </div>
  <script is:inline>
    // Before the strip shows: check the theme the head script chose.
    {
      const id = document.documentElement.dataset.heroTheme;
      for (const input of document.querySelectorAll('input[name="hero-theme"]')) input.checked = input.value === id;
    }
  </script>
</div>

<script>
  import { startHeroWindow } from "../scripts/heroWindow";

  startHeroWindow();
</script>

<style>
  .hw-wrap {
    position: relative;
    container-type: inline-size;
    width: 100%;
  }

  /* The rings on the window's edges: the top one takes each arriving pulse, the bottom one answers. */
  .nt-port {
    position: absolute;
    z-index: 3;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    border-radius: 50%;
    background: var(--hw-frame, var(--bg-card));
    box-shadow:
      0 0 0 2.5px var(--nt-ink),
      0 0 0 6px color-mix(in srgb, var(--bg) 70%, transparent);
    pointer-events: none;
  }

  .nt-port.bottom {
    background: var(--hw-surface-solid, var(--bg-card));
  }

  /* The flash: its color is set per pulse (--flash); only its opacity and scale animate. */
  .nt-port i {
    position: absolute;
    inset: -2.5px;
    border-radius: 50%;
    opacity: 0;
    box-shadow:
      0 0 0 3px var(--flash, transparent),
      0 0 14px 2px var(--flash, transparent);
  }

  .nt-port[hidden],
  .nt-ripple[hidden] {
    display: none;
  }

  .nt-ripple {
    position: absolute;
    z-index: 3;
    height: 2px;
    opacity: 0;
    pointer-events: none;
    border-radius: 1px;
  }

  .nt-ripple.l {
    transform-origin: right center;
  }

  .nt-ripple.r {
    transform-origin: left center;
  }

  /* ---- The window ------------------------------------------------------ */

  .hw {
    /* Default's tokens, for when no theme is chosen (no script). */
    --hw-gap: 16px;
    position: relative;
    height: 660px;
    border-radius: 14px;
    overflow: hidden;
    isolation: isolate;
    background: var(--hw-surface-solid, var(--bg-elev));
    color: var(--hw-foreground, var(--fg));
    font-family: var(--hw-sans, var(--font-sans));
    font-size: 14px;
    line-height: 1.5;
    text-align: left;
    box-shadow:
      0 0 0 1px var(--frame-edge),
      0 2px 4px light-dark(rgba(13, 16, 23, 0.04), rgba(0, 0, 0, 0.3)),
      0 40px 90px -30px light-dark(rgba(13, 16, 23, 0.34), rgba(0, 0, 0, 0.7));
    -webkit-font-smoothing: antialiased;
    user-select: none;
  }

  .hw-art {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hw-art :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms var(--ease);
  }

  .hw[data-art="live"] .hw-art :global(iframe) {
    opacity: 1;
  }

  .hw-app {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template: 44px minmax(0, 1fr) / 52px 284px minmax(0, 1fr);
    height: 100%;
  }

  /* Surfaces are solid until the art draws its first frame; then the frame tints them. */
  .hw-glass,
  .hw-composer,
  .hw-main {
    transition: background-color 240ms var(--ease);
  }

  .hw[data-art="live"] .hw-glass,
  .hw[data-art="live"] .hw-main,
  .hw[data-art="live"] .hw-composer {
    background-color: transparent;
  }

  .hw-ok {
    color: var(--hw-success-foreground);
  }

  .hw-bad {
    color: var(--hw-destructive);
  }

  /* Title bar */
  .hw-title {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 16px;
    background-color: var(--hw-frame);
    border-bottom: 1px solid var(--hw-sidebar-border);
    color: var(--hw-muted-foreground);
    white-space: nowrap;
  }

  .hw-lights {
    display: inline-flex;
    gap: 8px;
  }

  .hw-lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--hw-muted-foreground) 35%, transparent);
  }

  .hw-brand {
    margin-left: 6px;
    color: var(--hw-foreground);
    font-weight: 600;
  }

  .hw-tb-icons {
    display: inline-flex;
    gap: 14px;
    width: 216px;
  }

  .hw-tb-icons :global(svg),
  .hw-search :global(svg) {
    width: 16px;
    height: 16px;
  }

  .hw-crumbs {
    display: inline-flex;
    gap: 8px;
    min-width: 0;
    overflow: hidden;
  }

  .hw-crumb-title {
    color: var(--hw-foreground);
    font-weight: 500;
  }

  .hw-tb-right {
    margin-left: auto;
    display: inline-flex;
    gap: 6px;
    font-family: var(--hw-mono);
    font-size: 13px;
  }

  /* Rail */
  .hw-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding-top: 18px;
    background-color: var(--hw-rail);
    color: var(--hw-muted-foreground);
  }

  .hw-rail > :global(svg),
  .hw-rail span :global(svg) {
    width: 19px;
    height: 19px;
  }

  .hw-rail-on {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 32px;
    margin: -6px 0;
    border-radius: 8px;
    background: var(--hw-sidebar-accent);
    color: var(--hw-foreground);
  }

  .hw-rail-on b {
    position: absolute;
    top: 3px;
    right: 4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hw-warning-foreground);
    box-shadow: 0 0 0 2px var(--hw-sidebar-accent);
  }

  .hw-rail-end {
    margin-top: auto;
    padding-bottom: 18px;
  }

  /* Thread list */
  .hw-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 10px;
    overflow: hidden;
    background-color: var(--hw-sidebar);
    color: var(--hw-sidebar-foreground);
    border-right: 1px solid var(--hw-sidebar-border);
  }

  .hw-search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    margin-bottom: 10px;
    padding: 0 10px;
    border-radius: 9px;
    background: var(--hw-sidebar-accent);
    color: var(--hw-muted-foreground);
  }

  .hw-search kbd {
    margin-left: auto;
    font-family: var(--hw-mono);
    font-size: 13px;
  }

  .hw-row {
    padding: 6px 10px 7px;
    border-radius: 9px;
  }

  .hw-row.is-on {
    background: var(--hw-sidebar-accent);
    color: var(--hw-sidebar-accent-foreground);
  }

  .hw-row-meta,
  .hw-row-title {
    display: flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }

  .hw-row-meta {
    color: var(--hw-muted-foreground);
    font-size: 13px;
  }

  .hw-row-project {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hw-row-when {
    font-family: var(--hw-mono);
    font-size: 13px;
  }

  .hw-working {
    color: var(--hw-primary-readable);
  }

  .hw-waiting {
    color: var(--hw-warning-foreground);
  }

  .hw-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
  }

  .hw-dot-working {
    background: var(--hw-primary-readable);
  }

  .hw-dot-waiting {
    background: var(--hw-warning-foreground);
  }

  .hw-dot-done {
    background: var(--hw-success-foreground);
  }

  .hw-row-title {
    font-weight: 500;
  }

  .hw-row-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hw-row-diff,
  .hw-row-pr {
