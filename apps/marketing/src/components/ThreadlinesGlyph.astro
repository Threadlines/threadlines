---
/** The Threadlines mark: a main line with one branch ending in the accent node. Decorative; size it with `class` (height, width auto). */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
// A per-render id keeps two marks on one page from sharing a gradient.
const gradientId = `threadlines-glyph-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class={className} viewBox="36 86 184 100" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={gradientId} gradientUnits="userSpaceOnUse" x1="108" y1="98" x2="194" y2="162">
      <stop offset="0" stop-color="#a1a1aa" stop-opacity="0.45"></stop>
      <stop offset="1" stop-color="var(--accent-bright)"></stop>
    </linearGradient>
  </defs>
  <g stroke-linecap="round" stroke-width="10">
    <path d="M 44 98 L 212 98" stroke="var(--line-strong)"></path>
    <path d="M 108 98 C 134 98 134 162 160 162 L 188 162" stroke={`url(#${gradientId})`}></path>
  </g>
  <g fill="var(--node-strong)">
    <circle cx="70" cy="98" r="7"></circle>
    <circle cx="108" cy="98" r="8.5"></circle>
    <circle cx="178" cy="98" r="7"></circle>
  </g>
  <circle cx="194" cy="162" r="21" fill="var(--accent-bright)" opacity="0.16"></circle>
  <circle cx="194" cy="162" r="12.5" fill="var(--accent-bright)"></circle>
</svg>
