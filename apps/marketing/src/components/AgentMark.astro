---
import type { AgentSlug } from "../lib/agents";

/** An agent's logo, sized by the parent (width/height 100%). Always decorative: the name sits beside it, or the link carries an aria-label. */
interface Props {
  slug: AgentSlug;
}

const { slug } = Astro.props;
// Muse's mark is a gradient stroke; a per-render id keeps two marks on one page from sharing a gradient.
const museGradientId = `agent-muse-${Math.random().toString(36).slice(2, 8)}`;
