---
/**
 * A page of plain reading: the privacy policy, terms, support and docs. The
 * directories that list Threadlines link to these, so they stay on their own
 * addresses and say when they last changed. A quiet kit frame: no line, the
 * kit's type, and its prose styles for the plain headings, lists, links and
 * code the page passes in (styles/kit.css, .k-prose).
 */
import KitFrame from "../components/kit/KitFrame.astro";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  heading: string;
  description: string;
  canonicalPath: string;
  /** "November 2, 2026": when the words last changed, for pages people rely on. */
  updated?: string;
}

const { title, heading, description, canonicalPath, updated } = Astro.props;
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <KitFrame line="quiet" as="section">
    <header class="k-head">
      <h1 class="k-h1 k-rise">{heading}</h1>
      {updated ? <p class="k-small updated k-rise" style="--d: 60ms">Last updated {updated}</p> : null}
    </header>
    <div class="k-prose prose">
      <slot />
    </div>
  </KitFrame>
</Layout>

<style>
  .updated {
    margin-top: 14px;
  }

  .prose {
    margin-top: clamp(40px, 5vw, 56px);
  }
</style>
