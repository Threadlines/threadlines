---
/**
 * A page of plain reading: the privacy policy, terms, support and docs. The
 * directories that list Threadlines link to these, so they stay on their own
 * addresses and say when they last changed.
 */
import Layout from "./Layout.astro";

interface Props {
  title: string;
  heading: string;
  description: string;
  canonicalPath: string;
  /** "November 2, 2026": when the words last changed, for pages people rely on. */
  updated?: string;
}

const { title, heading, description, canonicalPath, updated } = Astro.props;
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <section class="prose-page">
    <div class="container prose-wrap">
      <header class="prose-header">
        <h1 class="display">{heading}</h1>
        {updated ? <p class="prose-updated">Last updated {updated}</p> : null}
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</Layout>

<style>
  .prose-page {
    padding: 72px 0 96px;
  }

  .prose-wrap {
    max-width: 680px;
  }

  .prose-header {
    margin-bottom: 32px;
  }

  .prose-header h1 {
    font-size: clamp(30px, 5vw, 40px);
  }

  .prose-updated {
    margin-top: 10px;
    color: var(--fg-muted);
    font-size: 14px;
  }

  .prose :global(h2) {
    margin: 36px 0 10px;
    font-size: 20px;
    line-height: 1.3;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .prose :global(p) {
    margin: 0 0 14px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 14px;
    padding-left: 22px;
  }

  .prose :global(li) {
    margin-bottom: 6px;
  }

  .prose :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--fg);
  }

  .prose :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  .prose :global(code) {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.92em;
    overflow-wrap: anywhere;
  }
</style>
