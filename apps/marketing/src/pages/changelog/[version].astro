---
import type { CollectionEntry } from "astro:content";
import { getPublishedChangelog } from "../../lib/publishedChangelog";

import Icon from "../../components/Icon.astro";
import KitFrame from "../../components/kit/KitFrame.astro";
import KitHeading from "../../components/kit/KitHeading.astro";
import KitTimeline from "../../components/kit/KitTimeline.astro";
import Layout from "../../layouts/Layout.astro";
import { formatReleaseDate, sortChangelogEntries } from "../../lib/changelog";
import { absoluteSiteUrl } from "../../lib/site";

export async function getStaticPaths() {
  const entries = await getPublishedChangelog();
  return entries.map((entry) => ({ params: { version: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"changelog">;
}

const { entry } = Astro.props;
// The newer and older releases, from the same published, sorted list that makes the pages.
const published = sortChangelogEntries(await getPublishedChangelog());
const at = published.findIndex((other) => other.id === entry.id);
const neighbours = [published[at - 1], published[at + 1]].filter((other) => other !== undefined);
const { version, date, title, summary, githubRelease, highlights, alsoImproved, video } =
  entry.data;
const canonicalPath = `/changelog/${entry.id}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `Threadlines v${version}: ${title}`,
  description: summary,
  datePublished: date.toISOString(),
  mainEntityOfPage: absoluteSiteUrl(canonicalPath),
  author: { "@type": "Organization", name: "Threadlines" },
};
---

<Layout
  title={`Threadlines v${version}: ${title}`}
  description={summary}
  canonicalPath={canonicalPath}
  structuredData={[structuredData]}
>
  <KitFrame line="ink" region={false}>
    <div data-k-region="ink">
      <header class="k-head">
        <a class="k-back k-rise" href="/changelog"><span aria-hidden="true">←</span> All releases</a>
        <div class="k-meta release-meta k-rise" style="--d: 40ms">
          <span>v{version}</span>
          <time datetime={date.toISOString()}>{formatReleaseDate(date)}</time>
        </div>
        <h1 class="k-h1 k-rise" style="--d: 60ms" data-k-node data-k-start>{title}</h1>
        <p class="k-lede k-rise" style="--d: 120ms">{summary}</p>
      </header>

      {
        video && (
          <figure class="k-shot k-rise" style="--d: 180ms">
            <div class="k-still">
              <video
                controls
                muted
                playsinline
                preload="metadata"
                poster={video.poster}
                width="1920"
                height="1080"
              >
                <source src={video.src} type="video/mp4" />
              </video>
            </div>
            <figcaption class="k-cap">{video.caption}</figcaption>
          </figure>
        )
      }

      <div class="highlights">
        {
          highlights.map((highlight) => (
            <section class="highlight">
              <KitHeading>{highlight.title}</KitHeading>
              <p>{highlight.description}</p>
            </section>
          ))
        }
      </div>

      {
        alsoImproved.length > 0 && (
          <section class="also" data-k-node="small">
            <p class="also-title">Also improved</p>
            <ul>
              {alsoImproved.map((improvement) => (
                <li>{improvement.description}</li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="k-actions release-actions">
        <a class="btn" href="/download"><Icon name="download" /> Download Threadlines</a>
        <a class="k-link" href={githubRelease} target="_blank" rel="noopener noreferrer">
          Complete technical notes on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    {
      neighbours.length > 0 && (
        <KitTimeline entries={neighbours} title="p" fillFirst={false} />
      )
    }
  </KitFrame>
</Layout>

<style>
  .release-meta {
    margin-top: 28px;
  }

  .release-meta + :global(.k-h1) {
    margin-top: 12px;
  }

  .highlights {
    margin-top: clamp(56px, 7vw, 88px);
  }

  .highlight + .highlight {
    margin-top: clamp(40px, 5vw, 56px);
  }

  .highlight > p {
    max-width: 64ch;
    margin-top: 12px;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  /* Its words stay, in ordinary type: the one label on the page. */
  .also {
    margin-top: clamp(48px, 6vw, 64px);
    max-width: 64ch;
  }

  .also-title {
    font-weight: 600;
  }

  .also ul {
    margin-top: 12px;
    padding-left: 20px;
    color: var(--fg-muted);
  }

  .also li + li {
    margin-top: 6px;
  }

  .also li::marker {
    color: var(--fg-faint);
  }

  .release-actions {
    margin-top: clamp(48px, 6vw, 64px);
  }
</style>
