---
import { getPublishedChangelog } from "../../lib/publishedChangelog";

import KitFrame from "../../components/kit/KitFrame.astro";
import KitTimeline from "../../components/kit/KitTimeline.astro";
import Layout from "../../layouts/Layout.astro";
import { agentJoins, AGENTS } from "../../lib/agents";
import { sortChangelogEntries } from "../../lib/changelog";

const entries = sortChangelogEntries(await getPublishedChangelog());
// Each agent's thread taps into the trunk at the release that added it; only published releases count.
const { joins, roots } = agentJoins(
  AGENTS,
  entries.map((entry) => entry.data.version),
);
---

<Layout
  title="Threadlines changelog"
  description="Stable Threadlines release highlights, improvements, and technical release links."
  canonicalPath="/changelog"
>
  <KitFrame line="ink" region={false} as="section">
    <header class="k-head" data-k-region="ink">
      <h1 class="k-h1 k-rise" data-k-node data-k-start>Changelog</h1>
      <p class="k-lede k-rise" style="--d: 80ms">
        The meaningful changes in each stable Threadlines release. Nightly builds stay on GitHub;
        this page is the concise, human-reviewed record.
      </p>
    </header>
    <KitTimeline entries={entries} joins={joins} roots={roots} />
  </KitFrame>
</Layout>
