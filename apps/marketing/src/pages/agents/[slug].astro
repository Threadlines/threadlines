---
import { getCollection } from "astro:content";

import AgentMark from "../../components/AgentMark.astro";
import Faq from "../../components/Faq.astro";
import Icon from "../../components/Icon.astro";
import Layout from "../../layouts/Layout.astro";
import { agentPath, AGENTS, isInStableRelease, type Agent } from "../../lib/agents";
import { latestStableVersion } from "../../lib/changelog";
import type { IconName } from "../../lib/icons";
import {
  absoluteSiteUrl,
  APPLICATION_ID,
  ORGANIZATION_ID,
  SITE_GITHUB_URL,
} from "../../lib/site";

export function getStaticPaths() {
  return AGENTS.map((agent) => ({ params: { slug: agent.slug }, props: { agent } }));
}

interface Props {
  agent: Agent;
}

const { agent } = Astro.props;
const canonicalPath = agentPath(agent);
const stableVersion = latestStableVersion(await getCollection("changelog"));
const inStable = isInStableRelease(agent, stableVersion);
// Features newer than the stable app stay off the page until that release ships.
const features = agent.features.filter((feature) => isInStableRelease(feature, stableVersion));
const others = AGENTS.filter((other) => other.slug !== agent.slug);

/** What every thread has, whichever agent runs it. */
const everyThread: { icon: IconName; title: string; description: string }[] = [
  {
    icon: "message",
    title: "Two agents, one thread",
    description: "Add a second agent to check the first.",
  },
  {
    icon: "pullRequest",
    title: "Pull requests and CI",
    description: "Review them beside the chat.",
  },
  {
    icon: "globe",
    title: "Built-in browser",
    description: "Preview your site and attach a screenshot.",
  },
  {
    icon: "branch",
    title: "A worktree per thread",
    description: "Keep each agent's changes apart.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: agent.title,
    description: agent.description,
    url: absoluteSiteUrl(canonicalPath),
    about: { "@id": APPLICATION_ID, "@type": "SoftwareApplication", name: "Threadlines" },
    mentions: {
      "@type": "SoftwareApplication",
      name: agent.name,
      creator: { "@type": "Organization", name: agent.maker },
    },
    publisher: { "@id": ORGANIZATION_ID },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Agents", item: absoluteSiteUrl("/agents") },
      { "@type": "ListItem", position: 2, name: agent.name, item: absoluteSiteUrl(canonicalPath) },
    ],
  },
];
---

<Layout
  title={agent.title}
  description={agent.description}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
>
  <article class="agent">
    <div class="container agent-wrap">
      <a class="back-link" href="/agents"><span aria-hidden="true">←</span> All agents</a>

      <header class="agent-header">
        <span class="agent-hero-mark"><AgentMark slug={agent.slug} /></span>
        <p class="eyebrow">{agent.name} in Threadlines</p>
        <h1 class="display">{agent.headline}</h1>
        <p class="agent-intro">{agent.intro}</p>
        {
          !inStable && (
            <p class="agent-note">
              In the{" "}
              <a href={`${SITE_GITHUB_URL}/releases`} target="_blank" rel="noopener noreferrer">
                nightly build
              </a>{" "}
              now, and in the stable app from version {agent.since}.
            </p>
          )
        }
        <div class="agent-actions">
          {
            inStable ? (
              <a class="primary-action" href="/download">
                <Icon name="download" /> Download Threadlines
              </a>
            ) : (
              <a
                class="primary-action"
                href={`${SITE_GITHUB_URL}/releases`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="download" /> Download the nightly build
              </a>
            )
          }
          <a href={SITE_GITHUB_URL} target="_blank" rel="noopener noreferrer">
            View the source on GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      <figure class="agent-shot">
        <img
          src="/Screenshots/rooms/rooms.webp"
          alt="A Threadlines thread where two agents from different companies work on the same bug"
          width="1600"
          height="934"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>Threadlines with two agents working on one bug.</figcaption>
      </figure>

      <section class="agent-section">
        <h2>What works with {agent.name}</h2>
        <ul class="icon-grid">
          {
            features.map((feature) => (
              <li>
                <Icon name={feature.icon} class="icon-grid-icon" />
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="agent-section">
        <h2>Set up in four steps</h2>
        <ol class="agent-steps">
          {
            agent.setup.map((step, index) => (
              <li>
                <span class="agent-step-number">{String(index + 1).padStart(2, "0")}</span>
                <Icon name={step.icon} class="agent-step-icon" />
                <span>{step.text}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="agent-section">
        <h2>In every thread</h2>
        <ul class="icon-grid icon-grid-four">
          {
            everyThread.map((item) => (
              <li>
                <Icon name={item.icon} class="icon-grid-icon" />
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="agent-section">
        <h2>Questions</h2>
        <Faq items={agent.faq} />
      </section>

      <section class="agent-section">
        <h2>Other agents</h2>
        <ul class="agent-others">
          {
            others.map((other) => (
              <li>
                <a
                  href={agentPath(other)}
                  aria-label={other.markIsWordmark ? other.name : undefined}
                >
                  <span class="agent-mark">
                    <AgentMark slug={other.slug} />
                  </span>
                  {!other.markIsWordmark && other.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="agent-disclaimer">
        {agent.name} is made by {agent.maker}. Threadlines is an independent open-source project and
        isn't affiliated with or endorsed by {agent.maker}.
      </p>
    </div>
  </article>
</Layout>

<style>
  .agent {
    padding: 40px 0 96px;
  }

  .agent-wrap {
    max-width: 960px;
  }

  .back-link {
    display: inline-flex;
    gap: 8px;
    color: var(--fg-dim);
    font-size: 14px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--fg);
  }

  .agent-header {
    padding: 28px 0;
  }

  .agent-hero-mark {
    display: inline-flex;
    width: 44px;
    height: 44px;
    margin-bottom: 16px;
    color: var(--fg);
  }

  .agent-hero-mark :global(svg),
  .agent-hero-mark :global(img),
  .agent-mark :global(svg),
  .agent-mark :global(img) {
    width: 100%;
    height: 100%;
  }

  .agent-header h1 {
    max-width: 780px;
    margin: 8px 0 10px;
    font-size: clamp(28px, 4.5vw, 40px);
    text-wrap: balance;
  }

  .agent-intro {
    max-width: 620px;
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .agent-note {
    margin-top: 10px;
    color: var(--fg-dim);
    font-size: 14px;
  }

  .agent-note a {
    text-decoration: underline;
    text-decoration-color: var(--underline);
    text-underline-offset: 3px;
  }

  .agent-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 22px;
  }

  .agent-actions a {
    color: var(--fg-muted);
    font-size: 14px;
    transition: color 0.2s ease;
  }

  .agent-actions a:hover {
    color: var(--fg);
  }

  .agent-actions .primary-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--accent-bright);
    color: var(--accent-contrast);
    font-weight: 600;
  }

  .agent-actions .primary-action:hover {
    color: var(--accent-contrast);
  }

  .agent-shot {
    margin: 0 0 12px;
  }

  .agent-shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
  }

  .agent-shot figcaption {
    margin-top: 8px;
    color: var(--fg-dim);
    font-size: 13px;
  }

  .agent-section {
    padding: 26px 0 28px;
    border-top: 1px solid var(--border);
  }

  .agent-section h2 {
    margin-bottom: 18px;
    font-size: 19px;
    letter-spacing: -0.015em;
  }

  .icon-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px 28px;
    list-style: none;
  }

  .icon-grid-four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .icon-grid :global(.icon-grid-icon) {
    margin-bottom: 10px;
    color: var(--accent-bright);
    font-size: 22px;
  }

  .icon-grid h3 {
    margin-bottom: 2px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .icon-grid p {
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .agent-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
  }

  .agent-steps li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 14px 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--fg);
    font-size: 14px;
    line-height: 1.45;
  }

  .agent-step-number {
    color: var(--accent-bright);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .agent-steps :global(.agent-step-icon) {
    color: var(--fg-muted);
    font-size: 20px;
  }

  .agent-others {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    list-style: none;
  }

  .agent-others a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-muted);
    font-size: 14px;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .agent-others a:hover {
    color: var(--fg);
  }

  .agent-mark {
    display: inline-flex;
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--fg);
  }

  .agent-disclaimer {
    padding-top: 22px;
    border-top: 1px solid var(--border);
    color: var(--fg-dim);
    font-size: 13px;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .icon-grid,
    .icon-grid-four,
    .agent-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .agent {
      padding: 32px 0 80px;
    }

    .icon-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    .icon-grid-four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
