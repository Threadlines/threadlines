---
import { getPublishedChangelog } from "../../lib/publishedChangelog";

import AgentChip from "../../components/kit/AgentChip.astro";
import Faq from "../../components/Faq.astro";
import Icon from "../../components/Icon.astro";
import KitEnd from "../../components/kit/KitEnd.astro";
import KitFrame from "../../components/kit/KitFrame.astro";
import KitHeading from "../../components/kit/KitHeading.astro";
import KitRules from "../../components/kit/KitRules.astro";
import KitSteps from "../../components/kit/KitSteps.astro";
import Layout from "../../layouts/Layout.astro";
import {
  agentPath,
  AGENTS,
  agentThreadIndex,
  isInStableRelease,
  type Agent,
} from "../../lib/agents";
import { latestStableVersion } from "../../lib/changelog";
import type { IconName } from "../../lib/icons";
import {
  absoluteSiteUrl,
  APPLICATION_ID,
  ORGANIZATION_ID,
  SITE_GITHUB_URL,
} from "../../lib/site";

export function getStaticPaths() {
  return AGENTS.map((agent) => ({ params: { slug: agent.slug }, props: { agent } }));
}

interface Props {
  agent: Agent;
}

const { agent } = Astro.props;
const canonicalPath = agentPath(agent);
const stableVersion = latestStableVersion(await getPublishedChangelog());
const inStable = isInStableRelease(agent, stableVersion);
// Features newer than the stable app stay off the page until that release ships.
const features = agent.features.filter((feature) => isInStableRelease(feature, stableVersion));
const others = AGENTS.filter((other) => other.slug !== agent.slug);
// The top button and the one the line runs into at the end go to the same place.
const download = inStable
  ? { href: "/download", label: "Download Threadlines", external: false }
  : { href: `${SITE_GITHUB_URL}/releases`, label: "Download the nightly build", external: true };

/** What every thread has, whichever agent runs it. */
const everyThread: { icon: IconName; title: string; description: string }[] = [
  {
    icon: "message",
    title: "Two agents, one thread",
    description: "Add a second agent to check the first.",
  },
  {
    icon: "pullRequest",
    title: "Pull requests and CI",
    description: "Review them beside the chat.",
  },
  {
    icon: "globe",
    title: "Built-in browser",
    description: "Preview your site and attach a screenshot.",
  },
  {
    icon: "branch",
    title: "A worktree per thread",
    description: "Keep each agent's changes apart.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: agent.title,
    description: agent.description,
    url: absoluteSiteUrl(canonicalPath),
    about: { "@id": APPLICATION_ID, "@type": "SoftwareApplication", name: "Threadlines" },
    mentions: {
      "@type": "SoftwareApplication",
      name: agent.name,
      creator: { "@type": "Organization", name: agent.maker },
    },
    publisher: { "@id": ORGANIZATION_ID },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Agents", item: absoluteSiteUrl("/agents") },
      { "@type": "ListItem", position: 2, name: agent.name, item: absoluteSiteUrl(canonicalPath) },
    ],
  },
];
---

<Layout
  title={agent.title}
  description={agent.description}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
>
  <KitFrame line={agentThreadIndex(agent)}>
    <header class="k-head">
      <a class="k-back k-rise" href="/agents"><span aria-hidden="true">←</span> All agents</a>
      <AgentChip agent={agent} lead class="k-rise" />
      <h1 class="k-h1 k-rise" style="--d: 60ms">{agent.headline}</h1>
      <p class="k-lede k-rise" style="--d: 120ms">{agent.intro}</p>
      {
        !inStable && (
          <p class="k-note k-rise" style="--d: 150ms">
            In the{" "}
            <a href={`${SITE_GITHUB_URL}/releases`} target="_blank" rel="noopener noreferrer">
              nightly build
            </a>{" "}
            now, and in the stable app from version {agent.since}.
          </p>
        )
      }
      <div class="k-actions k-rise" style="--d: 180ms">
        <a
          class="btn"
          href={download.href}
          target={download.external ? "_blank" : undefined}
          rel={download.external ? "noopener noreferrer" : undefined}
        >
          <Icon name="download" /> {download.label}
        </a>
        <a class="k-link" href={SITE_GITHUB_URL} target="_blank" rel="noopener noreferrer">
          View the source on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <figure class="k-shot k-rise" style="--d: 240ms">
      <div class="k-still">
        <img
          src={`/Screenshots/app/${agent.screenshot.file}.webp`}
          alt={agent.screenshot.alt}
          width="2400"
          height="1401"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="k-cap">{agent.screenshot.caption}</figcaption>
    </figure>

    <section class="k-sec">
      <KitHeading>What works with {agent.name}</KitHeading>
      <KitRules items={features} />
    </section>

    <section class="k-sec">
      <KitHeading>Set up in four steps</KitHeading>
      <KitSteps steps={agent.setup.map((step) => step.text)} />
    </section>

    <section class="k-sec">
      <KitHeading>In every thread</KitHeading>
      <KitRules items={everyThread} />
    </section>

    <section class="k-sec">
      <KitHeading>Questions</KitHeading>
      <Faq items={agent.faq} />
    </section>

    <section class="k-sec">
      <KitHeading>Other agents</KitHeading>
      <ul class="k-others">
        {
          others.map((other) => (
            <li style={`--c: var(--t${agentThreadIndex(other)})`}>
              <a href={agentPath(other)} aria-label={other.markIsWordmark ? other.name : undefined}>
                <AgentChip agent={other} small />
                {!other.markIsWordmark && other.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <KitEnd slot="end" href={download.href} label={download.label} external={download.external}>
      {agent.name} is made by {agent.maker}. Threadlines is an independent open-source project and
      isn't affiliated with or endorsed by {agent.maker}.
    </KitEnd>
  </KitFrame>
</Layout>
