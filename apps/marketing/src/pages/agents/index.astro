---
import { getPublishedChangelog } from "../../lib/publishedChangelog";

import AgentChip from "../../components/kit/AgentChip.astro";
import KitFrame from "../../components/kit/KitFrame.astro";
import Layout from "../../layouts/Layout.astro";
import { agentPath, AGENTS, isInStableRelease } from "../../lib/agents";
import { latestStableVersion } from "../../lib/changelog";
import { comparisonPath, COMPARISONS } from "../../lib/comparisons";
import { absoluteSiteUrl, ORGANIZATION_ID } from "../../lib/site";

const title = "Coding agents that run in Threadlines";
const stableVersion = latestStableVersion(await getPublishedChangelog());
const agentNames = new Intl.ListFormat("en", { type: "conjunction" }).format(
  AGENTS.map((agent) => agent.name),
);
const description = `Threadlines runs ${agentNames} in one free, open-source desktop app.`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: absoluteSiteUrl("/agents"),
    publisher: { "@id": ORGANIZATION_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: AGENTS.map((agent, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: agent.name,
        url: absoluteSiteUrl(agentPath(agent)),
      })),
    },
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/agents"
  structuredData={structuredData}
>
  <KitFrame line="ink" as="section">
    <header class="k-head">
      <h1 class="k-h1 k-rise" data-k-node data-k-start>The agents you already use</h1>
      <p class="k-lede k-rise" style="--d: 80ms">
        Threadlines doesn't ship a model of its own. It runs the agents you already have, with your
        own accounts, and two of them can share a thread.
      </p>
    </header>

    <!-- Each agent's strand taps into the trunk below its logo. -->
    <ul class="agents">
      {
        AGENTS.map((agent) => (
          <li data-k-taps="down">
            <a class="agent" href={agentPath(agent)}>
              <AgentChip agent={agent} tap class="agent-chip" />
              {!isInStableRelease(agent, stableVersion) && <span class="agent-tag">Nightly</span>}
              <span class="agent-name">{agent.name}</span>
              <span class="agent-maker">{agent.maker}</span>
              <span class="agent-summary">{agent.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="k-small agents-compare">
      Choosing between apps? See how Threadlines compares with{" "}
      {
        COMPARISONS.map((comparison, index) => (
          <>
            {index > 0 && " and "}
            <a href={comparisonPath(comparison)}>{comparison.name}</a>
          </>
        ))
      }
      .
    </p>
  </KitFrame>
</Layout>

<style>
  .agents {
    list-style: none;
    max-width: 820px;
    margin-top: clamp(56px, 7vw, 88px);
  }

  .agents li + li {
    margin-top: 6px;
  }

  /* The logo, then the name with its maker and one line; the strand falls from under the logo. */
  .agent {
    display: grid;
    grid-template-columns: var(--k-chip) auto minmax(0, 1fr);
    grid-template-areas:
      "chip name tag"
      "chip maker maker"
      "chip summary summary";
    column-gap: 20px;
    align-items: baseline;
    padding: 14px 0 34px;
  }

  .agent :global(.agent-chip) {
    grid-area: chip;
    align-self: start;
  }

  .agent-name {
    grid-area: name;
    font-weight: 600;
    font-size: 1.1875rem;
    letter-spacing: -0.015em;
    transition: color 160ms var(--ease);
  }

  .agent:hover .agent-name {
    color: var(--accent);
  }

  .agent-tag {
    grid-area: tag;
    justify-self: start;
    margin-left: 10px;
    padding: 0 8px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--border-strong);
    color: var(--fg-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .agent-maker {
    grid-area: maker;
    font-size: var(--k-s);
    color: var(--fg-muted);
  }

  .agent-summary {
    grid-area: summary;
    margin-top: 6px;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .agents-compare {
    margin-top: clamp(40px, 5vw, 56px);
  }

  @media (width <= 640px) {
    .agent {
      column-gap: 14px;
    }
  }
</style>
