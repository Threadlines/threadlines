---
import { getCollection } from "astro:content";

import AgentMark from "../../components/AgentMark.astro";
import Layout from "../../layouts/Layout.astro";
import { agentPath, AGENTS, isInStableRelease } from "../../lib/agents";
import { latestStableVersion } from "../../lib/changelog";
import { comparisonPath, COMPARISONS } from "../../lib/comparisons";
import { absoluteSiteUrl, ORGANIZATION_ID } from "../../lib/site";

const title = "Coding agents that run in Threadlines";
const stableVersion = latestStableVersion(await getCollection("changelog"));
const agentNames = new Intl.ListFormat("en", { type: "conjunction" }).format(
  AGENTS.map((agent) => agent.name),
);
const description = `Threadlines runs ${agentNames} in one free, open-source desktop app.`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: absoluteSiteUrl("/agents"),
    publisher: { "@id": ORGANIZATION_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: AGENTS.map((agent, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: agent.name,
        url: absoluteSiteUrl(agentPath(agent)),
      })),
    },
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/agents"
  structuredData={structuredData}
>
  <section class="agents-index">
    <div class="container agents-wrap">
      <header class="agents-header">
        <p class="eyebrow">Agents</p>
        <h1 class="display">The agents you already use</h1>
        <p>
          Threadlines doesn't ship a model of its own. It runs the agents you already have, with your
          own accounts, and two of them can share a thread.
        </p>
      </header>

      <ul class="agent-grid">
        {
          AGENTS.map((agent) => (
            <li>
              <a class="tile agent-tile" href={agentPath(agent)}>
                <span class="agent-tile-top">
                  <span class="agent-mark">
                    <AgentMark slug={agent.slug} />
                  </span>
                  {!isInStableRelease(agent, stableVersion) && (
                    <span class="agent-tile-tag">Nightly</span>
                  )}
                </span>
                <span class="agent-tile-name">{agent.name}</span>
                <span class="agent-tile-maker">{agent.maker}</span>
                <span class="agent-tile-summary">{agent.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="agents-compare">
        Choosing between apps? See how Threadlines compares with{" "}
        {
          COMPARISONS.map((comparison, index) => (
            <>
              {index > 0 && " and "}
              <a href={comparisonPath(comparison)}>{comparison.name}</a>
            </>
          ))
        }
        .
      </p>
    </div>
  </section>
</Layout>

<style>
  .agents-index {
    padding: 72px 0 96px;
  }

  .agents-wrap {
    max-width: 960px;
  }

  .agents-header {
    max-width: 680px;
    margin-bottom: 32px;
  }

  .agents-header h1 {
    margin: 12px 0 14px;
    font-size: clamp(30px, 5vw, 40px);
  }

  .agents-header > p:last-child {
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .agent-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
  }

  .agent-tile {
    display: grid;
    align-content: start;
    gap: 2px;
  }

  .agent-tile-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .agent-mark {
    display: inline-flex;
    width: 30px;
    height: 30px;
    color: var(--fg);
  }

  .agent-mark :global(svg),
  .agent-mark :global(img) {
    width: 100%;
    height: 100%;
  }

  .agent-tile-tag {
    padding: 1px 7px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .agent-tile-name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .agent-tile-maker {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .agent-tile-summary {
    margin-top: 8px;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .agents-compare {
    margin-top: 22px;
    color: var(--fg-dim);
    font-size: 14px;
  }

  .agents-compare a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--underline);
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .agents-compare a:hover {
    color: var(--fg);
  }



  @media (max-width: 820px) {
    .agent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .agents-index {
      padding: 56px 0 80px;
    }
  }

  @media (max-width: 460px) {
    .agent-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
