---
import { getCollection } from "astro:content";

import AgentMark from "../components/AgentMark.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { agentPath, AGENTS, isInStableRelease } from "../lib/agents";
import {
  changelogEntryPath,
  formatReleaseDate,
  latestStableVersion,
  sortChangelogEntries,
} from "../lib/changelog";
import type { IconName } from "../lib/icons";
import {
  absoluteSiteUrl,
  APPLICATION_ID,
  DEFAULT_SITE_DESCRIPTION,
  ORGANIZATION_ID,
  SITE_GITHUB_URL,
  SITE_NAME,
  SITE_X_URL,
} from "../lib/site";

const changelog = await getCollection("changelog");

// The hero names three agents and counts the rest of the logo row, in words.
const NUMBER_WORDS = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"];
const otherCount = AGENTS.length - 3;
const otherAgents = `${NUMBER_WORDS[otherCount] ?? otherCount} ${otherCount === 1 ? "other" : "others"}`;
const stableVersion = latestStableVersion(changelog);
const latestRelease = sortChangelogEntries(changelog)[0]!;

const appStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": APPLICATION_ID,
  name: SITE_NAME,
  alternateName: "Threadlines ADE",
  operatingSystem: "macOS 13 or later, Windows, Linux",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "Agentic development environment",
  softwareVersion: stableVersion,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: DEFAULT_SITE_DESCRIPTION,
  url: absoluteSiteUrl("/"),
  downloadUrl: absoluteSiteUrl("/download"),
  screenshot: absoluteSiteUrl("/Screenshots/rooms/rooms.webp"),
  featureList: [
    ...AGENTS.filter((agent) => isInStableRelease(agent, stableVersion)).map(
      (agent) => `Runs ${agent.name}`,
    ),
    "Several agents in one thread",
    "Agents start threads on your other computers",
    "Scheduled and event tasks",
    "Pull requests and CI checks beside the chat",
    "Built-in browser",
    "Source control and Git history",
    "Git worktrees per thread",
  ],
  license: "https://opensource.org/license/mit/",
  isAccessibleForFree: true,
  publisher: { "@id": ORGANIZATION_ID },
  sameAs: [SITE_GITHUB_URL, SITE_X_URL],
};

/** A recorded demo: `<base>.mp4` and `<base>.webp` for wide screens, `<base>-tall.*` for phones. */
interface Demo {
  base: string;
  seconds: number;
  label: string;
}

/** 46 -> "0:46" */
const clock = (seconds: number) => `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;

const demos = {
  rooms: {
    base: "/Screenshots/rooms/rooms",
    seconds: 46,
    label:
      "A Threadlines room. Opus 5.5 can't find why some customers are charged twice, so the user adds GPT-6.1-Sol. Sol finds the cause, Opus fixes it, and Sol checks the fix.",
  },
  threads: {
    base: "/Screenshots/threads/threads",
    seconds: 44,
    label:
      "Opus 5.5 asks to start three threads to find out why checkout got slow: Sonnet 5.5 times the payment service, GPT-6.1-Sol counts the database queries, and Opus 5.5 measures the page. The answers come back to Opus, and it fixes the cause.",
  },
  fleet: {
    base: "/Screenshots/fleet/fleet",
    seconds: 45,
    label:
      "Opus 5.5 on a MacBook Pro can't test a Windows-only screenshot bug, so it asks to start a thread on the Windows PC. GPT-6.1-Sol runs a probe there, Fleet shows both computers at work, and the answer comes back and changes Opus's plan.",
  },
} satisfies Record<string, Demo>;

const ideas: { name: string; icon: IconName; text: string; demo: Demo }[] = [
  {
    name: "Rooms",
    icon: "agents",
    text: "Add a second model to the thread. It catches up on the conversation, and the two can ask each other questions.",
    demo: demos.rooms,
  },
  {
    name: "Threads",
    icon: "branch",
    text: "An agent can hand part of the job to a new thread, on the model it picks, and keep working until the answer arrives.",
    demo: demos.threads,
  },
  {
    name: "Fleet",
    icon: "computers",
    text: "Link your Mac, Windows PC or Linux box. An agent on one can start a thread on another, and Fleet shows what each is running.",
    demo: demos.fleet,
  },
];

const tools: { name: string; icon: IconName; text: string }[] = [
  {
    name: "Pull requests and CI",
    icon: "pullRequest",
    text: "Open the pull request beside its thread. Checks show above the message box, and you can merge once they pass.",
  },
  {
    name: "Built-in browser",
    icon: "globe",
    text: "Run your site in a panel next to the chat, so you and the agent look at the same page.",
  },
  {
    name: "Git changes and history",
    icon: "fork",
    text: "See what each turn changed, stage and commit it, and read the history without leaving the thread.",
  },
  {
    name: "Files and context",
    icon: "code",
    text: "Select lines in a file, the terminal or a reply, and attach them to your next message.",
  },
  {
    name: "Scheduled and event tasks",
    icon: "clock",
    text: "Run a prompt every weekday at 9, or whenever an issue on GitHub gets a label.",
  },
  {
    name: "Switch agents mid-thread",
    icon: "refresh",
    text: "Move a thread from Claude to Codex and keep the conversation and your changes.",
  },
];

const playIcon = `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4.5 2.8v10.4L13 8z"/></svg>`;
const pauseIcon = `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z"/></svg>`;
const appleIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>`;
const windowsIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h8.5v8.5H3zM12.5 3H21v8.5h-8.5zM3 12.5h8.5V21H3zM12.5 12.5H21V21h-8.5z"/></svg>`;
const linuxIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm2.94 4.3 4 3.06a.9.9 0 0 1 0 1.43l-4 3.06a.9.9 0 1 1-1.1-1.43L9 11.07 5.84 8.73A.9.9 0 1 1 6.94 7.3ZM12.5 14.4h4.7a.9.9 0 1 1 0 1.8h-4.7a.9.9 0 1 1 0-1.8Z"/></svg>`;
const githubIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>`;
---

<Layout
  title="Threadlines ADE: desktop app for Claude Code, Codex and more"
  description="A free, open-source ADE for Claude Code, Codex, OpenCode, Cursor and more. Put several agents in one thread, with pull requests, a browser and Git in view."
  canonicalPath="/"
  structuredData={[appStructuredData]}
>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-head">
      <svg
        class="hero-figure"
        viewBox="0 48 960 152"
        fill="none"
        role="img"
        aria-label="A git graph of agent threads: branches leave a main line and come back; one branch stays open, ending in a glowing node"
      >
        <defs>
          <linearGradient id="hero-live-stroke" gradientUnits="userSpaceOnUse" x1="432" y1="128" x2="816" y2="180">
            <stop offset="0" stop-color="#a1a1aa" stop-opacity="0.35"></stop>
            <stop offset="1" stop-color="var(--accent-bright)" stop-opacity="0.9"></stop>
          </linearGradient>
        </defs>
        <g stroke-linecap="round" stroke-width="1.25">
          <path class="hero-line" vector-effect="non-scaling-stroke" d="M -8 128 L 968 128" pathLength="1" stroke="var(--line-dim)" style="--d: 0.2s"></path>
          <path class="hero-line" vector-effect="non-scaling-stroke" d="M 256 128 C 282 128 282 76 308 76 L 600 76 C 626 76 626 128 652 128" pathLength="1" stroke="var(--line-faint)" style="--d: 0.7s; animation-duration: 0.8s"></path>
          <path class="hero-line" vector-effect="non-scaling-stroke" d="M 432 128 C 458 128 458 180 484 180 L 812 180" pathLength="1" stroke="url(#hero-live-stroke)" style="--d: 0.95s; animation-duration: 0.8s"></path>
        </g>
        <g fill="var(--node)">
          <circle class="hero-node" cx="140" cy="128" r="3" style="--d: 0.45s"></circle>
          <circle class="hero-node" cx="256" cy="128" r="3.5" style="--d: 0.6s"></circle>
          <circle class="hero-node" cx="432" cy="128" r="3.5" style="--d: 0.8s"></circle>
          <circle class="hero-node" cx="452" cy="76" r="3" style="--d: 1.2s"></circle>
          <circle class="hero-node" cx="652" cy="128" r="3.5" style="--d: 1.4s"></circle>
          <circle class="hero-node" cx="744" cy="128" r="3" style="--d: 1.3s"></circle>
          <circle class="hero-node" cx="896" cy="128" r="3" style="--d: 1.5s"></circle>
        </g>
        <circle cx="816" cy="180" r="6" fill="var(--accent-bright)" opacity="0.2"></circle>
        <circle class="hero-node" cx="816" cy="180" r="4" fill="var(--accent-bright)" style="--d: 1.6s"></circle>
      </svg>

      <a class="release rise" style="--d: 0.15s" href={changelogEntryPath(latestRelease)}
        ><span class="release-tag">New in {latestRelease.data.version}</span><span
          >{latestRelease.data.headline ?? "See what's new"}</span
        ><span aria-hidden="true">&rarr;</span></a
      >
      <h1 class="hero-title rise" style="--d: 0.25s">
        A desktop app for every<br class="hero-break" /> coding agent you use.
      </h1>
      <p class="hero-sub rise" style="--d: 0.4s">
        Run Claude&nbsp;Code, Codex, OpenCode and {otherAgents} from one window.{" "}
        <strong class="hero-em">Any thread can hold more than one model</strong>, and the app is free and
        open source.
      </p>
      <div class="actions rise" style="--d: 0.55s">
        <a class="button" id="pv-download" href="/download"
          ><span class="button-ico" id="pv-dl-mac" hidden set:html={appleIcon} /><span
            class="button-ico"
            id="pv-dl-win"
            hidden
            set:html={windowsIcon}
          /><span id="pv-dl-label">Download Threadlines</span></a
        >
        <a class="button button-quiet" href={SITE_GITHUB_URL} target="_blank" rel="noopener noreferrer"
          ><span class="button-ico" set:html={githubIcon} />View on GitHub</a
        >
      </div>
      <p class="hero-note rise" style="--d: 0.7s">
        <span>Use the accounts you already have ·</span>{" "}<span>Runs locally</span>
      </p>
      <div class="agents rise" style="--d: 0.8s">
        <p class="agents-label">Runs the agents you already use</p>
        <ul class="agents-list">
          {
            AGENTS.map((agent) => (
              <li>
                <a
                  class="agent"
                  href={agentPath(agent)}
                  aria-label={agent.markIsWordmark ? agent.name : undefined}
                >
                  <span class="agent-mark">
                    <AgentMark slug={agent.slug} />
                  </span>
                  {!agent.markIsWordmark && agent.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <figure class="hero-media rise" style="--d: 0.95s">
      <div class="frame frame-swap" data-player>
        <video
          class="clip-wide"
          muted
          playsinline
          loop
          preload="none"
          poster={`${demos.rooms.base}.webp`}
          width="1600"
          height="934"
          aria-label={demos.rooms.label}
        >
          <source src={`${demos.rooms.base}.mp4`} type="video/mp4" />
        </video>
        <video
          class="clip-tall"
          muted
          playsinline
          loop
          preload="none"
          poster={`${demos.rooms.base}-tall.webp`}
          width="800"
          height="1000"
          aria-label={demos.rooms.label}
        >
          <source src={`${demos.rooms.base}-tall.mp4`} type="video/mp4" />
        </video>
        <button class="play" type="button" aria-label="Play the demo"
          ><span class="play-ico" set:html={playIcon} /><span class="pause-ico" set:html={pauseIcon} /></button
        >
      </div>
      <figcaption>
        A {demos.rooms.seconds}-second demo: Opus can't find why some customers are
        charged twice, so you add GPT-6.1-Sol to the thread. A recreated conversation in the current app.
      </figcaption>
    </figure>
  </section>

  <section class="section" aria-labelledby="spread-title">
    <div class="wrap spread">
      <header class="spread-head">
        <p class="kicker">How it works</p>
        <h2 id="spread-title">Get help without losing the thread</h2>
        <p class="lede">
          When an agent gets stuck, add another model, split the work into new threads, or send part
          of it to another computer. Every answer comes back to the thread you started in.
        </p>
      </header>

      <figure class="spread-graph">
        <div class="graph-panel">
        <ol class="graph" aria-label="An example thread, Double charges at checkout">
          <li class="g-row g-start g-ring">
            <span class="g-thread">Double charges at checkout</span>
            <span class="g-chip"><span class="g-chip-ico" set:html={appleIcon} />MacBook Pro</span>
          </li>
          <li class="g-row">
            <span class="g-who"><span class="g-mark"><AgentMark slug="claude-code" /></span>Opus 5.5</span>
            <span class="g-text">Double clicks are blocked and the tests pass. I can't reproduce it.</span>
          </li>
          <li class="g-row g-ring">
            <span class="g-event">You add GPT-6.1-Sol to the thread</span>
            <span class="g-tag"><Icon name="agents" />Rooms</span>
          </li>
          <li class="g-row">
            <span class="g-who"><span class="g-mark"><AgentMark slug="codex" /></span>GPT-6.1-Sol</span>
            <span class="g-text">The payment goes through, but its reply times out, and the retry charges again.</span>
          </li>
          <li class="g-branch">
            <div class="g-fork">
              <svg class="g-curve" viewBox="0 0 40 30" aria-hidden="true"><path d="M8 0C8 16 30 14 30 30"></path></svg>
              <span class="g-event">Opus starts a thread</span>
              <span class="g-tag"><Icon name="branch" />Threads</span>
            </div>
            <div class="g-row g-child">
              <span class="g-who"><span class="g-mark"><AgentMark slug="claude-code" /></span>Sonnet 5.5</span>
              <span class="g-text">Last week's logs show 41 double charges, each one right after a timeout.</span>
            </div>
            <div class="g-join">
              <svg class="g-curve" viewBox="0 0 40 30" aria-hidden="true"><path d="M30 0C30 16 8 14 8 30"></path></svg>
              <span class="g-event">The answer comes back</span>
            </div>
          </li>
          <li class="g-branch">
            <div class="g-fork">
              <svg class="g-curve" viewBox="0 0 40 30" aria-hidden="true"><path d="M8 0C8 16 30 14 30 30"></path></svg>
              <span class="g-event"
                >Opus starts a thread on <span class="g-chip"
                  ><span class="g-chip-ico" set:html={windowsIcon} />Windows PC</span
                ></span
              >
              <span class="g-tag"><Icon name="computers" />Fleet</span>
            </div>
            <div class="g-row g-child">
              <span class="g-who"><span class="g-mark"><AgentMark slug="claude-code" /></span>Opus 5.5</span>
              <span class="g-text">Every checkout test passes in Edge with the fix.</span>
            </div>
            <div class="g-join">
              <svg class="g-curve" viewBox="0 0 40 30" aria-hidden="true"><path d="M30 0C30 16 8 14 8 30"></path></svg>
              <span class="g-event">The answer comes back</span>
            </div>
          </li>
          <li class="g-row g-end">
            <span class="g-who"><span class="g-mark"><AgentMark slug="claude-code" /></span>Opus 5.5</span>
            <span class="g-text">Fixed. The retry reuses the first payment's key, so it can't charge twice.</span>
          </li>
        </ol>
        </div>
        <figcaption>An example thread. By default, an agent asks you before it starts a thread.</figcaption>
      </figure>

      <dl class="spread-notes">
        {
          ideas.map((idea) => (
            <div class="note">
              <dt>
                <Icon name={idea.icon} class="note-ico" />
                {idea.name}
              </dt>
              <dd>
                <p>{idea.text}</p>
                <button
                  class="watch"
                  type="button"
                  data-demo={idea.demo.base}
                  data-label={idea.demo.label}
                  data-title={`${idea.name}, ${clock(idea.demo.seconds)}`}
                >
                  <span class="watch-ico" set:html={playIcon} />
                  Watch {idea.name}{" "}
                  <span class="watch-time">{clock(idea.demo.seconds)}</span>
                </button>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="tools-title">
    <div class="wrap">
      <p class="kicker">Built in</p>
      <h2 id="tools-title">Everything else, beside the chat</h2>
      <ul class="tools">
        {
          tools.map((tool) => (
            <li>
              <Icon name={tool.icon} class="tool-ico" />
              <h3>{tool.name}</h3>
              <p>{tool.text}</p>
            </li>
          ))
        }
      </ul>
      <a class="text-link tools-more" href="/changelog"
        >See what changed in every release <span aria-hidden="true">&rarr;</span></a
      >
    </div>
  </section>

  <section class="section" aria-labelledby="own-title">
    <div class="wrap own">
      <div class="own-copy">
        <p class="kicker">Free and open source</p>
        <h2 id="own-title">Your machine, your accounts</h2>
        <p class="lede">
          Threadlines runs on your computer and uses the Claude, Codex and other agent accounts you
          already pay for. There's no Threadlines account to make. The code is MIT-licensed and
          began as a fork of T3&nbsp;Code.
        </p>
        <div class="actions">
          <a class="button" href="/download">Download Threadlines</a>
          <a class="text-link" href={SITE_GITHUB_URL} target="_blank" rel="noopener noreferrer"
            >View source <span aria-hidden="true">&rarr;</span></a
          >
        </div>
      </div>
      <dl class="specs">
        <div>
          <dt>Latest</dt>
          <dd>
            <a href={changelogEntryPath(latestRelease)}
              >{latestRelease.data.version}, {formatReleaseDate(latestRelease.data.date)}</a
            >
          </dd>
        </div>
        <div>
          <dt>Runs on</dt>
          <dd class="os">
            <span><span class="os-ico" set:html={appleIcon} />macOS 13 or later</span>
            <span><span class="os-ico" set:html={windowsIcon} />Windows</span>
            <span><span class="os-ico" set:html={linuxIcon} />Linux</span>
          </dd>
        </div>
        <div>
          <dt>Price</dt>
          <dd>Free</dd>
        </div>
        <div>
          <dt>License</dt>
          <dd>MIT</dd>
        </div>
        <div>
          <dt>Source</dt>
          <dd>
            <a href={SITE_GITHUB_URL} target="_blank" rel="noopener noreferrer"
              >github.com/<wbr />Threadlines/<wbr />threadlines</a
            >
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <dialog class="viewer" id="demo-viewer" aria-label="Product demo">
    <form method="dialog" class="viewer-bar">
      <span class="viewer-title"></span>
      <button class="viewer-close" type="submit" aria-label="Close">Close</button>
    </form>
    <div class="viewer-stage"></div>
  </dialog>
</Layout>

<script>
  import { detectDevice, detectMacArch, isTouchOnly, type MacArch } from "../lib/platform";
  import { classifyAssets, fetchLatestRelease, pickInstaller } from "../lib/releases";

  const dl = document.getElementById("pv-download") as HTMLAnchorElement | null;
  if (dl) {
    const device = detectDevice(navigator, isTouchOnly(window));
    const label = document.getElementById("pv-dl-label")!;
    // deep-link the button straight to the installer; /download stays the fallback
    const linkInstaller = (macArch?: MacArch) =>
      fetchLatestRelease()
        .then((release) => {
          const asset = pickInstaller(classifyAssets(release.assets), device, macArch);
          if (asset) dl.href = asset.browser_download_url;
        })
        .catch(() => {});
    if (device === "windows") {
      label.textContent = "Download for Windows";
      document.getElementById("pv-dl-win")!.hidden = false;
      linkInstaller();
    } else if (device === "linux") {
      label.textContent = "Download for Linux";
      linkInstaller();
    } else if (device === "mac") {
      document.getElementById("pv-dl-mac")!.hidden = false;
      // Only Chromium says which chip a Mac has; elsewhere the visitor chooses on /download.
      detectMacArch(navigator).then((macArch) => {
        label.textContent = macArch ? "Download for macOS" : "Choose a macOS download";
        if (macArch) linkInstaller(macArch);
      });
    } else if (device === "mobile") {
      label.textContent = "Get it on your computer";
    }
  }

  // Phones get the tall cut of each demo.
  const tall = window.matchMedia("(max-width: 640px)");
  const viewer = document.getElementById("demo-viewer") as HTMLDialogElement | null;
  /** Re-checks every hero player, e.g. after the demo dialog closes. */
  const resyncPlayers: (() => void)[] = [];

  // The hero demo plays while at least a quarter of it is on screen, unless the
  // visitor paused it. With reduced motion it never starts by itself: only the
  // Play button starts it, and anything else can only pause it.
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  for (const player of document.querySelectorAll<HTMLElement>("[data-player]")) {
    const button = player.querySelector<HTMLButtonElement>(".play");
    const videos = [...player.querySelectorAll<HTMLVideoElement>("video")];
    let inView = false;
    let pausedByVisitor = false;
    const shown = () => player.querySelector<HTMLVideoElement>(tall.matches ? ".clip-tall" : ".clip-wide");
    const sync = (byVisitor = false) => {
      const active = shown();
      const allowed = inView && !pausedByVisitor && !viewer?.open;
      for (const video of videos) {
        if (video === active && allowed && (byVisitor || !motion.matches)) video.play().catch(() => {});
        else if (video !== active || !allowed) video.pause();
      }
    };
    const label = () => {
      const active = shown();
      const playing = !!active && !active.paused;
      player.classList.toggle("is-playing", playing);
      button?.setAttribute("aria-label", playing ? "Pause the demo" : "Play the demo");
    };
    for (const video of videos) {
      video.addEventListener("play", label);
      video.addEventListener("pause", label);
    }
    button?.addEventListener("click", () => {
      const playing = !(shown()?.paused ?? true);
      pausedByVisitor = playing;
      if (playing) sync();
      else {
        inView = true;
        sync(true);
      }
    });
    tall.addEventListener("change", () => sync());
    motion.addEventListener("change", () => sync());
    resyncPlayers.push(() => sync());
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = !!entry && entry.isIntersecting && entry.intersectionRatio >= 0.25;
          sync();
        },
        { threshold: [0, 0.25] },
      ).observe(player);
    }
  }

  // The other demos open in a dialog, so the page itself stays still.
  const stage = viewer?.querySelector<HTMLElement>(".viewer-stage");
  const title = viewer?.querySelector<HTMLElement>(".viewer-title");
  if (viewer && stage && title) {
    for (const watch of document.querySelectorAll<HTMLButtonElement>(".watch")) {
      watch.addEventListener("click", () => {
        const base = `${watch.dataset.demo}${tall.matches ? "-tall" : ""}`;
        const video = document.createElement("video");
        video.className = "viewer-video";
        video.muted = true;
        video.playsInline = true;
        video.controls = true;
        video.poster = `${base}.webp`;
        video.setAttribute("aria-label", watch.dataset.label ?? "");
        const source = document.createElement("source");
        source.src = `${base}.mp4`;
        source.type = "video/mp4";
        video.append(source);
        stage.replaceChildren(video);
        title.textContent = watch.dataset.title ?? "";
        viewer.showModal();
        for (const sync of resyncPlayers) sync();
        video.play().catch(() => {});
      });
    }
    viewer.addEventListener("click", (event) => {
      if (event.target === viewer) viewer.close();
    });
    viewer.addEventListener("close", () => {
      stage.replaceChildren();
      for (const sync of resyncPlayers) sync();
    });
  }
</script>

