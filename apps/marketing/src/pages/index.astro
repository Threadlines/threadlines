---
import Layout from "../layouts/Layout.astro";
import { absoluteSiteUrl, DEFAULT_SITE_DESCRIPTION } from "../lib/site";

const L = "/Screenshots/stable-launch";
const styledScenes = new Set(["inbox", "pull-requests", "source-control", "browser", "context"]);
const mediaName = (name: string) => styledScenes.has(name) ? `spotlight-${name}` : name;

const appStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Threadlines",
  operatingSystem: "macOS, Windows, Linux",
  applicationCategory: "DeveloperApplication",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: DEFAULT_SITE_DESCRIPTION,
  url: absoluteSiteUrl("/"),
  downloadUrl: absoluteSiteUrl("/download"),
  license: "https://opensource.org/license/mit/",
  sameAs: ["https://github.com/Threadlines/threadlines", "https://x.com/threadlinesdev"],
};

const showcases = [
  {
    id: "inbox",
    kicker: "Across your projects",
    title: "Know which thread needs you next",
    description:
      "See working threads, open pull requests, and active terminals in one inbox. Keep finished work in Wrapped, and open the activity panel to follow tasks and subagents.",
    clips: [
      { name: "inbox", tab: "Thread inbox", label: "Project threads with working and finished states, pull request badges, active terminals, and Wrapped threads" },
      { name: "activity", tab: "Tasks and activity", label: "The activity panel beside a thread, showing tasks, subagents, and background work" },
    ],
  },
  {
    id: "review",
    kicker: "Code review and pull requests",
    title: "Follow the work through review",
    description:
      "Review a GitHub pull request beside its thread, check CI above the composer, and send feedback back to the agent. Open file diffs and Git history without losing the conversation.",
    clips: [
      { name: "pull-requests", tab: "Pull requests and CI", label: "A thread with an open pull request and its CI checks above the composer" },
      { name: "source-control", tab: "Changed files", label: "Reviewing changed files and staged changes in the source-control panel" },
      { name: "git-history", tab: "Git history", label: "Opening commits in the Git history panel beside the agent conversation" },
    ],
  },
  {
    id: "browser",
    kicker: "Built-in browser",
    title: "Bring the page into your thread",
    description:
      "Open your site inside Threadlines, search the page, and attach a screenshot to your next message.",
    clips: [
      { name: "browser", tab: "Browser", label: "Finding text on the FACP Manuals homepage and attaching a browser screenshot to the thread" },
    ],
  },
  {
    id: "context",
    kicker: "Files and context",
    title: "Show the agent the lines you mean",
    description:
      "Browse and edit project files, then attach selected code, terminal output, or a note on a reply to your next message.",
    clips: [
      { name: "files", tab: "Project files", label: "Browsing project files and opening a file in the editor beside the thread" },
      { name: "context", tab: "Exact context", label: "Selecting specific content and attaching it to the chat composer" },
    ],
  },
  {
    id: "providers",
    kicker: "Codex and Claude Code",
    title: "Keep the thread. Choose the provider.",
    description:
      "Switch providers with a conversation recap and the current working tree. Your code and the thread stay together when you change tools.",
    clips: [
      { name: "provider-switch", tab: "Switch providers", label: "The provider switch dialog in an existing project thread" },
    ],
  },
];

const playGlyphs = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="pv-ico-play"><path d="M8 5.2v13.6L19 12z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="pv-ico-pause"><path d="M7 5h3.6v14H7zM13.4 5H17v14h-3.6z"/></svg>`;
---

<Layout
  title="Threadlines: a local workspace for coding agents"
  description="Run Codex and Claude Code in one local workspace. Follow project threads, review pull requests and CI, preview your site, and inspect files and Git changes."
  canonicalPath="/"
  structuredData={[appStructuredData]}
>
  <section class="pv-hero">
    <div class="pv-glow pv-glow-hero" aria-hidden="true"></div>
    <div class="pv-wrap">
      <svg
        class="pv-figure"
        viewBox="0 48 960 152"
        fill="none"
        role="img"
        aria-label="A git graph of agent threads: branches diverge from a main line and merge back; one branch stays open, ending in a glowing node"
      >
        <defs>
          <linearGradient
            id="pv-live-stroke"
            gradientUnits="userSpaceOnUse"
            x1="432"
            y1="128"
            x2="816"
            y2="180"
          >
            <stop offset="0" stop-color="#a1a1aa" stop-opacity="0.35"></stop>
            <stop offset="1" stop-color="var(--accent-bright)" stop-opacity="0.9"></stop>
          </linearGradient>
        </defs>
        <g stroke-linecap="round" stroke-width="1.25">
          <path
            class="pv-line" vector-effect="non-scaling-stroke"
            d="M -8 128 L 968 128"
            pathLength="1"
            stroke="var(--line-dim)"
            style="--pv-delay: 0.2s"></path>
          <path
            class="pv-line" vector-effect="non-scaling-stroke"
            d="M 256 128 C 282 128 282 76 308 76 L 600 76 C 626 76 626 128 652 128"
            pathLength="1"
            stroke="var(--line-faint)"
            style="--pv-delay: 0.7s; animation-duration: 0.8s"></path>
          <path
            class="pv-line" vector-effect="non-scaling-stroke"
            d="M 432 128 C 458 128 458 180 484 180 L 812 180"
            pathLength="1"
            stroke="url(#pv-live-stroke)"
            style="--pv-delay: 0.95s; animation-duration: 0.8s"></path>
        </g>
        <g fill="var(--node)">
          <circle class="pv-node" cx="140" cy="128" r="3" style="--pv-delay: 0.45s"></circle>
          <circle class="pv-node" cx="256" cy="128" r="3.5" style="--pv-delay: 0.6s"></circle>
          <circle class="pv-node" cx="432" cy="128" r="3.5" style="--pv-delay: 0.8s"></circle>
          <circle class="pv-node" cx="452" cy="76" r="3" style="--pv-delay: 1.2s"></circle>
          <circle class="pv-node" cx="652" cy="128" r="3.5" style="--pv-delay: 1.4s"></circle>
          <circle class="pv-node" cx="744" cy="128" r="3" style="--pv-delay: 1.3s"></circle>
          <circle class="pv-node" cx="896" cy="128" r="3" style="--pv-delay: 1.5s"></circle>
        </g>
        <circle class="pv-halo" cx="816" cy="180" r="6" fill="var(--accent-bright)"></circle>
        <circle
          class="pv-node pv-node-live"
          cx="816"
          cy="180"
          r="4"
          fill="var(--accent-bright)"
          style="--pv-delay: 1.6s"></circle>
      </svg>

      <h1 class="pv-display pv-rise" style="--pv-d: 0.25s">Run Codex and Claude.<br />Review the work in one place.</h1>
      <p class="pv-sub pv-rise" style="--pv-d: 0.4s">
        Threadlines is a local desktop workspace for Claude&nbsp;Code and Codex. Keep the
        conversation, <span class="pv-accent">pull requests</span>, browser, and source control
        together while your agents work.
      </p>
      <div class="pv-cta-row pv-rise" style="--pv-d: 0.55s">
        <a class="pv-cta pv-cta-primary" id="pv-download" href="/download"><span class="pv-cta-ico" id="pv-dl-mac"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg></span><span class="pv-cta-ico" id="pv-dl-win" hidden><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h8.5v8.5H3zM12.5 3H21v8.5h-8.5zM3 12.5h8.5V21H3zM12.5 12.5H21V21h-8.5z"/></svg></span><span id="pv-dl-label">Download for macOS</span></a>
        <a
          class="pv-cta"
          href="https://github.com/Threadlines/threadlines"
          target="_blank"
          rel="noopener noreferrer">View on GitHub</a
        >
      </div>
      <p class="pv-note pv-rise" style="--pv-d: 0.7s">
        Free and open source · Bring your own Codex or Claude account · Runs locally
      </p>
      <div class="pv-providers pv-rise" style="--pv-d: 0.8s" aria-label="Supported agents">
        <span class="pv-providers-label">Runs the agents you already use</span>
        <span class="pv-provider">
          <svg viewBox="0 0 256 260" preserveAspectRatio="xMidYMid" aria-hidden="true"><path fill="currentColor" d="M239.184 106.203a64.716 64.716 0 0 0-5.576-53.103C219.452 28.459 191 15.784 163.213 21.74A65.586 65.586 0 0 0 52.096 45.22a64.716 64.716 0 0 0-43.23 31.36c-14.31 24.602-11.061 55.634 8.033 76.74a64.665 64.665 0 0 0 5.525 53.102c14.174 24.65 42.644 37.324 70.446 31.36a64.72 64.72 0 0 0 48.754 21.744c28.481.025 53.714-18.361 62.414-45.481a64.767 64.767 0 0 0 43.229-31.36c14.137-24.558 10.875-55.423-8.083-76.483Zm-97.56 136.338a48.397 48.397 0 0 1-31.105-11.255l1.535-.87 51.67-29.825a8.595 8.595 0 0 0 4.247-7.367v-72.85l21.845 12.636c.218.111.37.32.409.563v60.367c-.056 26.818-21.783 48.545-48.601 48.601Zm-104.466-44.61a48.345 48.345 0 0 1-5.781-32.589l1.534.921 51.722 29.826a8.339 8.339 0 0 0 8.441 0l63.181-36.425v25.221a.87.87 0 0 1-.358.665l-52.335 30.184c-23.257 13.398-52.97 5.431-66.404-17.803ZM23.549 85.38a48.499 48.499 0 0 1 25.58-21.333v61.39a8.288 8.288 0 0 0 4.195 7.316l62.874 36.272-21.845 12.636a.819.819 0 0 1-.767 0L41.353 151.53c-23.211-13.454-31.171-43.144-17.804-66.405v.256Zm179.466 41.695-63.08-36.63L161.73 77.86a.819.819 0 0 1 .768 0l52.233 30.184a48.6 48.6 0 0 1-7.316 87.635v-61.391a8.544 8.544 0 0 0-4.4-7.213Zm21.742-32.69-1.535-.922-51.619-30.081a8.39 8.39 0 0 0-8.492 0L99.98 99.808V74.587a.716.716 0 0 1 .307-.665l52.233-30.133a48.652 48.652 0 0 1 72.236 50.391v.205ZM88.061 139.097l-21.845-12.585a.87.87 0 0 1-.41-.614V65.685a48.652 48.652 0 0 1 79.757-37.346l-1.535.87-51.67 29.825a8.595 8.595 0 0 0-4.246 7.367l-.051 72.697Zm11.868-25.58 28.138-16.217 28.188 16.218v32.434l-28.086 16.218-28.188-16.218-.052-32.434Z"/></svg>
          Codex
        </span>
        <span class="pv-provider">
          <svg viewBox="0 0 256 257" aria-hidden="true"><path fill="#d97757" d="m50.228 170.321 50.357-28.257.843-2.463-.843-1.361h-2.462l-8.426-.518-28.775-.778-24.952-1.037-24.175-1.296-6.092-1.297L0 125.796l.583-3.759 5.12-3.434 7.324.648 16.202 1.101 24.304 1.685 17.629 1.037 26.118 2.722h4.148l.583-1.685-1.426-1.037-1.101-1.037-25.147-17.045-27.22-18.017-14.258-10.37-7.713-5.25-3.888-4.925-1.685-10.758 7-7.713 9.397.649 2.398.648 9.527 7.323 20.35 15.75L94.817 91.9l3.889 3.24 1.555-1.102.195-.777-1.75-2.917-14.453-26.118-15.425-26.572-6.87-11.018-1.814-6.61c-.648-2.723-1.102-4.991-1.102-7.778l7.972-10.823L71.42 0 82.05 1.426l4.472 3.888 6.61 15.101 10.694 23.786 16.591 32.34 4.861 9.592 2.592 8.879.973 2.722h1.685v-1.556l1.36-18.211 2.528-22.36 2.463-28.776.843-8.1 4.018-9.722 7.971-5.25 6.222 2.981 5.12 7.324-.713 4.73-3.046 19.768-5.962 30.98-3.889 20.739h2.268l2.593-2.593 10.499-13.934 17.628-22.036 7.778-8.749 9.073-9.657 5.833-4.601h11.018l8.1 12.055-3.628 12.443-11.342 14.388-9.398 12.184-13.48 18.147-8.426 14.518.778 1.166 2.01-.194 30.46-6.481 16.462-2.982 19.637-3.37 8.88 4.148.971 4.213-3.5 8.62-20.998 5.184-24.628 4.926-36.682 8.685-.454.324.519.648 16.526 1.555 7.065.389h17.304l32.21 2.398 8.426 5.574 5.055 6.805-.843 5.184-12.962 6.611-17.498-4.148-40.83-9.721-14-3.5h-1.944v1.167l11.666 11.406 21.387 19.314 26.767 24.887 1.36 6.157-3.434 4.86-3.63-.518-23.526-17.693-9.073-7.972-20.545-17.304h-1.36v1.814l4.73 6.935 25.017 37.59 1.296 11.536-1.814 3.76-6.481 2.268-7.13-1.297-14.647-20.544-15.1-23.138-12.185-20.739-1.49.843-7.194 77.448-3.37 3.953-7.778 2.981-6.48-4.925-3.436-7.972 3.435-15.749 4.148-20.544 3.37-16.333 3.046-20.285 1.815-6.74-.13-.454-1.49.194-15.295 20.999-23.267 31.433-18.406 19.702-4.407 1.75-7.648-3.954.713-7.064 4.277-6.286 25.47-32.405 15.36-20.092 9.917-11.6-.065-1.686h-.583L44.07 198.125l-12.055 1.555-5.185-4.86.648-7.972 2.463-2.593 20.35-13.999-.064.065Z"/></svg>
          Claude Code
        </span>
      </div>
    </div>
    <figure class="pv-app-frame pv-rise" style="--pv-d: 0.95s">
      <div
        class="pv-frame"
      >
        <video
          class="pv-video"
          muted
          playsinline
          loop
          preload="metadata"
          poster="/Screenshots/stable-launch/workspace.webp"
          width="1600"
          height="934"
          aria-label="A Threadlines demo showing the inbox, pull request checks, and code review. Recreated conversations in the current app."
        >
          <source src="/Screenshots/stable-launch/workspace.mp4" type="video/mp4" />
        </video>
        <button class="pv-expand" type="button" aria-label="Expand the workspace demo"><span>Expand</span></button>
        <button class="pv-play" type="button" aria-label="Play video" set:html={playGlyphs} />
      </div>
      <figcaption>
        A 30-second tour of the inbox, PR checks, and code review. Recreated conversations in the current app.
      </figcaption>
    </figure>
  </section>

  {
    showcases.map((showcase) => (
      <section class="pv-section" id={showcase.id}>
        <div class="pv-wrap pv-center pv-reveal">
          <p class="pv-kicker">{showcase.kicker}</p>
          <h2>{showcase.title}</h2>
          <p class="pv-lede">{showcase.description}</p>
        </div>
        <div class="pv-showcase pv-reveal" data-tabset>
          {showcase.clips.length > 1 && (
            <div class="pv-steps" role="tablist" aria-label={`${showcase.kicker} demos`}>
              {showcase.clips.map((clip, i) => (
                <button
                  class:list={["pv-step", i === 0 && "pv-active"]}
                  id={`tab-${clip.name}`}
                  aria-controls={`clip-${clip.name}`}
                  role="tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  type="button"
                >
                  {clip.tab}
                </button>
              ))}
            </div>
          )}
          <div class="pv-frame">
            {showcase.clips.map((clip, i) => (
              <video
                class:list={["pv-video", "pv-pane", i === 0 && "pv-active"]}
                id={`clip-${clip.name}`}
                role={showcase.clips.length > 1 ? "tabpanel" : undefined}
                aria-labelledby={showcase.clips.length > 1 ? `tab-${clip.name}` : undefined}
                aria-hidden={i !== 0}
                muted
                playsinline
                loop
                preload="none"
                poster={`${L}/${mediaName(clip.name)}.webp`}
                width="1600"
                height="934"
                aria-label={clip.label}
              >
                <source src={`${L}/${mediaName(clip.name)}.mp4`} type="video/mp4" />
              </video>
            ))}
            <button class="pv-expand" type="button" aria-label={`Expand ${showcase.kicker.toLowerCase()} demo`}>
              <span>Expand</span>
            </button>
            <button class="pv-play" type="button" aria-label="Play video" set:html={playGlyphs} />
          </div>
        </div>
      </section>
    ))
  }

  <section class="pv-section">
    <div class="pv-wrap">
      <div class="pv-reveal pv-center">
        <p class="pv-kicker">Daily work</p>
        <h2>Pick up where you left off</h2>
      </div>
      <div class="pv-grid">
        <div class="pv-card pv-reveal">
          <h3>Resume a thread</h3>
          <p>Reopen the app and continue with the conversation and work history in place.</p>
        </div>
        <div class="pv-card pv-reveal">
          <h3>Try another direction</h3>
          <p>Fork a conversation to explore another approach with its context.</p>
        </div>
        <div class="pv-card pv-reveal">
          <h3>Separate the work</h3>
          <p>Give a thread its own Git worktree so agents can work in separate checkouts.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pv-section pv-oss">
    <div class="pv-wrap pv-center pv-reveal">
      <p class="pv-kicker">Free and open source</p>
      <h2>Your projects, on your machine</h2>
      <p class="pv-lede">
        Threadlines runs locally with your Codex or Claude account. The app is MIT-licensed,
        with its source and full history on GitHub. It began as a fork of T3 Code.
      </p>
      <div class="pv-cta-row">
        <a class="pv-cta pv-cta-primary" href="/download">Download Threadlines</a>
        <a class="pv-cta" href="https://github.com/Threadlines/threadlines" target="_blank" rel="noopener noreferrer">View source</a>
      </div>
      <p class="pv-note">macOS &middot; Windows &middot; Linux</p>
    </div>
  </section>

  <div class="pv-lightbox" id="pv-lightbox" role="dialog" aria-modal="true" aria-label="Expanded product demo" hidden>
    <button class="pv-lightbox-close" type="button" aria-label="Close preview">×</button>
    <button class="pv-lightbox-nav pv-lightbox-prev" type="button" aria-label="Previous">‹</button>
    <div class="pv-lightbox-stage"></div>
    <button class="pv-lightbox-nav pv-lightbox-next" type="button" aria-label="Next">›</button>
  </div>
</Layout>

<script>
  import { classifyAssets, fetchLatestRelease } from "../lib/releases";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const dl = document.getElementById("pv-download") as HTMLAnchorElement | null;
  if (dl) {
    const userAgent = navigator.userAgent.toLowerCase();
    const platform = (
      (navigator as { userAgentData?: { platform?: string } }).userAgentData?.platform ?? ""
    ).toLowerCase();
    const isMobile = /android|iphone|ipad|ipod/.test(userAgent);
    const isWin = platform.includes("win") || userAgent.includes("windows");
    const isLinux =
      !isMobile && (platform.includes("linux") || userAgent.includes("linux"));
    const isMac =
      !isMobile && (platform.includes("mac") || userAgent.includes("macintosh"));
    const label = document.getElementById("pv-dl-label")!;
    if (isWin) {
      label.textContent = "Download for Windows";
      document.getElementById("pv-dl-mac")!.hidden = true;
      document.getElementById("pv-dl-win")!.hidden = false;
    } else if (isLinux) {
      label.textContent = "Download for Linux";
      document.getElementById("pv-dl-mac")!.hidden = true;
    } else if (isMac) {
      label.textContent = "Choose a macOS download";
    }
    if (isWin || isLinux) {
      // deep-link the button straight to the installer; /download stays the fallback
      fetchLatestRelease()
        .then((release) => {
          const installers = classifyAssets(release.assets);
          const asset = isWin
            ? (installers.winX64 ?? installers.winArm)
            : installers.linuxX64;
          if (asset) dl.href = asset.browser_download_url;
        })
        .catch(() => {});
    }
  }

  const targets = document.querySelectorAll(".pv-reveal");
  if (reduced || !("IntersectionObserver" in window)) {
    for (const el of targets) el.classList.add("pv-in");
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("pv-in");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
    );
    for (const el of targets) observer.observe(el);
  }

  // Play visible clips unless the visitor pauses them or requests reduced motion.
  const inView = new WeakSet<Element>();
  const manuallyPaused = new WeakSet<HTMLVideoElement>();
  const videos = [...document.querySelectorAll<HTMLVideoElement>("video.pv-video")];
  const activeVideo = (frame: HTMLElement) =>
    frame.querySelector<HTMLVideoElement>("video.pv-active") ??
    frame.querySelector<HTMLVideoElement>("video");
  const syncPlayButton = (video: HTMLVideoElement) => {
    const frame = video.closest<HTMLElement>(".pv-frame");
    if (!frame || activeVideo(frame) !== video) return;
    const button = frame.querySelector<HTMLButtonElement>(".pv-play");
    button?.classList.toggle("pv-playing", !video.paused);
    button?.setAttribute("aria-label", video.paused ? "Play video" : "Pause video");
  };
  const syncVideo = (video: HTMLVideoElement) => {
    const active = !video.classList.contains("pv-pane") || video.classList.contains("pv-active");
    if (!active || !inView.has(video) || !lightbox.hidden) video.pause();
    else if (!reduced && !manuallyPaused.has(video)) video.play().catch(() => {});
  };
  for (const video of videos) {
    video.addEventListener("play", () => syncPlayButton(video));
    video.addEventListener("pause", () => syncPlayButton(video));
  }
  if ("IntersectionObserver" in window) {
    const playObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inView.add(entry.target);
          else inView.delete(entry.target);
          syncVideo(entry.target as HTMLVideoElement);
        }
      },
      { threshold: 0.25 },
    );
    for (const video of videos) playObserver.observe(video);
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>(".pv-play")) {
    button.addEventListener("click", () => {
      const frame = button.closest<HTMLElement>(".pv-frame");
      const video = frame && activeVideo(frame);
      if (!video) return;
      if (video.paused) {
        manuallyPaused.delete(video);
        video.play().catch(() => {});
      } else {
        manuallyPaused.add(video);
        video.pause();
      }
    });
  }

  for (const set of document.querySelectorAll<HTMLElement>("[data-tabset]")) {
    const panes = [...set.querySelectorAll<HTMLVideoElement>(".pv-pane")];
    const steps = [...set.querySelectorAll<HTMLButtonElement>(".pv-step")];
    const select = (index: number) => {
      set.dataset.current = String(index);
      panes.forEach((pane, i) => {
        pane.classList.toggle("pv-active", index === i);
        pane.setAttribute("aria-hidden", String(index !== i));
        syncVideo(pane);
      });
      steps.forEach((step, i) => {
        step.classList.toggle("pv-active", index === i);
        step.setAttribute("aria-selected", String(index === i));
        step.tabIndex = index === i ? 0 : -1;
      });
      const video = panes[index];
      if (video) syncPlayButton(video);
    };
    steps.forEach((step, i) => {
      step.addEventListener("click", () => select(i));
      step.addEventListener("keydown", (event) => {
        let next: number;
        if (event.key === "ArrowRight") next = (i + 1) % steps.length;
        else if (event.key === "ArrowLeft") next = (i - 1 + steps.length) % steps.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = steps.length - 1;
        else return;
        event.preventDefault();
        select(next);
        steps[next]?.focus();
      });
    });
  }

  // --- lightbox (images and videos) ------------------------------------------
  const lightbox = document.getElementById("pv-lightbox")!;
  const lbStage = lightbox.querySelector<HTMLElement>(".pv-lightbox-stage")!;
  const lbClose = lightbox.querySelector<HTMLButtonElement>(".pv-lightbox-close")!;
  const lbPrev = lightbox.querySelector<HTMLButtonElement>(".pv-lightbox-prev")!;
  const lbNext = lightbox.querySelector<HTMLButtonElement>(".pv-lightbox-next")!;
  let lbItems: (HTMLImageElement | HTMLVideoElement)[] = [];
  let lbIndex = 0;
  let lbTrigger: HTMLElement | null = null;
  const lbShow = (i: number) => {
    lbIndex = (i + lbItems.length) % lbItems.length;
    const item = lbItems[lbIndex];
    lbStage.replaceChildren();
    if (item instanceof HTMLVideoElement) {
      const video = document.createElement("video");
      video.className = "pv-lightbox-media";
      video.controls = true;
      video.tabIndex = 0;
      video.muted = true;
      video.loop = true;
      video.playsInline = true;
      video.poster = item.poster;
      video.setAttribute("aria-label", item.getAttribute("aria-label") ?? "");
      for (const source of item.querySelectorAll("source")) {
        video.append(source.cloneNode());
      }
      lbStage.append(video);
      if (!reduced) video.play().catch(() => {});
    } else {
      const img = document.createElement("img");
      img.className = "pv-lightbox-media";
      img.src = item.currentSrc || item.src;
      img.alt = item.alt;
      lbStage.append(img);
    }
    const solo = lbItems.length < 2;
    lbPrev.hidden = solo;
    lbNext.hidden = solo;
  };
  const lbOpen = (items: (HTMLImageElement | HTMLVideoElement)[], i: number) => {
    if (!items.length) return;
    lbTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    for (const video of videos) video.pause();
    lbItems = items;
    lbShow(i);
    lightbox.hidden = false;
    document.documentElement.style.overflow = "hidden";
    lbClose.focus();
  };
  const closeLightbox = () => {
    lightbox.hidden = true;
    lbStage.replaceChildren();
    document.documentElement.style.overflow = "";
    lbTrigger?.focus();
    for (const video of videos) syncVideo(video);
  };
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  lbClose.addEventListener("click", closeLightbox);
  lbPrev.addEventListener("click", () => lbShow(lbIndex - 1));
  lbNext.addEventListener("click", () => lbShow(lbIndex + 1));
  document.addEventListener("keydown", (e) => {
    if (lightbox.hidden) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "Tab") {
      const controls = [...lightbox.querySelectorAll<HTMLElement>("button:not([hidden]), video[controls]")];
      const first = controls[0];
      const last = controls.at(-1);
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first?.focus();
      }
    }
    const onVideo = e.target instanceof HTMLVideoElement;
    if (!onVideo && lbItems.length > 1) {
      if (e.key === "ArrowLeft") lbShow(lbIndex - 1);
      if (e.key === "ArrowRight") lbShow(lbIndex + 1);
    }
  });
  let lbWheelAt = 0;
  lightbox.addEventListener(
    "wheel",
    (e) => {
      e.preventDefault();
      if (lbItems.length < 2) return;
      const now = Date.now();
      if (now - lbWheelAt < 350 || Math.abs(e.deltaY) < 12) return;
      lbWheelAt = now;
      lbShow(lbIndex + (e.deltaY > 0 ? 1 : -1));
    },
    { passive: false },
  );

  for (const trigger of document.querySelectorAll<HTMLButtonElement>(".pv-expand")) {
    trigger.addEventListener("click", () => {
      const frame = trigger.closest<HTMLElement>(".pv-frame");
      if (!frame) return;
      const media = [...frame.querySelectorAll<HTMLImageElement | HTMLVideoElement>("img, video")];
      const set = frame.closest<HTMLElement>("[data-tabset]");
      lbOpen(media, set ? Number(set.dataset.current || 0) : 0);
    });
  }

</script>

