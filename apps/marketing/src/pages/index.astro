  .g-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    background: linear-gradient(var(--line), var(--line)) no-repeat calc(var(--main) - 0.5px) 0 / 1px 100%;
  }

  .g-start {
    background-position-y: 18px;
  }

  .g-end {
    background-size: 1px 18px;
  }

  /* the message's node */
  .g-row::after {
    content: "";
    position: absolute;
    top: 14px;
    left: calc(var(--main) - 4px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot);
  }

  .g-ring::after {
    background: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--dot);
  }

  .g-end::after {
    background: var(--accent-bright);
    box-shadow: 0 0 0 4px var(--accent-dim);
  }

  .g-child {
    background:
      linear-gradient(var(--line), var(--line)) no-repeat calc(var(--main) - 0.5px) 0 / 1px 100%,
      linear-gradient(var(--line-side), var(--line-side)) no-repeat calc(var(--side) - 0.5px) 0 / 1px 100%;
  }

  .g-child::after {
    left: calc(var(--side) - 4px);
    background: var(--accent-bright);
  }

  /* A wrapped label makes these rows taller than the 30px curve; the side
     lane fills the rest (below the fork's curve, above the join's). */
  .g-fork,
  .g-join {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 30px;
    padding-top: 4px;
    padding-bottom: 4px;
    background:
      linear-gradient(var(--line), var(--line)) no-repeat calc(var(--main) - 0.5px) 0 / 1px 100%,
