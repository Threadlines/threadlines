---
import { getPublishedChangelog } from "../lib/publishedChangelog";

import HelpFeatures, { type HelpIdea } from "../components/HelpFeatures.astro";
import HeroAgents from "../components/HeroAgents.astro";
import HeroWindow from "../components/HeroWindow.astro";
import Layout from "../layouts/Layout.astro";
import { AGENTS, isInStableRelease } from "../lib/agents";
import {
  changelogEntryPath,
  formatReleaseDate,
  latestStableVersion,
  sortChangelogEntries,
} from "../lib/changelog";
import { HERO_FIRST_THEME, heroThemeCss, heroThemes } from "../lib/heroThemes";
import threadsBoot from "virtual:threads-boot";
import "../styles/threads.css";
import {
  absoluteSiteUrl,
  APPLICATION_ID,
  DEFAULT_SITE_DESCRIPTION,
  ORGANIZATION_ID,
  SITE_GITHUB_URL,
  SITE_NAME,
  SITE_X_URL,
} from "../lib/site";

/*
 * Where the homepage's words live: the markup below (hero, captions, section
 * text), `ideas` and `tools` here, each hero theme's line and the ask typed in
 * its message box in lib/heroThemes.ts (SOURCES), the window's example thread
 * in components/HeroWindow.astro, and the Rooms, Threads and Fleet pieces in
 * components/HelpFeatures.astro.
 */
const changelog = await getPublishedChangelog();

// The hero names three agents and counts the rest of the logo row, in words.
const NUMBER_WORDS = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"];
const otherCount = AGENTS.length - 3;
const otherAgents = `${NUMBER_WORDS[otherCount] ?? otherCount} ${otherCount === 1 ? "other" : "others"}`;
const stableVersion = latestStableVersion(changelog);
const latestRelease = sortChangelogEntries(changelog)[0]!;

const appStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": APPLICATION_ID,
  name: SITE_NAME,
  alternateName: "Threadlines ADE",
  operatingSystem: "macOS 13 or later, Windows, Linux",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "Agentic development environment",
  softwareVersion: stableVersion,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: DEFAULT_SITE_DESCRIPTION,
  url: absoluteSiteUrl("/"),
  downloadUrl: absoluteSiteUrl("/download"),
  screenshot: absoluteSiteUrl("/Screenshots/rooms/rooms.webp"),
  featureList: [
    ...AGENTS.filter((agent) => isInStableRelease(agent, stableVersion)).map(
      (agent) => `Runs ${agent.name}`,
    ),
    "Several agents in one thread",
    "Agents start threads on your other computers",
    "Scheduled and event tasks",
    "Pull requests and CI checks beside the chat",
    "Built-in browser",
    "Source control and Git history",
    "Git worktrees per thread",
  ],
  license: "https://opensource.org/license/mit/",
  isAccessibleForFree: true,
  publisher: { "@id": ORGANIZATION_ID },
  sameAs: [SITE_GITHUB_URL, SITE_X_URL],
};

/** A recorded demo: `<base>.mp4` and `<base>.webp` for wide screens, `<base>-tall.*` for phones. */
interface Demo {
  base: string;
  seconds: number;
  label: string;
}


const demos = {
  rooms: {
    base: "/Screenshots/rooms/rooms",
    seconds: 46,
    label:
      "A Threadlines room. Opus 5.5 can't find why some customers are charged twice, so the user adds GPT-6.1-Sol. Sol finds the cause, Opus fixes it, and Sol checks the fix.",
  },
  threads: {
    base: "/Screenshots/threads/threads",
    seconds: 44,
    label:
      "Opus 5.5 asks to start three threads to find out why checkout got slow: Sonnet 5.5 times the payment service, GPT-6.1-Sol counts the database queries, and Opus 5.5 measures the page. The answers come back to Opus, and it fixes the cause.",
  },
  fleet: {
    base: "/Screenshots/fleet/fleet",
    seconds: 45,
    label:
      "Opus 5.5 on a MacBook Pro can't test a Windows-only screenshot bug, so it asks to start a thread on the Windows PC. GPT-6.1-Sol runs a probe there, Fleet shows both computers at work, and the answer comes back and changes Opus's plan.",
  },
} satisfies Record<string, Demo>;

const ideas: HelpIdea[] = [
  {
    id: "rooms",
    name: "Rooms",
    text: "Add another model to the thread. It reads the conversation so far, and your models can ask each other questions.",
    demo: demos.rooms,
  },
  {
    id: "threads",
    name: "Threads",
    text: "An agent can start a new thread on the model it needs and keep working while it waits for the answer.",
    demo: demos.threads,
  },
  {
    id: "fleet",
    name: "Fleet",
    text: "Link your Mac, Windows and Linux boxes. Agents can start threads across them, and Fleet tracks each one.",
    demo: demos.fleet,
  },
];

/** A still of the app (1600x934 unless given) and, when there is one, the clip it is the first frame of. */
interface ToolMedia {
  still: string;
  width: number;
  height: number;
  clip?: string;
  alt: string;
}

const tools: { id: string; name: string; text: string; media: ToolMedia }[] = [
  {
    id: "pull-requests",
    name: "Pull requests and CI",
    text: "Open the PR beside its thread, watch checks above the message box, and merge when they pass.",
    media: {
      still: "/Screenshots/stable-launch/pull-requests.webp",
      clip: "/Screenshots/stable-launch/pull-requests.mp4",
      width: 1600,
      height: 934,
      alt: "A thread with its pull request open beside it: the description, two running checks and a review comment.",
    },
  },
  {
    id: "browser",
    name: "Built-in browser",
    text: "Open your app in a panel next to the chat, so you and the agent see the same page.",
    media: {
      still: "/Screenshots/stable-launch/browser.webp",
      clip: "/Screenshots/stable-launch/browser.mp4",
      width: 1600,
      height: 934,
      alt: "A thread with the built-in browser beside it, showing the site the agent is working on.",
    },
  },
  {
    id: "source-control",
    name: "Git changes and history",
    text: "See what each turn changed, stage and commit it, and read the history without leaving the thread.",
    media: {
      still: "/Screenshots/stable-launch/source-control.webp",
      clip: "/Screenshots/stable-launch/source-control.mp4",
      width: 1600,
      height: 934,
      alt: "A thread with the Source panel beside it: staged changes, a commit button and the branch's history.",
    },
  },
  {
    id: "context",
    name: "Files and context",
    text: "Select lines in a file, the terminal or a reply, and attach them to your next message.",
    media: {
      still: "/Screenshots/stable-launch/context.webp",
      clip: "/Screenshots/stable-launch/context.mp4",
      width: 1600,
      height: 934,
      alt: "A file open over the thread, with a button to attach it to the next message.",
    },
  },
  {
    id: "scheduled",
    name: "Scheduled and event tasks",
    text: "Run a prompt every weekday at 9, or when a GitHub issue gets a label.",
    media: {
      still: "/Screenshots/app/scheduled.webp",
      width: 2400,
      height: 1401,
      alt: "The Scheduled page: a morning commit review on weekdays, a weekly dependency check, bug triage when an issue gets a label, and nightly Windows tests.",
    },
  },
  {
    id: "provider-switch",
    name: "Switch agents mid-thread",
    text: "Move a thread from Claude Code to Codex and keep the conversation and your changes.",
    media: {
      still: "/Screenshots/stable-launch/provider-switch.webp",
      clip: "/Screenshots/stable-launch/provider-switch.mp4",
      width: 1600,
      height: 934,
      alt: "A thread moved to another agent, with the conversation and the model picker in place.",
    },
  },
];

const themes = heroThemes();
const heroLabel =
  "The Threadlines window. The thread Double charges at checkout is open: Opus 5.5 can't reproduce the bug, so the user adds GPT-6.1-Sol, which answers on the side that the payment succeeds, the reply times out, and retry.ts has no idempotency key.";
// Applies a stored pick, or the scheme's first theme, before first paint.
const heroPrepaint = `(() => {
  const ids = ${JSON.stringify(themes.map((theme) => theme.id))};
  const first = ${JSON.stringify(HERO_FIRST_THEME)};
  const root = document.documentElement;
  let pick = null;
  try { pick = localStorage.getItem("tl-hero-theme"); } catch {}
  if (!ids.includes(pick)) {
    const forced = root.dataset.theme;
    const dark = forced ? forced === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    pick = first[dark ? "dark" : "light"];
  }
  root.dataset.heroTheme = pick;
})();`;

const playIcon = `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4.5 2.8v10.4L13 8z"/></svg>`;
const appleIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>`;
const windowsIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h8.5v8.5H3zM12.5 3H21v8.5h-8.5zM3 12.5h8.5V21H3zM12.5 12.5H21V21h-8.5z"/></svg>`;
const linuxIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm2.94 4.3 4 3.06a.9.9 0 0 1 0 1.43l-4 3.06a.9.9 0 1 1-1.1-1.43L9 11.07 5.84 8.73A.9.9 0 1 1 6.94 7.3ZM12.5 14.4h4.7a.9.9 0 1 1 0 1.8h-4.7a.9.9 0 1 1 0-1.8Z"/></svg>`;
---

<Layout
  title="Threadlines ADE: desktop app for Claude Code, Codex and more"
  description="A free, open-source ADE for Claude Code, Codex, OpenCode, Cursor and more. Put several agents in one thread, with pull requests, a browser and Git in view."
  canonicalPath="/"
  structuredData={[appStructuredData]}
>
  <svg slot="page-art" class="nt-spine" aria-hidden="true"></svg>
  <Fragment slot="head">
    <script is:inline set:html={heroPrepaint} />
    <style is:inline set:html={heroThemeCss(themes)} />
  </Fragment>

  <section class="hero nt-hero" aria-labelledby="hero-title">
    <!-- The nine threads: drawn by the inline script at the end of this section. -->
    <svg class="nt-hero-art" aria-hidden="true"></svg>
    <div class="wrap hero-head">
      <h2 class="sr-only">Agents Threadlines runs</h2>
      <HeroAgents />
      <h1 id="hero-title" class="rise" style="--d: 60ms">A desktop app for every coding agent you&nbsp;use.</h1>
      <p class="hero-sub rise" style="--d: 120ms">
        Run Claude&nbsp;Code, Codex, OpenCode and {otherAgents} in one window. Put more than one model
        in a thread. It's free and open source.
      </p>
      <div class="hero-cta rise" style="--d: 180ms">
        <a class="btn" id="pv-download" href="/download"
          ><span class="btn-ico" id="pv-dl-mac" hidden set:html={appleIcon} /><span
            class="btn-ico"
            id="pv-dl-win"
            hidden
            set:html={windowsIcon}
          /><span id="pv-dl-label">Download Threadlines</span></a
        >
        <a class="release" href={changelogEntryPath(latestRelease)}
          >New in {latestRelease.data.version}{latestRelease.data.headline ? `: ${latestRelease.data.headline}` : ""}</a
        >
      </div>
    </div>

    <div class="wrap hero-window rise" style="--d: 240ms">
      <HeroWindow themes={themes} label={heroLabel} />
    </div>
    <!-- Inline, so the threads start drawing as the hero paints (src/scripts/threads/boot.ts). -->
    <script is:inline set:html={threadsBoot} />
  </section>

  <section class="section band nt-help" aria-labelledby="help-title">
    <div class="wrap nt-in">
      <header class="spread-head">
        <h2 id="help-title">Get help without losing the thread</h2>
        <p class="lede">
          Add another model to the chat, split work into new threads, or run a task on another computer.
          Every answer comes back to the thread you started in.
        </p>
      </header>

      <HelpFeatures ideas={ideas} />
      <p class="journey-cap">An example workflow. By default, an agent asks before it starts a new thread.</p>
    </div>
  </section>

  <section class="section tools-sec" aria-labelledby="tools-title">
    <div class="wrap nt-in">
      <h2 id="tools-title">Everything else, beside the chat</h2>
      <div class="tools">
        <fieldset class="tool-list">
          <legend class="sr-only">Pick a tool to see it</legend>
          {
            tools.map((tool, index) => (
              <label class="tool" data-tool={tool.id}>
                <input type="radio" name="tool" value={tool.id} checked={index === 0} />
                <span class="tool-name">{tool.name}</span>
                <span class="tool-text">{tool.text}</span>
              </label>
            ))
          }
        </fieldset>
        <div class="tool-stage">
          {
            tools.map((tool, index) => (
              <figure class="still tool-still" data-for-tool={tool.id} hidden={index !== 0}>
                <img
                  data-src={tool.media.still}
                  width={tool.media.width}
                  height={tool.media.height}
                  alt={tool.media.alt}
                  decoding="async"
                />
                {index === 0 && (
                  <noscript>
                    <img src={tool.media.still} width={tool.media.width} height={tool.media.height} alt={tool.media.alt} />
                  </noscript>
                )}
                {tool.media.clip && (
                  <button class="still-play" type="button" data-clip={tool.media.clip} aria-label={`Play: ${tool.name}`}>
                    <span set:html={playIcon} />
                  </button>
                )}
              </figure>
            ))
          }
        </div>
      </div>
      <a class="more" href="/changelog">See what changed in every release <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <section class="section own-sec" aria-labelledby="own-title">
    <div class="wrap nt-in">
      <div class="own">
        <div class="own-copy">
          <h2 id="own-title">Your machine, your accounts</h2>
          <p class="lede">
            Threadlines runs on your computer and uses the Claude, Codex and other agent accounts you already
            pay for. You don't need a Threadlines account. The code is MIT-licensed and began as a fork of
            T3&nbsp;Code.
          </p>
          <a class="btn" href="/download">Download Threadlines</a>
        </div>
        <dl class="facts">
          <div>
            <dt>Latest</dt>
            <dd>
              <a href={changelogEntryPath(latestRelease)}
                >{latestRelease.data.version}, {formatReleaseDate(latestRelease.data.date)}</a
              >
            </dd>
          </div>
          <div>
            <dt>Runs on</dt>
            <dd class="os">
              <span><span class="os-ico" set:html={appleIcon} />macOS 13 or later</span>
              <span><span class="os-ico" set:html={windowsIcon} />Windows</span>
              <span><span class="os-ico" set:html={linuxIcon} />Linux</span>
            </dd>
          </div>
          <div>
            <dt>Price</dt>
            <dd>Free</dd>
          </div>
          <div>
            <dt>License</dt>
            <dd>MIT</dd>
          </div>
          <div>
            <dt>Source</dt>
            <dd>
              <a href={SITE_GITHUB_URL} target="_blank" rel="noopener noreferrer"
                >github.com/<wbr />Threadlines/<wbr />threadlines</a
              >
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
  <!-- The trunk and the panels start once their markup exists. -->
  <script is:inline>window.tlThreads?.lower();</script>

  <dialog class="viewer" id="demo-viewer" aria-labelledby="viewer-title">
    <form method="dialog" class="viewer-bar">
      <span id="viewer-title"></span>
      <button class="viewer-close" type="submit">Close</button>
    </form>
    <div class="viewer-stage"></div>
  </dialog>
</Layout>

<script>
  import { detectDevice, detectMacArch, isTouchOnly, type MacArch } from "../lib/platform";
  import { classifyAssets, fetchLatestRelease, pickInstaller } from "../lib/releases";

  const dl = document.getElementById("pv-download") as HTMLAnchorElement | null;
  if (dl) {
    const device = detectDevice(navigator, isTouchOnly(window));
    const label = document.getElementById("pv-dl-label")!;
    // deep-link the button straight to the installer; /download stays the fallback
    const linkInstaller = (macArch?: MacArch) =>
      fetchLatestRelease()
        .then((release) => {
          const asset = pickInstaller(classifyAssets(release.assets), device, macArch);
          if (asset) dl.href = asset.browser_download_url;
        })
        .catch(() => {});
    if (device === "windows") {
      label.textContent = "Download for Windows";
      document.getElementById("pv-dl-win")!.hidden = false;
      linkInstaller();
    } else if (device === "linux") {
      label.textContent = "Download for Linux";
      linkInstaller();
    } else if (device === "mac") {
      document.getElementById("pv-dl-mac")!.hidden = false;
      // Only Chromium says which chip a Mac has; elsewhere the visitor chooses on /download.
      detectMacArch(navigator).then((macArch) => {
        label.textContent = macArch ? "Download for macOS" : "Choose a macOS download";
        if (macArch) linkInstaller(macArch);
      });
    } else if (device === "mobile") {
      label.textContent = "Get it on your computer";
    }
  }

  const tall = window.matchMedia("(max-width: 640px)");

  // Demos open in a dialog; the video is made on click, so nothing loads before.
  const viewer = document.getElementById("demo-viewer") as HTMLDialogElement | null;
  const stage = viewer?.querySelector<HTMLElement>(".viewer-stage");
  const title = document.getElementById("viewer-title");
  if (viewer && stage && title) {
    for (const watch of document.querySelectorAll<HTMLButtonElement>(".watch")) {
      watch.addEventListener("click", () => {
        const base = `${watch.dataset.demo}${tall.matches ? "-tall" : ""}`;
        const video = document.createElement("video");
        video.className = "viewer-video";
        video.muted = true;
        video.playsInline = true;
        video.controls = true;
        video.poster = `${base}.webp`;
        video.width = tall.matches ? 800 : 1600;
        video.height = tall.matches ? 1000 : 934;
        video.setAttribute("aria-label", watch.dataset.label ?? "");
        const source = document.createElement("source");
        source.src = `${base}.mp4`;
        source.type = "video/mp4";
        video.append(source);
        stage.replaceChildren(video);
        title.textContent = watch.dataset.title ?? "";
        viewer.showModal();
        video.play().catch(() => {});
      });
    }
    viewer.addEventListener("click", (event) => {
      if (event.target === viewer) viewer.close();
    });
    viewer.addEventListener("close", () => stage.replaceChildren());
  }

  // The tools picker: picking one shows its still; Play swaps the still for its clip.
  // A still loads when it is picked, or when the section comes near the screen.
  const showStill = (figure: HTMLElement) => {
    const img = figure.querySelector<HTMLImageElement>("img[data-src]");
    if (img?.dataset.src && !img.getAttribute("src")) img.src = img.dataset.src;
  };
  const toolStage = document.querySelector<HTMLElement>(".tool-stage");
  if (toolStage) {
    const near = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        const shown = toolStage.querySelector<HTMLElement>("[data-for-tool]:not([hidden])");
        if (shown) showStill(shown);
        near.disconnect();
      },
      { rootMargin: "400px 0px" },
    );
    near.observe(toolStage);
  }
  for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="tool"]')) {
    radio.addEventListener("change", () => {
      if (!radio.checked) return;
      for (const figure of document.querySelectorAll<HTMLElement>("[data-for-tool]")) {
        const shown = figure.dataset.forTool === radio.value;
        figure.hidden = !shown;
        if (shown) showStill(figure);
        else figure.querySelector("video")?.pause();
      }
    });
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>(".still-play")) {
    button.addEventListener("click", () => {
      const figure = button.closest("figure");
      const still = figure?.querySelector("img");
      if (!figure || !still || !button.dataset.clip) return;
      const video = document.createElement("video");
      video.controls = true;
      video.muted = true;
      video.playsInline = true;
      video.width = still.width;
      video.height = still.height;
      video.poster = still.currentSrc || still.src;
      video.setAttribute("aria-label", still.alt);
      const source = document.createElement("source");
      source.src = button.dataset.clip;
      source.type = "video/mp4";
      video.append(source);
      still.replaceWith(video);
      button.remove();
      video.play().catch(() => {});
      video.focus();
    });
  }
</script>

<style>
  /* Three sizes below the hero: headings, body, small. */
  .hero,
  .section {
    --text-h: clamp(2rem, 3.4vw, 2.75rem);
    --text-b: 1.125rem;
    --text-s: 0.875rem;
    font-size: var(--text-b);
    line-height: 1.55;
  }

  .wrap {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  h2 {
    font-size: var(--text-h);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
  }

  h3 {
    font-size: var(--text-b);
    font-weight: 600;
    line-height: 1.55;
  }

  .journey-cap {
    position: relative;
    z-index: 2;
    margin-top: 40px;
    font-size: var(--text-s);
    color: var(--fg-muted);
  }

  .lede {
    max-width: 36em;
    margin-top: 18px;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .section {
    padding-block: clamp(80px, 9vw, 128px);
  }

  .band {
    background: var(--bg-elev);
  }

  /* ---- Hero ------------------------------------------------------------ */

  /*
   * The hero: the text sits in a fixed clearing and the threads fall either
   * side of it (scripts/threads). --clear is the clearing's width; --pitch and
   * --chip size the agents' logos (components/HeroAgents.astro).
   */
  .hero {
    --h1: clamp(2.25rem, 2.9vw + 16px, 3.625rem);
    --clear: calc(var(--h1) * 11.2 + 88px);
    --pitch: min(52px, calc((100vw - 40px) / 9));
    --chip: min(42px, calc(var(--pitch) - 6px));
    position: relative;
    text-align: center;
    padding-top: 14px;
  }

  .nt-hero-art {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }

  /* An agent hovered or focused: its thread comes forward, the others dim. */
  .nt-hero-art :global(.nt-s) {
    transition: opacity 0.22s var(--ease);
  }

  .nt-hero-art[data-active] :global(.nt-s) {
    opacity: 0.16;
  }

  .nt-hero-art[data-active] :global(.nt-s.on) {
    opacity: 1;
  }

  .hero-head,
  .hero-window {
    position: relative;
    z-index: 2;
  }

  /* The threads beside the text can be plucked; the text, links and buttons stay what they are. */
  .hero-head {
    pointer-events: none;
  }

  .hero-head :global(a),
