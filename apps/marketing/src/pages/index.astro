  /*
   * The example thread, drawn like a commit graph. The main thread runs down
   * x = 8px and a started thread down x = 30px. Lines are background
   * gradients, so rows can wrap to any height; the fork and join curves are
   * fixed 40x30 SVGs drawn on the same two lanes.
   */
  .graph {
    --main: 8px;
    --side: 30px;
    --line: var(--line-dim);
    --line-side: var(--accent-soft);
    --dot: var(--fg-dim);
    list-style: none;
    font-size: 0.875rem;
    line-height: 22px;
  }

  .g-row,
  .g-fork,
  .g-join {
    position: relative;
    padding-left: 52px;
