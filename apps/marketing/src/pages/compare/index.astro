---
import KitFrame from "../../components/kit/KitFrame.astro";
import ThreadlinesGlyph from "../../components/ThreadlinesGlyph.astro";
import Layout from "../../layouts/Layout.astro";
import { comparisonPath, COMPARISONS } from "../../lib/comparisons";
import { absoluteSiteUrl, ORGANIZATION_ID } from "../../lib/site";

// Search snippets cut off long lists, so the title and description name the first few apps.
const leadNames = COMPARISONS.slice(0, 3).map((comparison) => comparison.name);
const title = `Alternatives to ${leadNames.slice(0, 2).join(", ")} and more | Threadlines`;
const description = `Alternatives to ${leadNames.join(", ")} and ${COMPARISONS.length - leadNames.length} more coding agent apps, side by side with Threadlines, including where they're ahead.`;
const formatDate = (isoDate: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(isoDate));

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: absoluteSiteUrl("/compare"),
    publisher: { "@id": ORGANIZATION_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: COMPARISONS.map((comparison, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: `Threadlines vs ${comparison.name}`,
        url: absoluteSiteUrl(comparisonPath(comparison)),
      })),
    },
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/compare"
  structuredData={structuredData}
>
  <KitFrame line="ink" as="section">
    <header class="k-head">
      <h1 class="k-h1 k-rise" data-k-node data-k-start>Coding agent app alternatives, side by side</h1>
      <p class="k-lede k-rise" style="--d: 80ms">
        How Threadlines stacks up against other apps for running coding agents, including where
        they're ahead. We check every page against the other app's own site, and the ones that are
        changing hands or winding down say what happens and when.
      </p>
    </header>

    <ul class="k-rows comparisons">
      {
        COMPARISONS.map((comparison) => (
          <li>
            <a href={comparisonPath(comparison)}>
              <span class="k-row-name lockup" data-k-node="small">
                <ThreadlinesGlyph class="lockup-glyph" />
                <span class="lockup-vs">vs</span>
                <span>{comparison.name}</span>
              </span>
              <span class="k-row-text">{comparison.summary}</span>
              <span class="k-meta checked">
                <span>
                  {comparison.status && `${comparison.status.label} · `}
                  Checked {formatDate(comparison.checkedOn)}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="k-small more">
      Looking for a specific agent? See <a href="/agents">every agent Threadlines runs</a>.
    </p>
  </KitFrame>
</Layout>

<style>
  .comparisons {
    margin-top: clamp(56px, 7vw, 88px);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.1875rem;
    letter-spacing: -0.015em;
  }

  .lockup :global(.lockup-glyph) {
    width: auto;
    height: 16px;
  }

  .lockup-vs {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--k-s);
    font-weight: 400;
  }

  .checked {
    margin-top: 4px;
  }

  .checked > span {
    color: var(--fg-muted);
    font-weight: 400;
  }

  .more {
    margin-top: clamp(40px, 5vw, 56px);
  }
</style>
