---
import Faq from "../../components/Faq.astro";
import KitFrame from "../../components/kit/KitFrame.astro";
import KitHeading from "../../components/kit/KitHeading.astro";
import Icon from "../../components/Icon.astro";
import ThreadlinesGlyph from "../../components/ThreadlinesGlyph.astro";
import Layout from "../../layouts/Layout.astro";
import {
  comparisonPath,
  COMPARISONS,
  type Comparison,
  type ComparisonCell,
  type ComparisonMark,
} from "../../lib/comparisons";
import type { IconName } from "../../lib/icons";
import { absoluteSiteUrl, APPLICATION_ID, ORGANIZATION_ID, SITE_GITHUB_URL } from "../../lib/site";

export function getStaticPaths() {
  return COMPARISONS.map((comparison) => ({
    params: { slug: comparison.slug },
    props: { comparison },
  }));
}

interface Props {
  comparison: Comparison;
}

const { comparison } = Astro.props;
const canonicalPath = comparisonPath(comparison);
const others = COMPARISONS.filter((other) => other.slug !== comparison.slug);
const checkedOn = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(comparison.checkedOn));

const { status, switching } = comparison;

/** Splits text on backticks so the code inside them can be set in mono. */
const codeSpans = (text: string) =>
  text.split("`").map((part, index) => ({ text: part, code: index % 2 === 1 }));

const markIcon: Record<ComparisonMark, IconName> = { yes: "check", partial: "partial", no: "minus" };
const markLabel: Record<ComparisonMark, string> = { yes: "Yes", partial: "Partly", no: "No" };
const cells = (row: Comparison["rows"][number]): ComparisonCell[] => [row.threadlines, row.other];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: comparison.title,
    description: comparison.description,
    url: absoluteSiteUrl(canonicalPath),
    dateModified: comparison.checkedOn,
    about: { "@id": APPLICATION_ID, "@type": "SoftwareApplication", name: "Threadlines" },
    mentions: {
      "@type": "SoftwareApplication",
      name: comparison.name,
      creator: { "@type": "Organization", name: comparison.maker },
    },
    publisher: { "@id": ORGANIZATION_ID },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: comparison.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Compare", item: absoluteSiteUrl("/compare") },
      {
        "@type": "ListItem",
        position: 2,
        name: `Threadlines vs ${comparison.name}`,
        item: absoluteSiteUrl(canonicalPath),
      },
    ],
  },
];
---

<Layout
  title={comparison.title}
  description={comparison.description}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
>
  <KitFrame line="ink">
    <header class="k-head">
      <a class="k-back k-rise" href="/compare"><span aria-hidden="true">←</span> All comparisons</a>
      <p class="lockup k-rise" style="--d: 40ms">
        <ThreadlinesGlyph class="lockup-glyph" />
        <span>Threadlines</span>
        <span class="lockup-vs">vs</span>
        <span>{comparison.name}</span>
      </p>
      <h1 class="k-h1 k-rise" style="--d: 60ms" data-k-node data-k-start>{comparison.headline}</h1>
      <p class="k-lede k-rise" style="--d: 120ms">{comparison.intro}</p>
      <div class="k-actions k-rise" style="--d: 180ms">
        <a class="btn" href="/download">
          <Icon name="download" /> Download Threadlines
        </a>
        {
          switching && (
            <a class="k-link" href="#switching">
              How to move from {comparison.name} <span aria-hidden="true">↓</span>
            </a>
          )
        }
        <a class="k-link" href={SITE_GITHUB_URL} target="_blank" rel="noopener noreferrer">
          View the source on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <figure class="k-shot k-rise" style="--d: 240ms">
      <div class="k-still">
        <img
          src="/Screenshots/app/two-agents.webp"
          alt="Threadlines with a full sidebar of projects and threads, and two agents working on the same bug in one thread"
          width="2400"
          height="1401"
          decoding="async"
        />
      </div>
      <figcaption class="k-cap">
        Claude's Opus keeps working while Codex's GPT-6.1-Sol answers a question on the side.
      </figcaption>
    </figure>

    {
      status && (
        <section class="k-sec">
          <KitHeading>{status.heading}</KitHeading>
          <p class="status-text">{status.text}</p>
          <ol class="dates">
            {status.timeline.map((item) => (
              <li>
                <span class="dates-when">{item.date}</span>
                <span>{item.text}</span>
              </li>
            ))}
          </ol>
          <a
            class="k-link status-link"
            href={status.announcement.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {status.announcement.label} <span aria-hidden="true">↗</span>
          </a>
        </section>
      )
    }

    <section class="k-sec">
      <KitHeading>Feature by feature</KitHeading>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col">
                <span class="column-brand">
                  <ThreadlinesGlyph class="column-glyph" />
                  Threadlines
                </span>
              </th>
              <th scope="col">{comparison.name}</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.rows.map((row) => (
                <tr>
                  <th scope="row">
                    <span class="label">
                      <Icon name={row.icon} class="label-icon" />
                      {row.label}
                    </span>
                  </th>
                  {cells(row).map((cell) => (
                    <td>
                      <span class="cell">
                        {cell.mark && (
                          <span class={`mark mark-${cell.mark}`}>
                            <Icon name={markIcon[cell.mark]} />
                            <span class="sr-only">{markLabel[cell.mark]}:</span>
                          </span>
                        )}
                        <span>{cell.text}</span>
                      </span>
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- The two lists stand side by side from 820px: one stop on the line for the pair. -->
    <section class="k-sec k-pair">
      <div>
        <KitHeading>Pick Threadlines if</KitHeading>
        <ul class="k-ticks">
          {
            comparison.pickThreadlines.map((reason) => (
              <li>
                <Icon name="check" class="pick-ours" />
                {reason}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <KitHeading node={false}>Pick {comparison.name} if</KitHeading>
        <ul class="k-ticks">
          {
            comparison.pickOther.map((reason) => (
              <li>
                <Icon name="check" />
                {reason}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      switching && (
        <section class="k-sec switching" id="switching">
          <KitHeading>{switching.heading}</KitHeading>
          <ol class="moves">
            {switching.steps.map((step) => (
              <li>
                <h3 class="k-h3">{step.title}</h3>
                <p>
                  {codeSpans(step.text).map((span) =>
                    span.code ? <code class="k-code">{span.text}</code> : span.text,
                  )}
                </p>
              </li>
            ))}
          </ol>
          <h3 class="k-h3 left-heading">{switching.leftBehindHeading}</h3>
          <ul class="k-ticks left">
            {switching.leftBehind.map((item) => (
              <li>
                <Icon name="minus" />
                <span>
                  {codeSpans(item).map((span) =>
                    span.code ? <code class="k-code">{span.text}</code> : span.text,
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="k-sec">
      <KitHeading>Questions</KitHeading>
      <Faq items={comparison.faq} />
    </section>

    <section class="k-sec sources">
      <p class="k-small">
        We checked these facts about {comparison.name} on {checkedOn}, against{" "}
        {
          comparison.sources.map((source, index) => (
            <>
              {index > 0 && (index === comparison.sources.length - 1 ? " and " : ", ")}
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.label}
              </a>
            </>
          ))
        }
        . Something out of date?{" "}
        <a href={`${SITE_GITHUB_URL}/issues`} target="_blank" rel="noopener noreferrer">
          Open an issue
        </a>{" "}
        and we'll fix it.
      </p>
      <p class="k-small">
        See every <a href="/agents">agent Threadlines runs</a>
        {
          others.map((other) => (
            <>
              {", or "}
              <a href={comparisonPath(other)}>Threadlines vs {other.name}</a>
            </>
          ))
        }
        .
      </p>
      <p class="k-small">
        {comparison.name} is made by {comparison.maker}. Threadlines is an independent open-source
        project and isn't affiliated with or endorsed by {comparison.maker}.
      </p>
    </section>
  </KitFrame>
</Layout>

<style>
  .lockup {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .lockup + :global(.k-h1) {
    margin-top: 16px;
  }

  .lockup :global(.lockup-glyph) {
    width: auto;
    height: 18px;
  }

  .lockup-vs {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--k-s);
    font-weight: 400;
  }

  .status-text {
    max-width: 64ch;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .dates {
    max-width: 64ch;
    margin: 20px 0 18px;
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .dates li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: var(--k-s);
    line-height: 1.55;
  }

  .dates-when {
    color: var(--fg);
    font-family: var(--font-mono);
  }

  .status-link {
    font-size: var(--k-s);
  }

  .column-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .k-table :global(.column-glyph) {
    width: auto;
    height: 13px;
  }

  .label {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
  }

  .k-table :global(.label-icon) {
    flex: none;
    margin-top: 2px;
    color: var(--fg-muted);
    font-size: 17px;
  }

  .cell {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .mark {
    display: inline-flex;
    flex: none;
    margin-top: 2px;
    font-size: 16px;
  }

  .mark-yes {
    color: var(--ok);
  }

  .mark-partial {
    color: var(--warn);
  }

  .mark-no {
    color: var(--fg-faint);
  }

  /* Our reasons carry the accent; theirs stay muted, so the two lists read apart. */
  .k-pair :global(.pick-ours) {
    color: var(--accent);
  }

  /* The hero's jump link lands here; keep the heading clear of the nav. */
  .switching {
    scroll-margin-top: 24px;
  }

  .moves {
    max-width: 68ch;
    list-style: none;
    counter-reset: move;
    border-bottom: 1px solid var(--border);
  }

  .moves li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    padding: 16px 0 18px;
    border-top: 1px solid var(--border);
    counter-increment: move;
  }

  .moves li::before {
    grid-row: span 2;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--k-s);
    line-height: 1.7;
    content: counter(move);
  }

  .moves p {
    margin-top: 2px;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .left-heading {
    margin-top: 40px;
  }

  .left {
    max-width: 68ch;
    margin-top: 14px;
  }

  .sources {
    display: grid;
    gap: 12px;
    max-width: 72ch;
  }

  @media (width <= 640px) {
    .k-table :global(.label-icon) {
      display: none;
    }

    .dates li {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
  }
</style>
