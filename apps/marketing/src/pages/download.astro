---
import { getPublishedChangelog } from "../lib/publishedChangelog";

import KitFrame from "../components/kit/KitFrame.astro";
import Layout from "../layouts/Layout.astro";
import { AGENTS, isInStableRelease } from "../lib/agents";
import { latestStableVersion } from "../lib/changelog";

// The setup screenshot comes from the next release; name the agents that aren't in this download yet.
const stableVersion = latestStableVersion(await getPublishedChangelog());
const upcomingAgents = AGENTS.filter((agent) => !isInStableRelease(agent, stableVersion));
const upcomingVersions = [...new Set(upcomingAgents.map((agent) => agent.since))];
const upcomingNote =
  upcomingAgents.length > 0 && upcomingVersions.length === 1
    ? `${new Intl.ListFormat("en", { type: "conjunction" }).format(upcomingAgents.map((agent) => agent.name))} ${upcomingAgents.length === 1 ? "arrives" : "arrive"} in version ${upcomingVersions[0]}.`
    : null;
---

<Layout
  title="Download Threadlines for Mac, Windows and Linux"
  description="Download Threadlines, the free, open-source ADE for Claude Code, Codex and other coding agents. For macOS (Apple Silicon and Intel), Windows and Linux."
  canonicalPath="/download"
>
  <KitFrame line="ink" region={false} as="section">
    <!-- The trunk runs from the title into the first download button shown (data-k-end). -->
    <div class="dl-inner" data-k-region="ink">
      <h1 class="k-h1 k-rise dl-title" data-k-node data-k-start>Download Threadlines</h1>
      <p class="k-lede dl-sub" id="dl-version">Fetching the latest release…</p>

      <div class="dl-primary-wrap">
        <a class="btn dl-primary" id="dl-primary" href="#" data-k-end hidden>
          <span class="dl-ico" id="dl-ico-mac"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg></span>
          <span class="dl-ico" id="dl-ico-win" hidden><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h8.5v8.5H3zM12.5 3H21v8.5h-8.5zM3 12.5h8.5V21H3zM12.5 12.5H21V21h-8.5z"/></svg></span>
          <span class="dl-ico" id="dl-ico-linux" hidden><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm2.94 4.3 4 3.06a.9.9 0 0 1 0 1.43l-4 3.06a.9.9 0 1 1-1.1-1.43L9 11.07 5.84 8.73A.9.9 0 1 1 6.94 7.3ZM12.5 14.4h4.7a.9.9 0 1 1 0 1.8h-4.7a.9.9 0 1 1 0-1.8Z"/></svg></span>
          <span id="dl-primary-label">Download</span>
          <span class="dl-primary-size" id="dl-primary-size"></span>
        </a>
        <button class="btn dl-primary" id="dl-share" type="button" data-k-end hidden>Send the link to yourself</button>
        <p class="dl-hint" id="dl-mac-hint" hidden>
          Not sure which one? Open the Apple menu, then About This Mac. "Chip" means Apple
          Silicon. "Processor" means Intel.
        </p>
        <p class="dl-hint" id="dl-mobile-hint" hidden>
          <button class="dl-link" id="dl-show-installers" type="button">Show the installers anyway</button>
        </p>
      </div>

      <div class="dl-list" id="dl-list" hidden>
        <div class="dl-row" data-slot="macArm">
          <span class="dl-row-name"><span class="dl-row-ico"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg></span>macOS · Apple Silicon</span>
          <span class="dl-row-size"></span>
          <a class="dl-link" href="#">Download .dmg</a>
        </div>
        <div class="dl-row" data-slot="macX64">
          <span class="dl-row-name"><span class="dl-row-ico"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg></span>macOS · Intel</span>
          <span class="dl-row-size"></span>
          <a class="dl-link" href="#">Download .dmg</a>
        </div>
        <div class="dl-row" data-slot="winX64">
          <span class="dl-row-name"><span class="dl-row-ico"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h8.5v8.5H3zM12.5 3H21v8.5h-8.5zM3 12.5h8.5V21H3zM12.5 12.5H21V21h-8.5z"/></svg></span>Windows · x64</span>
          <span class="dl-row-size"></span>
          <a class="dl-link" href="#">Download .exe</a>
        </div>
        <div class="dl-row" data-slot="winArm">
          <span class="dl-row-name"><span class="dl-row-ico"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h8.5v8.5H3zM12.5 3H21v8.5h-8.5zM3 12.5h8.5V21H3zM12.5 12.5H21V21h-8.5z"/></svg></span>Windows · ARM64</span>
          <span class="dl-row-size"></span>
          <a class="dl-link" href="#">Download .exe</a>
        </div>
        <div class="dl-row" data-slot="linuxX64">
          <span class="dl-row-name"><span class="dl-row-ico"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm2.94 4.3 4 3.06a.9.9 0 0 1 0 1.43l-4 3.06a.9.9 0 1 1-1.1-1.43L9 11.07 5.84 8.73A.9.9 0 1 1 6.94 7.3ZM12.5 14.4h4.7a.9.9 0 1 1 0 1.8h-4.7a.9.9 0 1 1 0-1.8Z"/></svg></span>Linux · x64</span>
          <span class="dl-row-size"></span>
          <a class="dl-link" href="#">Download .AppImage</a>
        </div>
      </div>

      <div id="dl-fallback" hidden>
        <div class="dl-panel">
          <p class="dl-panel-title">Direct downloads</p>
          <p class="dl-panel-text">
            GitHub's API didn't answer just now. No problem: every installer is one click
            away on the releases page.
          </p>
          <a
            class="btn dl-primary"
            data-k-end
            href="https://github.com/Threadlines/threadlines/releases/latest"
            target="_blank"
            rel="noopener noreferrer"><span class="dl-ico"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg></span>Download from GitHub</a
          >
          <div class="dl-panel-rows">
            <span><i>›</i> macOS · Apple Silicon and Intel · <code>.dmg</code></span>
            <span><i>›</i> Windows · x64 · <code>.exe</code></span>
            <span><i>›</i> Linux · x64 · <code>.AppImage</code></span>
          </div>
        </div>
      </div>

      <noscript>
        <p class="k-small dl-noscript">
          Grab any installer from
          <a class="dl-link" href="https://github.com/Threadlines/threadlines/releases/latest"
            >GitHub Releases</a
          >.
        </p>
      </noscript>

      <p class="k-small dl-note">
        Signed and notarized for macOS 13 or later · Signed for Windows · AppImage for Linux · All releases and checksums on&nbsp;<a
          class="dl-link"
          href="https://github.com/Threadlines/threadlines/releases/latest"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </p>
    </div>
    <section class="k-sec dl-onboarding" aria-labelledby="dl-onboarding-title">
      <h2 class="k-h2" id="dl-onboarding-title">From setup to your first thread</h2>
      <p class="k-lede" id="dl-onboarding-description">
          Pick the agents you use, connect them, and choose a folder. Then start your first thread.
        {upcomingNote && ` ${upcomingNote}`}
      </p>
      <div class="k-still">
        <img
          src="/Screenshots/app/onboarding.webp"
          alt="Threadlines setup asking which agents you use, with Codex, Claude, fx, Cursor, OpenCode, Antigravity, Muse Code, Grok and Pi to pick from"
          width="2400"
          height="1401"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>
  </KitFrame>
</Layout>

<script>
  import { detectDevice, detectMacArch, isTouchOnly } from "../lib/platform";
  import {
    classifyAssets,
    fetchLatestRelease,
    formatAssetSize,
    pickInstaller,
  } from "../lib/releases";
  import { absoluteSiteUrl } from "../lib/site";

  const versionEl = document.getElementById("dl-version")!;
  const primary = document.getElementById("dl-primary") as HTMLAnchorElement;
  const primaryLabel = document.getElementById("dl-primary-label")!;
  const primarySize = document.getElementById("dl-primary-size")!;
  const macHint = document.getElementById("dl-mac-hint")!;
  const list = document.getElementById("dl-list")!;
  const fallback = document.getElementById("dl-fallback")!;

  const device = detectDevice(navigator, isTouchOnly(window));
  const isMobile = device === "mobile";

  if (isMobile) {
    // A phone or tablet can't install Threadlines: offer the link to pass along,
    // and keep the installers one tap away in case the detection is wrong.
    const page = versionEl.closest(".dl-inner")!;
    const share = document.getElementById("dl-share") as HTMLButtonElement;
    const mobileHint = document.getElementById("dl-mobile-hint")!;
    const url = absoluteSiteUrl("/download");
    const about = "Threadlines is a desktop app for macOS, Windows, and Linux.";
    const openIt = "Open threadlines.dev/download on your computer";
    const canShare = "share" in navigator;
    // Absent outside secure contexts and in some in-app browsers.
    const canCopy = "clipboard" in navigator;

    page.classList.add("dl-hold-installers");
    mobileHint.hidden = false;
    if (canShare || canCopy) {
      versionEl.textContent = `${about} ${openIt}, or send yourself the link.`;
      if (!canShare) share.textContent = "Copy the download link";
      share.hidden = false;
    } else {
      versionEl.textContent = `${about} ${openIt}.`;
    }

    share.addEventListener("click", async () => {
      if (canShare) {
        try {
          await navigator.share({ title: "Download Threadlines", url });
          return;
        } catch (error) {
          // Closing the share sheet is a choice, not a failure.
          if (error instanceof DOMException && error.name === "AbortError") return;
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        share.textContent = "Link copied";
      } catch {
        // Neither works here, so don't leave a button that does nothing.
        share.hidden = true;
        versionEl.textContent = `${about} ${openIt}.`;
      }
    });
    document.getElementById("dl-show-installers")!.addEventListener("click", () => {
      page.classList.remove("dl-hold-installers");
      mobileHint.hidden = true;
    });
  }

  try {
    const [release, macArch] = await Promise.all([
      fetchLatestRelease(),
      device === "mac" ? detectMacArch(navigator) : undefined,
    ]);
    const installers = classifyAssets(release.assets);

    if (!isMobile) versionEl.textContent = `Latest release: ${release.tag_name}`;

    const rows = list.querySelectorAll<HTMLElement>(".dl-row");
    let anyRow = false;
    for (const row of rows) {
      const asset = installers[row.dataset.slot as keyof typeof installers];
      if (!asset) {
        row.hidden = true;
        continue;
      }
      anyRow = true;
      row.querySelector(".dl-row-size")!.textContent = formatAssetSize(asset.size);
      row.querySelector("a")!.href = asset.browser_download_url;
    }
    list.hidden = !anyRow;

    // A Mac whose browser won't name its chip gets the common one, labelled, with a hint.
    const chipUnknown = device === "mac" && macArch === undefined;
    const primaryAsset =
      pickInstaller(installers, device, macArch) ??
      (chipUnknown ? (installers.macArm ?? installers.macX64) : undefined);
    if (primaryAsset) {
      primary.href = primaryAsset.browser_download_url;
      document.getElementById("dl-ico-mac")!.hidden = device !== "mac";
      document.getElementById("dl-ico-win")!.hidden = device !== "windows";
      document.getElementById("dl-ico-linux")!.hidden = device !== "linux";
      primaryLabel.textContent =
        device === "windows"
          ? "Download for Windows"
          : device === "linux"
            ? "Download for Linux"
            : primaryAsset === installers.macArm
              ? "Download for macOS (Apple Silicon)"
              : "Download for macOS (Intel)";
      primarySize.textContent = formatAssetSize(primaryAsset.size);
      primary.hidden = false;
      macHint.hidden = !chipUnknown;
    }

    if (!anyRow) throw new Error("No installers in release");
  } catch {
    if (!isMobile) versionEl.textContent = "Free and open source · macOS, Windows, and Linux";
    primary.hidden = true;
    macHint.hidden = true;
    list.hidden = true;
    fallback.hidden = false;
  }
</script>

<style>
  /* The script shows each part only once it has a link; until then it stays hidden. */
  .dl-inner [hidden] {
    display: none;
  }

  .dl-sub {
    margin-top: 18px;
  }

  .dl-primary-wrap {
    margin-top: 30px;
  }

  .dl-primary[hidden] {
    display: none;
  }

  /* "Download for macOS (Apple Silicon)" and its size wrap in a narrow window, never clip. */
  .dl-primary {
    max-width: 100%;
    height: auto;
    min-height: 52px;
    padding-block: 12px;
    justify-content: flex-start;
    white-space: normal;
    text-align: left;
  }

  #dl-primary-label {
    min-width: 0;
  }

  button.dl-primary {
    border: 0;
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 600;
    cursor: pointer;
  }

  .dl-primary-size {
    flex: none;
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0.7;
  }

  .dl-ico {
    display: inline-flex;
    flex: none;
    align-self: center;
  }

  .dl-ico[hidden] {
    display: none;
  }

  .dl-ico svg {
    width: 17px;
    height: 17px;
    margin-top: 0;
  }

  .dl-hint {
    max-width: 52ch;
    margin-top: 14px;
    color: var(--fg-muted);
    font-size: var(--k-s);
    text-wrap: pretty;
  }

  /* Phones and tablets: installers stay out of the way until asked for. */
  .dl-hold-installers .dl-list,
  .dl-hold-installers #dl-fallback {
    display: none;
  }

  /* Every installer, ruled like the kit's lists. */
  .dl-list {
    max-width: 560px;
    margin-top: 40px;
    border-bottom: 1px solid var(--border);
    font-size: var(--k-s);
  }

  .dl-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 18px;
    align-items: center;
    padding: 13px 0;
    border-top: 1px solid var(--border);
  }

  .dl-row-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
  }

  .dl-row-ico {
    display: inline-flex;
    flex: none;
    color: var(--fg-muted);
  }

  .dl-row-ico svg {
    width: 15px;
    height: 15px;
  }

  .dl-row-size {
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }

  /* Narrow screens: the name on its own line, its size and link under it. */
  @media (width <= 420px) {
    .dl-row {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 4px 16px;
    }

    .dl-row-name {
      grid-column: 1 / -1;
    }

    .dl-row .dl-link {
      justify-self: end;
    }
  }

  /* GitHub didn't answer: one plain block with a way through. */
  .dl-panel {
    max-width: 560px;
    margin-top: 30px;
  }

  .dl-panel-title {
    font-weight: 600;
  }

  .dl-panel-text {
    max-width: 52ch;
    margin: 6px 0 24px;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .dl-panel-rows {
    display: grid;
    gap: 6px;
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: var(--k-s);
    color: var(--fg-muted);
  }

  .dl-panel-rows i {
    margin-right: 6px;
    font-style: normal;
  }

  .dl-note,
  .dl-noscript {
    margin-top: 32px;
  }

  .dl-link {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--underline);
    text-underline-offset: 3px;
    transition: color 160ms var(--ease);
  }

  .dl-link:hover {
    color: var(--accent);
  }

  button.dl-link {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .dl-onboarding .k-lede {
    margin-bottom: clamp(28px, 3vw, 36px);
  }
</style>
