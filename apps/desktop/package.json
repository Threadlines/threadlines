{
  "name": "@threadlines/desktop",
  "version": "0.0.1",
  "private": true,
  "author": "Threadlines",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "vp pack && node scripts/preview-vendor.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:bundle": "vp pack --watch",
    "dev:electron": "node scripts/dev-electron.mjs",
    "dev:server-bundle": "vp run --filter @threadlines/server dev:bundle",
    "smoke-test": "node scripts/smoke-test.mjs",
    "start": "node scripts/start-electron.mjs",
    "test": "vp exec vp test run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "vendor:playwright": "node ../../scripts/extract-playwright-injected.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@threadlines/contracts": "workspace:*",
    "@threadlines/shared": "workspace:*",
    "@threadlines/ssh": "workspace:*",
    "@threadlines/tailscale": "workspace:*",
    "effect": "catalog:",
    "electron": "43.8.3",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "productName": "Threadlines"
}
